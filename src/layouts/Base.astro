---
import "../styles/global.css";
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main class={wide ? "wide" : undefined}>
      <slot />
    </main>
  </body>
</html>
