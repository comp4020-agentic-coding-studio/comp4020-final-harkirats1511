---
import "@fontsource/bungee";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/caveat/600.css";
import "../styles/global.css";
interface Props { title: string; width?: "narrow" | "table" | "prose" | "home" }
const { title, width = "narrow" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1B1420" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class={`site-head head-${width}`}>
      <a class="brand" href="/" aria-label="Mole Records, home">M<span class="disc-o" aria-hidden="true"></span>LE</a>
    </header>
    <main class={`page page-${width}`}>
      <slot />
    </main>
  </body>
</html>
