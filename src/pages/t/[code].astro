---
import Base from "../../layouts/Base.astro";
import { personFromCookies } from "../../lib/auth.ts";
import { SLOT_HINTS, SLOT_NAMES } from "../../lib/prompts.ts";
import { MIN_PLAYERS, normaliseCode, publicState } from "../../lib/tables.ts";
import { PER_SLOT, TASTE_MAX as MIN_CRATE } from "../../lib/taste.ts";

const code = normaliseCode(Astro.params.code);
const state = publicState(code);
if (!state) return new Response("No such table.", { status: 404 });
const me = personFromCookies(Astro.cookies);
if (!me) return Astro.redirect(`/?next=/t/${code}`);
// Slot names and moods only (never a prompt): the client needs them to label a crate and a mole's card.
const slotInfo = JSON.stringify(Object.keys(SLOT_NAMES).map((s) => ({ slot: s, name: SLOT_NAMES[s as keyof typeof SLOT_NAMES], hint: SLOT_HINTS[s as keyof typeof SLOT_HINTS] })));
---
<Base title={`Table ${code}`} width="table">
  <div id="app" data-code={code} data-me={me.name} data-min={MIN_PLAYERS} data-crate={MIN_CRATE} data-per={PER_SLOT} data-slots={slotInfo}>
    <p class="sr-only" id="announce" role="status" aria-live="polite"></p>
    <p class="conn" id="conn" role="status" aria-live="polite" hidden></p>

    <div class="bar">
      <button id="leave" type="button" class="secondary sm">Leave table</button>
      <a id="to-shop" class="btn ghost sm" href="/shop" aria-label="Back to the shop floor. You keep your seat here.">Shop floor</a>
      <span class="hint" id="leave-note"></span>
      <span class="where mono">Booth {code}</span>
    </div>
    <div id="leave-confirm" class="card" role="alertdialog" aria-labelledby="leave-q" hidden>
      <p id="leave-q"><strong>Leave the game?</strong> You will be out of it for good.</p>
      <div class="row btns">
        <button id="leave-yes" type="button">Yes, leave</button>
        <button id="leave-no" type="button" class="secondary">Stay</button>
      </div>
    </div>

    <section id="removed" class="card removed" aria-labelledby="removed-h" role="alert" hidden>
      <h2 id="removed-h">The host removed you from this table</h2>
      <p>You can't sit here again, but the shop is still open.</p>
      <div class="row">
        <a class="btn" href="/shop">Back to the shop</a>
        <a class="btn ghost" href="/">Home</a>
      </div>
    </section>

    <div class="table-grid" id="table-grid">
      <div class="game-col">
        <h1 id="title">Table</h1>
        <div id="lobby-code" class="ticket-wrap">
          <div class="code-line">
            <p class="hint" id="code-label">Share this code with the room</p>
            <span class="vis-tag mono" id="vis-tag" data-private={String(state.private)}>{state.private ? "Private" : "Open to anyone"}</span>
          </div>
          <div class="ticket" aria-labelledby="code-label" id="table-code">{code}</div>
          <button id="copy-code" type="button" class="secondary sm">Copy code</button>
          <p class="hint" id="copy-msg" role="status"></p>
        </div>
        <div class="setup" id="setup-guest" hidden>
          <p class="fmt-guest" id="format-guest"></p>
          <p class="mole-line-lobby hint" id="moles-guest"></p>
        </div>
        <div class="setup" id="setup-lobby" hidden>
          <div class="fmt-ctl" id="format-lobby"></div>
          <div class="mole-ctl" id="moles-lobby"></div>
          <div class="bot-ctl">
            <button id="add-bot" type="button" class="secondary">Add a bot</button>
            <p class="hint" id="bot-note">Bots fill empty seats. They play by the same rules and are always labelled BOT.</p>
          </div>
          <p class="hint" id="bot-msg" role="status"></p>
        </div>
        <p class="status" id="status" hidden>
          <span class="status-label" id="status-label"></span>
          <span class="countdown" id="countdown" role="timer" aria-live="off"></span>
        </p>

        <!-- Four rounds: everyone's score as of the last reveal. It never moves during a vote. -->
        <section class="strip" id="scores" aria-labelledby="scores-h" hidden>
          <p class="strip-k mono" id="scores-h"></p>
          <ol class="strip-list" id="scores-list"></ol>
        </section>

        <p class="watch-line" id="watch-line" hidden></p>
        <p class="watch-line late" id="late" hidden>The next game starts after this one. <a id="late-link" href={`/taste?next=/t/${code}`} hidden>Fill your crate now</a></p>

        <div id="v-lobby">
          <fieldset class="who-sits" id="vis-host" hidden>
            <legend>Who can sit down?</legend>
            <div class="check">
              <input type="radio" name="vis" id="vis-public" value="public" />
              <label for="vis-public">Anyone in the shop</label>
            </div>
            <div class="check">
              <input type="radio" name="vis" id="vis-private" value="private" />
              <label for="vis-private">Only people with the code</label>
            </div>
            <p class="hint" id="vis-msg" role="status"></p>
          </fieldset>
          <p class="hint">Everyone brings a crate of {MIN_CRATE} songs: {PER_SLOT} each for Up, Down, Out and In. Once the game starts the crates sit on the table for all to see.</p>
          <p class="hint"><a href="/me">Change your character</a></p>
          <p class="waiting" id="waiting" role="status" hidden></p>
          <a class="btn full holdup" id="crate-me" href={`/taste?next=/t/${code}`} hidden>Finish your crate</a>
          <button id="start" type="button" class="full" disabled hidden>Start game</button>
          <p class="hint abandoned" id="abandoned" role="status" hidden></p>
          <p class="hint" id="start-note" aria-live="polite"></p>
          <p id="msg" class="error" role="alert"></p>
        </div>

        <!-- Your card: the prompt for most of you; for the mole only its mood. Hide flips it face down. -->
        <section class="role phase" id="card" aria-labelledby="role-h" hidden>
          <div class="role-head">
            <h2 id="role-h" tabindex="-1">Your card</h2>
            <button id="role-toggle" type="button" class="secondary sm" aria-controls="role-body" aria-expanded="true"><span id="role-toggle-text">Hide</span></button>
          </div>
          <div class="theme-card" id="theme-card">
            <span class="tape" aria-hidden="true"></span>
            <div class="flip">
              <div class="face front" id="role-body">
                <p class="talker-k" id="role-k">Staff pick</p>
                <p class="theme" id="role-text"></p>
                <p class="slot-tag mono" id="role-slot"></p>
                <p class="mole-line" id="role-sub" hidden></p>
              </div>
              <div class="face back" id="role-back" aria-hidden="true">
                <p class="back-note" id="role-hidden">Your card is hidden. Show it when nobody is looking.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="card phase" id="pick" aria-labelledby="pick-h" hidden>
          <h2 id="pick-h" tabindex="-1">Pick a song</h2>
          <p class="instr" id="pick-instr"></p>
          <p class="hint" id="pick-wait" hidden></p>
          <div id="pick-done" hidden>
            <p><span class="stamp">Picked</span></p>
            <p><strong>Picked.</strong> Waiting for the others.</p>
          </div>
          <div id="pick-ui" hidden>
            <div id="pick-fit"></div>
            <div id="borrow-wrap">
              <button id="borrow-toggle" type="button" class="secondary" aria-expanded="false" aria-controls="borrow-panel">Borrow instead</button>
              <p class="hint" id="borrow-note"></p>
              <div id="borrow-panel" hidden></div>
            </div>
            <div id="pick-rest"></div>
          </div>
          <p id="pick-msg" class="error" role="alert"></p>
        </section>

        <section class="card phase" id="vote" aria-labelledby="vote-h" hidden>
          <h2 id="vote-h" tabindex="-1">Vote someone out</h2>
          <p class="instr" id="vote-instr">Who is the mole? Vote for a player, or skip. You can change your vote until it locks.</p>
          <p class="hint" id="vote-note"></p>
          <div class="vtabs" id="vote-tabs" role="tablist" aria-label="The two votes" hidden></div>
          <div id="vote-mole-panel" role="tabpanel" aria-labelledby="tab-mole">
            <ul class="ballot" id="vote-list" aria-label="Players to vote for"></ul>
            <div class="skipbar" id="vote-skip-wrap"></div>
          </div>
          <div id="vote-best-panel" role="tabpanel" aria-labelledby="tab-best" hidden>
            <ul class="ballot best" id="best-list" aria-label="Songs to pick as best"></ul>
          </div>
          <p class="lastcall mono" id="last-call" role="status" hidden></p>
          <p id="vote-msg" class="error" role="alert"></p>
        </section>

        <section class="card phase" id="listen" aria-labelledby="listen-h" hidden>
          <h2 id="listen-h" tabindex="-1">Listen</h2>
          <p class="instr" id="listen-instr">Every song, with its picker. Whose song fits the card, and whose sounds like a bluff?</p>
          <div id="audio-choice" class="choice" hidden>
            <label><input type="checkbox" id="own-audio" /> Play the tracks on this phone</label>
            <p class="hint" id="audio-choice-note"></p>
          </div>
          <div class="stage-wrap" aria-hidden="true">
            <div class="stage" id="stage">
              <div class="sleeve" id="stage-sleeve"><span class="sl-k">{code}</span><span class="sl-t" id="stage-side">&#9835;</span></div>
              <div class="plinth"></div>
              <div class="platter"></div>
              <div class="record"><div class="disc"><div class="labelc"><div><i id="stage-who">{code}</i><b id="stage-label">A1</b><i id="stage-title">33&#8531; RPM</i></div></div></div></div>
              <div class="arm"><div class="rod"></div><div class="head"></div></div>
            </div>
          </div>
          <p id="np" class="np" aria-live="polite"></p>
          <div id="auto" class="auto" hidden>
            <p class="auto-line"><span class="stamp">Auto</span> Playing every track in turn</p>
            <div class="auto-bar" id="auto-bar" role="img"></div>
          </div>
          <button id="unlock" type="button" class="full" hidden>Tap to let this phone play</button>
          <ol class="plays" id="cards" aria-label="The songs this round"></ol>
          <p class="deadair" id="dead-air" hidden></p>
          <p class="hint" id="audio-msg" role="status"></p>
          <audio id="audio" preload="none"></audio>
          <button id="to-vote" type="button" class="full" hidden>Go to voting</button>
        </section>

        <section class="card phase steal" id="steal" aria-labelledby="steal-h" hidden>
          <p class="steal-stamp" aria-hidden="true"><span class="stamp-big moles">Mole</span></p>
          <h2 id="steal-h" tabindex="-1">Steal!</h2>
          <p class="instr" id="steal-line"></p>
          <p class="steal-clock mono" id="steal-clock" aria-hidden="true"></p>
          <div id="steal-options" class="steal-options" hidden></div>
          <p class="hint" id="steal-wait" hidden></p>
          <p id="steal-msg" class="error" role="alert"></p>
        </section>

        <section class="card liner phase" id="reveal" aria-labelledby="reveal-h" hidden>
          <p class="liner-top mono" aria-hidden="true"><span>{code}</span><span id="reveal-side">Back cover</span></p>
          <h2 id="reveal-h" tabindex="-1">Reveal</h2>
          <p id="winner" class="stamp-big" hidden></p>
          <div id="moles-end" class="moles-end" hidden></div>
          <div id="reveal-prompt-wrap" hidden>
            <p class="kicker" id="reveal-slot"></p>
            <p class="theme reveal-prompt" id="reveal-prompt"></p>
          </div>
          <div id="scoreboard" class="scoreboard" hidden>
            <h3>Final scores</h3>
            <ol class="board" id="board-list"></ol>
          </div>
          <div id="ghost-results" class="ghost-results" hidden>
            <h3>The ghosts' guesses</h3>
            <ul class="ghosts" id="ghost-list"></ul>
          </div>
          <p id="eject" class="eject"></p>
          <div id="four-points" class="four-points" hidden>
            <h3>Points this round</h3>
            <ul class="pts" id="pts-list"></ul>
          </div>
          <ol class="plays reveal" id="reveal-cards" aria-label="Who picked what"></ol>
          <p class="deadair" id="reveal-dead" hidden></p>
          <div id="reveal-votes-wrap" class="votes-note" hidden>
            <h3 id="reveal-votes-h">Votes</h3>
            <ul class="votelist" id="reveal-votes"></ul>
          </div>
          <div id="reveal-best-wrap" class="votes-note" hidden>
            <h3>Best pick votes</h3>
            <ul class="votelist" id="reveal-best"></ul>
          </div>
          <div id="past-end" hidden>
            <div class="pressing">
              <h3>The whole game</h3>
              <ol class="past" id="past-list"></ol>
            </div>
          </div>
          <p class="mono next-in" id="next-in" hidden></p>
          <div class="rematch" id="rematch" hidden>
            <p class="in-count mono" id="in-count" role="status"></p>
            <button id="im-in" type="button" class="full secondary" aria-pressed="false">I'm in</button>
            <p><a id="swap" href={`/taste?next=/t/${code}`}>Swap a song before the next game</a></p>
            <div class="setup" id="setup-over" hidden>
              <div class="fmt-ctl" id="format-over"></div>
              <div class="mole-ctl" id="moles-over"></div>
              <button id="add-bot2" type="button" class="secondary sm">Add a bot</button>
              <p class="hint" id="bot-msg2" role="status"></p>
            </div>
          </div>
          <button id="next" type="button" class="full" hidden>Next round</button>
          <button id="again" type="button" class="full" hidden>Play again</button>
          <p class="hint" id="reveal-wait" hidden></p>
          <p id="see-games" hidden><a href="/history">See all your games</a></p>
          <p id="reveal-msg" class="error" role="alert"></p>
        </section>

        <!-- 3D scene: decoration only, loaded after the page is usable and only where WebGL 2
             works and motion is welcome. Everything in it is also in the 2D page below. -->
        <section id="scene-slot" aria-label="3D table view" hidden>
          <div class="scene-stage" id="scene-stage"><div class="scene-skel" id="scene-skel" aria-hidden="true"></div></div>
          <p class="sr-only" id="scene-desc"></p>
          <button id="scene-toggle" type="button" class="secondary sm scene-toggle" aria-pressed="true">3D scene: on</button>
        </section>

        <!-- The crates on the table: the evidence the room reasons from. -->
        <section class="card crates" id="crates" aria-labelledby="crates-h" hidden>
          <h2 id="crates-h">The crates</h2>
          <p class="hint">Everyone's songs, in the open. A heard song is struck out and marked played.</p>
          <div id="crates-list"></div>
        </section>
      </div>

      <aside class="side-col" aria-label="Players and rules">
        <section class="card" aria-labelledby="players-h">
          <h2 id="players-h">Players (<span id="count">{state.members.length}</span>)</h2>
          <ul class="members" id="members">
            {state.members.map((m) => (
              <li>
                <span class="avatar" aria-hidden="true"><span class="av-disc"></span></span>
                <span class="name">{m.name}</span>
                <span class="stamps">
                  {m.name === state.host && <span class="stamp host">Host</span>}
                  <span class="stamp crate">{m.crateReady ? "Crate ready" : "Crate: not ready"}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>

        <div id="remove-confirm" class="card" role="alertdialog" aria-labelledby="remove-q" hidden>
          <p id="remove-q"></p>
          <div class="row btns">
            <button id="remove-yes" type="button">Yes, remove</button>
            <button id="remove-no" type="button" class="secondary">Keep them</button>
          </div>
        </div>
        <p id="remove-msg" class="error" role="alert"></p>

        <details class="card report" id="report" aria-labelledby="report-h">
          <summary id="report-h">Report this table</summary>
          <form id="report-form">
            <label for="report-reason">What is the problem?</label>
            <select id="report-reason" name="reason">
              <option value="rude names">Rude names</option>
              <option value="spam">Spam</option>
              <option value="trolling the game">Trolling the game</option>
              <option value="something else">Something else</option>
            </select>
            <button type="submit" class="secondary">Send report</button>
          </form>
          <p class="hint" id="report-msg" role="status"></p>
        </details>

        <details class="card howto" id="howto" hidden>
          <summary>How to play</summary>
          <h3>Every round</h3>
          <ul>
            <li>Your crate is 12 songs, 3 for each mood (Up, Down, Out, In), built on the Taste page before you sit down.</li>
            <li>Everyone but the mole gets a prompt, like "a song for a long drive".</li>
            <li>The mole knows they are the mole. They only get the prompt's mood. With 6 or more players there are two moles, and they don't know each other.</li>
            <li>Pick a song from your crate that fits. Each song can be heard once a game.</li>
            <li>Once a game, anyone, the mole too, can borrow a song from someone else's crate.</li>
            <li>Every pick plays with its picker's name. Then you vote, with live counts and a short last call once everyone has voted.</li>
            <li>A mole who is caught gets a steal: 15 seconds to guess the prompt from 8.</li>
          </ul>
          <h3>Knockout</h3>
          <ul>
            <li>Vote someone out each round (not yourself). A tie, or skip on top, votes out nobody.</li>
            <li>A right steal wins the game for the moles. Players who are voted out watch, make a private guess at the mole each round, and their crates can still be borrowed from.</li>
            <li>Players win when every mole is out. Moles win when they are as many as everyone left in, if nobody is voted out with three left, or if they survive round 12.</li>
          </ul>
          <h3>Four rounds</h3>
          <ul>
            <li>Four rounds, one per mood. Nobody is voted out. The moles are dealt again every round.</li>
            <li>Two votes at once: who is the mole, and the best pick (a song, not your own). Change either until it locks.</li>
            <li>Points: +2 for voting for a mole. +1 for each best-pick vote your song gets, and +1 to whoever lent it. A mole gets +2 if the room's top vote isn't a mole, and +3 for a right steal.</li>
            <li>Scores change only at the reveal. After round 4 the most points wins; a tie shares it.</li>
          </ul>
          <p class="hint">The reveal moves on by itself after 30 seconds. Playing an obvious song for the prompt helps a caught mole guess it.</p>
        </details>
      </aside>
    </div>
  </div>
</Base>
<script>
  import { avatar } from "../../ui/avatar.ts";
  import type { Avatar } from "../../lib/avatar.ts";
  type Slot = "up" | "down" | "out" | "in";
  type CrateTrack = { trackId: number; title: string; artist: string; cover?: string; slot: Slot | null };
  type Card = { order: number; picker: string; lender?: string; trackId: number; title: string; artist: string; cover?: string; clash?: true };
  type Points = { name: string; points: number };
  type Past = { round: number; prompt: string; slot: Slot; cards: Card[]; ejected: string | null; wasMole: boolean; moles?: string[]; points?: Points[] };
  type Reveal = {
    prompt: string; slot: Slot; cards: Card[]; deadAir: string[]; votes: { voter: string; choice: string | null }[];
    accused: string | null; ejected: string | null; wasMole: boolean; stole: boolean;
    moles?: string[]; points?: Points[]; bestVotes?: { voter: string; order: number; picker: string; lender?: string }[];
  };
  type Game = {
    format?: "knockout" | "four";
    scores?: { name: string; score: number }[];
    bestTally?: { order: number; votes: number }[];
    winners?: string[];
    ghostGuesses?: { ghost: string; guesses: { round: number; guess: string; hit: boolean }[]; hits: number }[];
    round: number;
    autoplay?: boolean;
    phase: "pick" | "listen" | "vote" | "steal" | "reveal";
    deadline: number | null;
    nowPlaying: number | null;
    alive: string[];
    ghosts: string[];
    cards?: Card[];
    deadAir?: string[];
    tally?: { name: string; votes: number }[];
    skips?: number;
    lastCall?: boolean;
    accused?: string;
    reveal?: Reveal;
    past: Past[];
    borrowed: string[];
    played: number[];
    winner?: "players" | "moles" | "none" | "points";
    ending?: "final-vote" | "round-cap" | "nobody-picked";
    moles?: string[];
  };
  type Member = { name: string; avatar: Avatar; crateReady: boolean; crateCount: number; bot?: true; in?: true; crate?: CrateTrack[] };
  type State = { same?: string[]; status: string; private: boolean; host: string; moleChoice: number | null; format?: "knockout" | "four"; members: Member[]; game?: Game };
  type Me = {
    role: "player" | "mole" | "ghost" | "spectator"; prompt?: string; slot?: Slot; picked?: boolean; borrowUsed?: boolean; played?: number[];
    vote?: { name: string } | { skip: true }; best?: { order: number }; guess?: { name: string }; steal?: { options: { id: string; text: string }[] };
  };

  import type { TableScene } from "../../scene/table-scene.ts";
  import { createSfx } from "../../audio/sfx.ts";
  const app = document.getElementById("app")!;
  const code = app.dataset.code!;
  const myName = app.dataset.me!;
  const minPlayers = Number(app.dataset.min);
  const minCrate = Number(app.dataset.crate);
  // Slot names and moods only; the page never holds a prompt a mole must not see.
  const slotInfo = JSON.parse(app.dataset.slots!) as { slot: Slot; name: string; hint: string }[];
  const slotName = (s: Slot | null | undefined) => slotInfo.find((x) => x.slot === s)?.name ?? "";
  const slotLabel = (s: Slot | null | undefined) => {
    const x = slotInfo.find((i) => i.slot === s);
    return x ? `${x.name}: ${x.hint}` : "";
  };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on: boolean) => { $(id).hidden = !on; };

  // DOM built from parts, never from markup strings: names and titles are data.
  function h(tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]): HTMLElement {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    el.append(...kids);
    return el;
  }
  function button(label: string, onClick: () => void, opts: { secondary?: boolean; aria?: string; disabled?: boolean; key?: string } = {}) {
    const b = h("button", { type: "button" }, label) as HTMLButtonElement;
    if (opts.key) b.dataset.fk = opts.key;
    if (opts.secondary) b.className = "secondary";
    if (opts.aria) b.setAttribute("aria-label", opts.aria);
    b.disabled = !!opts.disabled;
    b.addEventListener("click", onClick);
    return b;
  }
  type Track = { title: string; artist: string; cover?: string };
  function art(t: Track, size = 56) {
    const img = t.cover
      ? Object.assign(document.createElement("img"), { src: t.cover, alt: "", width: size, height: size, loading: "lazy" })
      : h("div", { class: "nocover" });
    return h("div", { class: "sleeve-art" }, img);
  }
  // A record sleeve row: cover art with a record peeking out, title and artist,
  // then whatever the caller puts after.
  function trackRow(t: Track, ...extra: (Node | string)[]) {
    return h("li", {}, art(t), h("div", { class: "meta" }, h("strong", {}, t.title), h("span", {}, t.artist)), ...extra);
  }
  async function api<T = Record<string, unknown>>(url: string, body?: unknown) {
    const res = await fetch(url, body === undefined ? {} : { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    return { res, data: (await res.json().catch(() => ({}))) as T & { error?: string } };
  }
  // Drop a rebuild when nothing it draws has changed, so focus survives updates.
  const sigs = new Map<string, string>();
  // A rebuild that does run puts focus back on the same control: anything that can
  // hold focus in a redrawn list carries a stable data-fk (a name or a track id).
  function once(key: string, sig: string, draw: () => void) {
    if (sigs.get(key) === sig) return;
    sigs.set(key, sig);
    const fk = (document.activeElement as HTMLElement | null)?.dataset?.fk;
    draw();
    if (fk) document.querySelector<HTMLElement>(`[data-fk="${CSS.escape(fk)}"]`)?.focus({ preventScroll: true });
  }

  // Where this person hears tracks. Per person, per browser; a convenience, so
  // every access is guarded and the default ("host") works without it.
  const AUDIO_KEY = "mole:audio";
  const readAudioChoice = (): "host" | "mine" => {
    try { return localStorage.getItem(AUDIO_KEY) === "mine" ? "mine" : "host"; } catch { return "host"; }
  };
  const writeAudioChoice = (c: "host" | "mine") => { try { localStorage.setItem(AUDIO_KEY, c); } catch { /* not saved */ } };
  let audioChoice: "host" | "mine" = readAudioChoice();

  let state: State | null = null;
  let me: Me | null = null;
  let myCrate: number | null = null;
  let roleShown = true;
  let howtoPlaying: boolean | null = null;
  let lastKey = "";
  let announcedLow = "";
  let clockSkew = 0;
  const phaseWords = { pick: "Pick a song", listen: "Listen", vote: "Vote", steal: "Steal", reveal: "Reveal" };
  let dropKey = "";
  let borrowOpen = false;
  let stealGuessed = false;
  const FOUR_ROUNDS = 4;
  let voteTab: "mole" | "best" = "mole";
  // Best cards seen at a reveal this session (the public state only holds the current round's votes).
  const bestSeen = new Map<number, number[]>();

  const announce = (t: string) => { $("announce").textContent = t; };
  const isHost = () => state?.host === myName;
  // Phones that make sound: the host's always, anyone's who chose their own phone.
  const speakerHere = () => !!state && (isHost() || audioChoice === "mine");
  const secondsLeft = (g: Game | undefined) => (g?.deadline == null ? 0 : Math.max(0, Math.ceil((g.deadline - (Date.now() + clockSkew)) / 1000)));
  // Someone who picks and votes this round (a mole too; a ghost or spectator doesn't).
  const active = () => me?.role === "player" || me?.role === "mole";

  // ---- rendering ----

  function render() {
    if (!state) return;
    const g = state.game;
    const playing = state.status === "playing" && !!g;
    // An abandoned game (winner "none") leaves the table in the lobby, not on a game-over screen.
    const over = !!g?.winner && g.winner !== "none";
    const inGame = playing || over;
    const phase = g?.phase;

    const four = g?.format === "four";
    // "Round 2 of 4 · Down": the mood comes from /me (a mole has it too), never from a prompt.
    $("title").textContent = !inGame ? "Table" : over ? "Game over" : four ? `Round ${g!.round} of ${FOUR_ROUNDS}${me?.slot ? ` \u00b7 ${slotName(me.slot)}` : ""}` : `Round ${g!.round}`;
    show("lobby-code", !inGame || over);
    show("status", playing && !over);
    $("status-label").textContent = phase ? phaseWords[phase] : "";
    show("v-lobby", !inGame);
    show("to-shop", !inGame || over);
    // How to play: open until a game has been played here, then folded away.
    show("howto", true);
    // Open in the lobby, folded once when a game starts, and the person's own choice otherwise.
    if (howtoPlaying === null || playing !== howtoPlaying) {
      if (howtoPlaying === null || playing) ($("howto") as HTMLDetailsElement).open = !g;
      howtoPlaying = playing;
    }
    renderMembers();
    renderLobby();
    const gone = state.status !== "playing" && g?.winner === "none";
    show("abandoned", gone);
    $("abandoned").textContent = gone ? (g!.ending === "nobody-picked" ? "Game abandoned: nobody picked. Your crates are open again." : "That game was left unfinished and has ended with no winner.") : "";
    // Someone who sat down mid-game spectates: say when they play, and let them finish a short crate.
    const spectating = playing && me?.role === "spectator";
    show("late", spectating);
    if (spectating) show("late-link", !(state.members.find((m) => m.name === myName)?.crateReady ?? true));
    renderStrip(playing && four && phase !== "reveal");
    renderCard(playing && (phase === "pick" || phase === "listen" || phase === "vote"), phase);
    renderPick(playing && phase === "pick");
    renderListen(playing && (phase === "listen" || phase === "vote"));
    renderVote(playing && phase === "vote");
    renderSteal(playing && phase === "steal");
    renderReveal(inGame && (phase === "reveal" || over));
    renderCrates(playing);
    tick();
    syncActions();
    settleFocus();
  }

  // On a phase or round change focus moves to the new phase's heading, once it is
  // on screen. Not on every stream frame: only a change sets pendingFocus.
  let pendingFocus = "";
  function settleFocus() {
    if (!pendingFocus) return;
    const el = document.getElementById(pendingFocus);
    if (!el || el.closest("[hidden]")) return;
    pendingFocus = "";
    if (document.activeElement?.closest("#leave-confirm, #remove-confirm")) return;
    el.focus({ preventScroll: true });
    // The host taps "vote" at the foot of the replay; bring the new phase into view.
    const top = el.getBoundingClientRect().top;
    if (top < 0 || top > innerHeight - 120) el.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  }

  // A name's badge from the members list; someone who left gets a default.
  function face(name: string): HTMLElement {
    return avatar(name, state?.members.find((m) => m.name === name)?.avatar);
  }

  function renderMembers() {
    const s = state!;
    const g = s.game;
    const inGame = s.status === "playing" && !!g;
    once("members", JSON.stringify([s.members.map((m) => [m.name, m.avatar, m.crateReady, m.crateCount, m.bot, m.in]), s.host, s.status, inGame, g?.alive, g?.ghosts, isHost(), myCrate]), () => {
      $("members").replaceChildren(
        ...s.members.map(({ name, crateReady, crateCount, bot, in: ready }) => {
          const stamps = h("span", { class: "stamps" });
          const stamp = (t: string, kind: string) => stamps.append(h("span", { class: `stamp ${kind}` }, t));
          if (bot) stamp("BOT", "bot");
          if (name === s.host) stamp("Host", "host");
          const own = name === myName && myCrate !== null;
          if (!inGame) stamp(crateReady ? "Crate ready" : `Crate: ${own ? myCrate : crateCount}/${minCrate}`, crateReady ? "crate ready" : "crate");
          if (s.game?.winner && s.game.winner !== "none" && ready) stamp("In", "in");
          if (inGame && g!.ghosts.includes(name)) stamp("Out", "out");
          else if (inGame && !g!.alive.includes(name)) stamp("Watching", "watching");
          const li = h("li", {}, face(name), h("span", { class: "name" }, name), stamps);
          if (isHost() && bot && s.status !== "playing") {
            // A bot goes at once: no one to confirm with, and the host can add another.
            const rm = button("\u00d7", () => void removeBot(name), { secondary: true, aria: `Remove bot ${name}` });
            rm.classList.add("sm", "rm", "rm-bot");
            li.append(rm);
          } else if (isHost() && name !== myName) {
            const rm = button("Remove", () => askRemove(name, rm), { secondary: true, aria: `Remove ${name} from the table` });
            rm.classList.add("sm", "rm");
            li.append(rm);
          }
          return li;
        }),
      );
      $("count").textContent = String(s.members.length);
    });
  }

  function renderLobby() {
    const s = state!;
    const tag = $("vis-tag");
    tag.textContent = s.private ? "Private" : "Open to anyone";
    tag.dataset.private = String(s.private);
    tag.classList.toggle("private", s.private);
    show("vis-host", isHost());
    $<HTMLInputElement>("vis-public").checked = !s.private;
    $<HTMLInputElement>("vis-private").checked = s.private;
    const n = s.members.length;
    const start = $<HTMLButtonElement>("start");
    show("start", isHost());
    start.textContent = s.game && s.game.winner !== "none" ? "Play again" : "Start game";
    delete start.dataset.conn;
    const notReady = s.members.filter((m) => !m.crateReady);
    start.disabled = n < minPlayers || notReady.length > 0;
    const mine = s.members.find((m) => m.name === myName);
    const mineReady = mine?.crateReady ?? true;
    // Who the table is waiting on, by name and crate count: both public at the table, nothing private.
    const lobby = s.status !== "playing" && !(s.game && s.game.winner && s.game.winner !== "none");
    show("waiting", lobby && notReady.length > 0);
    $("waiting").textContent = notReady.length
      ? `Waiting on: ${notReady.map((m) => `${m.name} (crate ${m.name === myName && myCrate !== null ? myCrate : m.crateCount}/${minCrate})`).join(", ")}`
      : "";
    // Whoever is holding it up gets a way to finish.
    show("crate-me", !mineReady);
    if (!mineReady) $("crate-me").textContent = `Finish your crate (${myCrate ?? mine?.crateCount ?? 0}/${minCrate})`;
    $("start-note").textContent = isHost()
      ? notReady.length
        ? ""
        : n < minPlayers
        ? `Needs at least ${minPlayers} players to start (${minPlayers - n} more). 4 or more is best.`
        : n < 4
          ? "You can start now. 4 or more players is recommended."
          : "Everyone in? Start when ready."
      : "Waiting for the host to start.";
    renderSetup(s);
  }

  // The host's table setup: the format, add a bot, and how many moles. Shown while no game is running.
  const FORMATS = [
    { key: "knockout", name: "Knockout", note: "Vote someone out each round. Out players still guess." },
    { key: "four", name: "Four rounds", note: "One round per mood. Nobody is out. Score points." },
  ] as const;
  const formatOf = (s: State) => (s.format === "four" ? "four" : "knockout");
  const molesFor = (s: State) => {
    const n = s.members.length;
    const cap = Math.max(1, Math.floor(n / 3));
    const shown = Math.min(s.moleChoice ?? (n <= 5 ? 1 : 2), cap);
    return { n, cap, shown };
  };
  function drawFormat(el: HTMLElement, s: State) {
    const now = formatOf(s);
    el.replaceChildren(
      h("span", { class: "k", id: `${el.id}-k` }, "Format"),
      h("div", { class: "fmt-row", role: "radiogroup", "aria-labelledby": `${el.id}-k` },
        ...FORMATS.map((f) => {
          const b = h("button", { type: "button", class: "fmt-opt" + (f.key === now ? " on" : ""), role: "radio", "aria-checked": String(f.key === now), "data-fk": `format:${el.id}:${f.key}` },
            h("b", {}, f.name), h("span", {}, f.note)) as HTMLButtonElement;
          b.addEventListener("click", () => void chooseFormat(f.key));
          return b;
        })),
    );
  }
  function drawMoles(el: HTMLElement, s: State) {
    const { cap, shown } = molesFor(s);
    el.replaceChildren(
      h("span", { class: "k", id: `${el.id}-k` }, "Moles"),
      h("span", { class: "seg", role: "radiogroup", "aria-labelledby": `${el.id}-k` },
        ...[1, 2].map((v) => {
          const b = button(String(v), () => void chooseMoles(v), { secondary: v !== shown, disabled: v > cap, key: `moles${v}` });
          b.setAttribute("role", "radio");
          b.setAttribute("aria-checked", String(v === shown));
          b.setAttribute("aria-label", `${v} mole${v === 1 ? "" : "s"}`);
          return b;
        })),
      h("span", { class: "hint" }, cap < 2 ? "2 moles need 6 players (never more than a third of the table)." : "Never more than a third of the table."),
    );
  }
  function renderSetup(s: State) {
    const lobby = s.status !== "playing" && !(s.game && s.game.winner && s.game.winner !== "none");
    const over = !!s.game?.winner && s.game.winner !== "none" && s.status === "finished";
    const host = isHost();
    show("setup-lobby", host && lobby);
    show("setup-over", host && over);
    show("setup-guest", !host && lobby);
    if (!host && lobby) {
      const { shown } = molesFor(s);
      const f = FORMATS.find((x) => x.key === formatOf(s))!;
      $("format-guest").replaceChildren(h("span", { class: "k" }, "Format"), h("b", {}, f.name), h("span", { class: "hint" }, f.note));
      $("moles-guest").textContent = `Moles: ${shown}`;
    }
    const full = s.members.length >= 8;
    for (const id of ["add-bot", "add-bot2"]) {
      const b = $<HTMLButtonElement>(id);
      b.disabled = full;
      b.dataset.full = full ? "1" : "";
    }
    $("bot-note").textContent = full ? "The table is full: 8 seats." : "Bots fill empty seats. They play by the same rules and are always labelled BOT.";
    once("moles-ui", JSON.stringify([s.moleChoice, s.format, s.members.length, host && (lobby || over)]), () => {
      if (host && lobby) { drawFormat($("format-lobby"), s); drawMoles($("moles-lobby"), s); }
      if (host && over) { drawFormat($("format-over"), s); drawMoles($("moles-over"), s); }
    });
  }
  async function chooseFormat(f: "knockout" | "four") {
    const { res, data } = await api(`/api/tables/${code}/format`, { format: f });
    for (const id of ["bot-msg", "bot-msg2"]) $(id).textContent = res.ok ? "" : (data.error ?? "Could not change the format.");
    if (res.ok) onState(data as unknown as State);
  }
  async function chooseMoles(v: number) {
    const { res, data } = await api(`/api/tables/${code}/moles`, { moles: v });
    for (const id of ["bot-msg", "bot-msg2"]) $(id).textContent = res.ok ? "" : (data.error ?? "Could not change the moles.");
    if (res.ok) onState(data as unknown as State);
  }
  async function addBot() {
    const { res, data } = await api(`/api/tables/${code}/bots`, {});
    for (const id of ["bot-msg", "bot-msg2"]) $(id).textContent = res.ok ? "" : (data.error ?? "Could not add a bot.");
    if (res.ok) onState(data as unknown as State);
  }
  async function removeBot(name: string) {
    const { res, data } = await api(`/api/tables/${code}/bots/remove`, { name });
    for (const id of ["bot-msg", "bot-msg2"]) $(id).textContent = res.ok ? "" : (data.error ?? "Could not remove that bot.");
    if (res.ok) { announce(`${name} was removed.`); onState(data as unknown as State); }
  }
  $("add-bot").addEventListener("click", () => void addBot());
  $("add-bot2").addEventListener("click", () => void addBot());

  // Four rounds: a compact score strip. Scores are as of the last reveal, and the label says so.
  function renderStrip(on: boolean) {
    show("scores", on);
    if (!on) return;
    const g = state!.game!;
    const done = g.past.length;
    $("scores-h").textContent = done ? `Scores after round ${done}` : "Scores: nobody has scored yet";
    once("strip", JSON.stringify([g.scores, done]), () => {
      const rows = [...(g.scores ?? [])].sort((a, b) => b.score - a.score || a.name.localeCompare(b.name));
      $("scores-list").replaceChildren(
        ...rows.map((r) => h("li", { class: r.name === myName ? "me" : "" }, h("span", { class: "nm" }, r.name === myName ? `${r.name} (you)` : r.name), h("b", { class: "mono" }, String(r.score)))),
      );
    });
  }

  // Your card. A mole's comes from /me and holds the slot only: there is no other
  // source of a prompt in this page. Face down, a mole's card and a player's are the
  // same: same heading, same tape, same back. Only the face differs.
  function renderCard(on: boolean, phase?: Game["phase"]) {
    const watching = !!me && !active();
    // Someone out, or watching, has no card: just a plain line saying so.
    show("watch-line", on && watching);
    if (watching) $("watch-line").textContent = me!.role === "ghost" ? "You're out. You watch and listen." : "You're watching this game.";
    show("card", on && !!me && !watching);
    if (!on || !me || watching) return;
    const mole = me.role === "mole";
    const open = roleShown;
    const card = $("card");
    // While picking the card sits above the pick list, as it is needed to choose; later it is one line below the action.
    const before = phase === "pick" ? $("pick") : $("scene-slot");
    if (card.nextElementSibling !== before) before.before(card);
    card.classList.toggle("compact", phase !== "pick");
    card.classList.toggle("is-open", open);
    $("theme-card").classList.toggle("flipped", !open);
    $("theme-card").classList.toggle("is-mole", mole);
    $("role-body").setAttribute("aria-hidden", String(!open));
    $("role-back").setAttribute("aria-hidden", String(open));
    $("role-toggle-text").textContent = open ? "Hide" : "Show";
    $("role-toggle").setAttribute("aria-expanded", String(open));
    const four = state?.game?.format === "four";
    $("role-h").textContent = mole && open ? (four ? "You're the mole this round" : "You're the mole") : four ? "Your card this round" : "Your card";
    const text = $("role-text");
    text.classList.toggle("quiet", mole);
    $("role-k").textContent = mole ? "Mole" : "Staff pick";
    show("role-sub", mole);
    if (mole) {
      text.textContent = `You're the mole${four ? " this round" : ""}. You don't know the prompt, only its mood:`;
      $("role-sub").textContent = `${slotName(me.slot).toUpperCase()} (${slotInfo.find((i) => i.slot === me!.slot)?.hint ?? ""}). Blend in.`;
      $("role-slot").textContent = "";
    } else {
      text.textContent = me.prompt ?? "";
      $("role-slot").textContent = slotLabel(me.slot);
    }
  }

  // ---- the crates on the table ----

  const crateOpen = new Map<string, boolean>();
  const wide = () => matchMedia("(min-width: 1024px)").matches;
  function songLi(t: CrateTrack, played: boolean, ...extra: (Node | string)[]) {
    const li = h("li", { class: "csong" + (played ? " is-played" : "") },
      art(t, 36),
      h("span", { class: "meta" }, h("strong", {}, t.title), h("span", {}, t.artist)),
      ...(played ? [h("span", { class: "played-tag mono" }, "played")] : []),
      ...extra);
    return li;
  }
  function renderCrates(on: boolean) {
    show("crates", on);
    if (!on) return;
    const s = state!;
    const g = s.game!;
    const played = new Set(g.played);
    const sig = JSON.stringify([s.members.map((m) => [m.name, m.crate?.map((c) => c.trackId)]), g.played, g.borrowed, g.ghosts]);
    once("crates", sig, () => {
      $("crates-list").replaceChildren(
        ...s.members.filter((m) => m.crate).map((m) => {
          const crate = m.crate!;
          const left = crate.filter((c) => !played.has(c.trackId)).length;
          const open = crateOpen.get(m.name) ?? (m.name === myName || wide());
          const summary = h("summary", { "data-fk": `crate:${m.name}` },
            face(m.name), h("span", { class: "cname" }, m.name === myName ? `${m.name} (you)` : m.name),
            ...(g.ghosts.includes(m.name) ? [h("span", { class: "stamp out" }, "Out")] : []),
            ...(g.borrowed.includes(m.name) ? [h("span", { class: "stamp borrowed" }, "Borrowed")] : []),
            h("span", { class: "cleft mono" }, `${left} left`));
          const slots = slotInfo.map((si) => {
            const mine = crate.filter((c) => c.slot === si.slot);
            return h("div", { class: "cslot" },
              h("h4", {}, h("span", {}, si.name), h("span", { class: "chint" }, si.hint)),
              h("ul", {}, ...mine.map((c) => songLi(c, played.has(c.trackId)))));
          });
          const d = h("details", { class: "cplayer" }, summary, ...slots) as HTMLDetailsElement;
          d.open = open;
          d.addEventListener("toggle", () => crateOpen.set(m.name, d.open));
          return d;
        }),
      );
    });
  }

  // ---- pick ----

  function renderPick(on: boolean) {
    show("pick", on && !!me);
    if (!on || !me) return;
    const g = state!.game!;
    const watching = !active();
    const locked = me.picked === true;
    show("pick-wait", watching);
    $("pick-h").textContent = !watching ? "Pick a song" : me.role === "ghost" ? "You're out" : "You're watching";
    $("pick-wait").textContent = me.role === "ghost" ? "You're out. The room is picking." : "You're watching. The room is picking.";
    show("pick-done", !watching && locked);
    show("pick-ui", !watching && !locked);
    // The same words for a mole and a player: a mole's screen must not read differently.
    $("pick-instr").textContent = watching ? "" : "Pick a song from your crate that answers your card. Your pick is final once you tap it.";
    $("pick-instr").hidden = watching;
    if (watching || locked) return;
    const mine = state!.members.find((m) => m.name === myName)?.crate ?? [];
    const played = new Set([...g.played, ...(me.played ?? [])]);
    const slot = me.slot;
    const used = !!me.borrowUsed;
    once("pick", JSON.stringify([mine.map((c) => c.trackId), [...played], slot, used, borrowOpen, state!.members.map((m) => [m.name, m.crate?.map((c) => c.trackId)])]), () => {
      const row = (t: CrateTrack, fits: boolean, from?: string) => {
        const done = played.has(t.trackId);
        const act = h("div", { class: "acts" }, button(from ? "Borrow" : "Pick", () => pick(t.trackId, t, from), {
          disabled: done, aria: `${from ? `Borrow from ${from}` : "Pick"}: ${t.title} by ${t.artist}`, key: `pick:${from ?? ""}:${t.trackId}`,
        }));
        const li = songLi(t, done, h("span", { class: "slot-tag mono" }, slotName(t.slot)), act);
        li.classList.add("prow");
        if (fits && !done) li.classList.add("fits");
        return li;
      };
      const fit = mine.filter((c) => c.slot === slot);
      const rest = mine.filter((c) => c.slot !== slot);
      // Public data only: the crate on the table and what has been heard.
      const spent = mine.every((c) => played.has(c.trackId));
      const lenders = state!.members.filter((m) => m.name !== myName && m.crate?.some((c) => !played.has(c.trackId)));
      const canBorrow = !used && lenders.length > 0;
      // Nothing to pick from your own crate: drop the "pick from your crate" line too.
      $("pick-instr").hidden = spent;
      if (spent) {
        $("pick-rest").replaceChildren();
        $("pick-fit").replaceChildren(
          h("p", { class: "empty-crate" },
            `Your crate is empty: every song has been heard. ${used ? "You've used your borrow; sit this one out." : canBorrow ? "You can still borrow once." : "There is nothing left to borrow either; sit this one out."}`),
        );
      } else {
        $("pick-fit").replaceChildren(
          h("h3", {}, `Fits the mood: ${slotLabel(slot)}`),
          h("ul", { class: "tracks pickable", "aria-label": "Songs that fit the mood" }, ...fit.map((c) => row(c, true))),
        );
        const restD = h("details", { class: "restcrate" },
          h("summary", { "data-fk": "rest-crate" }, "The rest of your crate", h("span", { class: "cleft mono" }, `${rest.length} songs`)),
          h("ul", { class: "tracks pickable", "aria-label": "The rest of your crate" }, ...rest.map((c) => row(c, false)))) as HTMLDetailsElement;
        restD.open = restOpen;
        restD.addEventListener("toggle", () => { restOpen = restD.open; });
        $("pick-rest").replaceChildren(restD);
      }
      show("borrow-wrap", !used || !spent);
      const bt = $<HTMLButtonElement>("borrow-toggle");
      bt.hidden = used || !canBorrow;
      bt.textContent = borrowOpen ? "Close borrowing" : "Borrow instead";
      bt.setAttribute("aria-expanded", String(borrowOpen));
      $("borrow-note").textContent = used ? "You have used your borrow this game." : !canBorrow ? "Nobody has a song left to borrow." : "Everyone gets one borrow a game, the mole too. The table will see whose crate it came from.";
      show("borrow-panel", borrowOpen && canBorrow);
      if (borrowOpen && canBorrow) {
        const others = state!.members.filter((m) => m.name !== myName && m.crate);
        $("borrow-panel").replaceChildren(
          ...others.map((m) => {
            const open = (borrowOpened.get(m.name) ?? false);
            const list = [...m.crate!.filter((c) => !played.has(c.trackId))].sort((a, b) => Number(b.slot === slot) - Number(a.slot === slot));
            const d = h("details", { class: "cplayer" },
              h("summary", { "data-fk": `borrow:${m.name}` }, face(m.name), h("span", { class: "cname" }, m.name), h("span", { class: "cleft mono" }, `${list.length} to borrow`)),
              h("ul", { class: "tracks pickable" }, ...list.map((c) => row(c, c.slot === slot, m.name)))) as HTMLDetailsElement;
            d.open = open;
            d.addEventListener("toggle", () => borrowOpened.set(m.name, d.open));
            return d;
          }),
        );
      }
    });
  }
  const borrowOpened = new Map<string, boolean>();
  let restOpen = false;

  // ---- listen ----

  function cardLine(c: Card) {
    return h("span", { class: "who" }, face(c.picker), h("strong", {}, c.picker),
      ...(c.lender ? [h("span", { class: "lent" }, `(borrowed from ${c.lender})`)] : []),
      ...(c.clash ? [h("span", { class: "stamp clash" }, "Clash")] : []));
  }

  function renderListen(on: boolean) {
    show("listen", on);
    if (!on) return;
    const g = state!.game!;
    const host = isHost();
    const np = g.nowPlaying;
    const cards = g.cards ?? [];
    const playing = np === null ? null : cards.find((c) => c.order === np) ?? null;
    $("listen-h").textContent = g.phase === "vote" ? "Listen again" : "Listen";
    const what = playing ? `${playing.picker}: ${playing.title}` : "";
    $("np").textContent =
      np === null
        ? host
          ? "Tap a card to play it."
          : `Waiting for ${state!.host} to play a track.`
        : speakerHere() && !host
          ? `${what} is playing on this phone.`
          : host
            ? `${what} is playing. Tap another card to play it.`
            : `${what} is playing on ${state!.host}'s phone.`;
    once("cards", JSON.stringify([cards, host]), () => {
      $("cards").replaceChildren(
        ...cards.map((c) => {
          const play = host ? button("Play", () => playByHost(c.order), { aria: `Play card ${c.order + 1}: ${c.title} by ${c.picker}` }) : null;
          const li = h("li", { class: "pcard", "data-order": String(c.order) },
            h("span", { class: "n mono", "aria-hidden": "true" }, String(c.order + 1)),
            art(c, 56),
            h("div", { class: "meta" }, h("strong", {}, c.title), h("span", {}, c.artist)),
            cardLine(c),
            h("span", { class: "playing-stamp", "aria-hidden": "true" }, "Playing"),
            ...(play ? [play] : []));
          return li;
        }),
      );
    });
    // Needle drop: the label carries the playing card's number, picker and title.
    dropNeedle(playing, `${g.round}:${np}`);
    for (const li of $("cards").children) {
      const active = Number((li as HTMLElement).dataset.order) === np;
      li.classList.toggle("playing", active);
      if (active) li.setAttribute("aria-current", "true");
      else li.removeAttribute("aria-current");
    }
    show("dead-air", !!g.deadAir?.length);
    $("dead-air").textContent = g.deadAir?.length ? `Dead air (no pick): ${g.deadAir.join(", ")}` : "";
    const auto = g.autoplay === true && g.phase === "listen" && cards.length > 0;
    show("auto", auto);
    if (auto) {
      const at = np === null ? 0 : np + 1;
      $("auto-bar").setAttribute("aria-label", `Track ${at} of ${cards.length}`);
      once("auto-bar", `${cards.length}|${at}`, () => {
        $("auto-bar").replaceChildren(
          ...cards.map((_, i) => h("span", { class: i + 1 < at ? "done" : i + 1 === at ? "on" : "" })),
          h("span", { class: "auto-n" }, `${at} of ${cards.length}`),
        );
      });
    }
    show("to-vote", host && g.phase === "listen");
    show("unlock", speakerHere() && !host && !audioUnlocked);
    show("audio-choice", true);
    const own = $<HTMLInputElement>("own-audio");
    own.checked = audioChoice === "mine" || host;
    own.disabled = host;
    $("audio-choice-note").textContent = host
      ? "Your phone always plays the tracks."
      : audioChoice === "mine"
        ? "This phone plays each track as it is picked."
        : `Listening to ${state!.host}'s phone.`;
  }

  // The needle's thud and crackle, synthesised (decision 0006). Off when the
  // shop's Sound switch is off; silent until the first tap, as browsers require.
  const sfx = createSfx();
  try { sfx.setEnabled(localStorage.getItem("mole:radio") !== "off"); } catch { /* no storage: on */ }
  const unlockSfx = () => { sfx.unlock(); removeEventListener("pointerdown", unlockSfx, true); removeEventListener("keydown", unlockSfx, true); };
  addEventListener("pointerdown", unlockSfx, true);
  addEventListener("keydown", unlockSfx, true);

  // The needle drop. Picks are public by now, so the label shows the playing
  // card's number, picker and title. A card that starts playing replays the drop;
  // arriving to one already playing finds the record on the platter. CSS skips
  // the motion under reduced motion and leaves the record resting.
  function dropNeedle(c: Card | null, key: string) {
    const stage = $("stage");
    $("stage-label").textContent = c ? String(c.order + 1) : "";
    $("stage-who").textContent = c ? c.picker : code;
    $("stage-title").textContent = c ? c.title : "33⅓ RPM";
    $("stage-side").textContent = c ? c.picker : "♫";
    $("stage-sleeve").dataset.title = c ? c.title : "";
    if (!c) {
      stage.classList.remove("on", "go");
      dropKey = "";
      return;
    }
    if (key === dropKey) return;
    dropKey = key;
    stage.classList.remove("go");
    stage.classList.add("on");
    void stage.offsetWidth;
    stage.classList.add("go");
    // In time with the needle touching down in the CSS drop (instantly when still).
    setTimeout(() => sfx.needle(), matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 2400);
  }

  // ---- vote: on players (and, in Four rounds, a best pick on the cards) ----

  function renderVote(on: boolean) {
    show("vote", on && !!me);
    if (!on || !me) return;
    const g = state!.game!;
    const four = g.format === "four";
    const voter = active();
    const ghost = me.role === "ghost";
    // A Knockout ghost can't vote; it makes a private guess at who the mole is, with the same rows.
    $("vote-h").textContent = four ? "Cast your votes" : ghost ? "Your guess" : "Vote someone out";
    $("vote-instr").textContent = four
      ? "Two votes: who is the mole (or skip), and the best pick, a song that isn't yours. Change either until it locks."
      : ghost ? "Who do you think it is? (only you see this)" : "Who is the mole? Vote for a player, or skip. You can change your vote until it locks.";
    $("vote-note").textContent = voter
      ? four ? "Cast both to lock in sooner." : g.alive.length === 3 ? "Three left: if nobody is voted out, the moles win." : ""
      : ghost ? "You're out, so you can't vote. Your guess stays private until the game is over." : "You're watching this game, so you can't vote.";
    const mine = me.vote;
    const myName_ = "name" in (mine ?? {}) ? (mine as { name: string }).name : null;
    const skipMine = !!mine && "skip" in mine;
    const myGuess = me.guess?.name ?? null;
    const myBest = me.best?.order ?? null;
    const tally = g.tally ?? [];
    const cards = g.cards ?? [];
    // Two tabs in Four rounds: both ballots stay a tap apart, each marked done once cast.
    show("vote-tabs", four);
    show("vote-mole-panel", !four || voteTab === "mole");
    show("vote-best-panel", four && voteTab === "best");
    if (four) {
      const moleDone = !!mine, bestDone = myBest !== null;
      once("vtabs", JSON.stringify([voteTab, voter, moleDone, bestDone]), () => {
        const tab = (key: "mole" | "best", label: string, done: boolean) => {
          const on = voteTab === key;
          const b = h("button", { type: "button", role: "tab", id: `tab-${key}`, class: "vtab" + (on ? " on" : ""), "aria-selected": String(on), "aria-controls": `vote-${key}-panel`, "data-fk": `tab:${key}` },
            h("span", {}, label), ...(voter ? [h("span", { class: "vt-state mono" + (done ? " done" : "") }, done ? "cast" : "to cast")] : [])) as HTMLButtonElement;
          b.addEventListener("click", () => { voteTab = key; sigs.delete("vtabs"); render(); });
          return b;
        };
        $("vote-tabs").replaceChildren(tab("mole", "Who's the mole?", moleDone), tab("best", "Best pick", bestDone));
      });
    }
    once("votes", JSON.stringify([tally, g.skips, mine, myGuess, voter, ghost, cards, g.alive]), () => {
      const rows = tally.filter((t) => !(voter && t.name === myName));
      $("vote-list").replaceChildren(
        ...rows.map((t) => {
          const card = cards.find((c) => c.picker === t.name);
          const chosen = ghost ? myGuess === t.name : myName_ === t.name;
          const body = [
            face(t.name),
            h("span", { class: "bname" },
              h("strong", {}, t.name),
              h("span", { class: "bcard" }, card ? `${card.title}, ${card.artist}${card.lender ? ` (from ${card.lender})` : ""}` : "Dead air: no song")),
            h("span", { class: "count mono", "aria-hidden": "true" }, String(t.votes)),
          ];
          if (!voter && !ghost) return h("li", {}, h("div", { class: "brow ro", role: "group", "aria-label": `${t.name}: ${t.votes} vote${t.votes === 1 ? "" : "s"}` }, ...body));
          const b = h("button", {
            type: "button", class: "brow" + (chosen ? " mine" : ""), "aria-pressed": String(chosen), "data-fk": `vote:${t.name}`,
            "aria-label": ghost
              ? `Guess ${t.name}. Their song: ${card ? `${card.title} by ${card.artist}` : "none, dead air"}.${chosen ? " Your guess" : ""}`
              : `Vote ${t.name}. Their song: ${card ? `${card.title} by ${card.artist}` : "none, dead air"}. ${t.votes} vote${t.votes === 1 ? "" : "s"} so far${chosen ? ". Your vote" : ""}`,
          }, ...body) as HTMLButtonElement;
          if (chosen) b.append(h("span", { class: "your", "aria-hidden": "true" }, ghost ? "your guess" : "your vote"));
          b.addEventListener("click", () => (ghost ? guess(t.name) : vote({ name: t.name })));
          return h("li", {}, b);
        }),
      );
      const sk = g.skips ?? 0;
      const skipBody = [h("span", {}, skipMine ? "Skip (your vote)" : "Skip: nobody"), h("span", { class: "count mono", "aria-hidden": "true" }, String(sk))];
      $("vote-skip-wrap").replaceChildren(
        ghost ? "" :
        voter
          ? (() => {
              const b = h("button", { type: "button", "data-fk": "vote:skip", class: "skipbtn secondary" + (skipMine ? " mine" : ""), "aria-pressed": String(skipMine), "aria-label": `Skip: vote for nobody. ${sk} so far${skipMine ? ", your vote" : ""}` }, ...skipBody) as HTMLButtonElement;
              b.addEventListener("click", () => vote("skip"));
              return b;
            })()
          : h("div", { class: "skipbtn ro" }, ...skipBody),
      );
    });
    if (four) {
      const counts = new Map((g.bestTally ?? []).map((t) => [t.order, t.votes]));
      once("best", JSON.stringify([g.bestTally, myBest, voter, cards, myName]), () => {
        $("best-list").replaceChildren(
          ...cards.map((c) => {
            const n = counts.get(c.order) ?? 0;
            const own = c.picker === myName;
            const lent = c.lender === myName;
            const chosen = myBest === c.order;
            const tag = own ? "your card" : lent ? "you lent it" : "";
            const body = [
              h("span", { class: "n mono", "aria-hidden": "true" }, String(c.order + 1)),
              h("span", { class: "bname" },
                h("strong", {}, c.title),
                h("span", { class: "bcard" }, `${c.artist} \u00b7 ${c.picker}${c.lender ? ` (from ${c.lender})` : ""}`)),
              h("span", { class: "count mono", "aria-hidden": "true" }, String(n)),
            ];
            const label = `Card ${c.order + 1}: ${c.title} by ${c.artist}, picked by ${c.picker}${c.lender ? `, borrowed from ${c.lender}` : ""}. ${n} vote${n === 1 ? "" : "s"} so far`;
            if (!voter || tag) {
              return h("li", {}, h("div", { class: "brow ro" + (tag ? " off" : ""), role: "group", "aria-label": `${label}${tag ? `. ${tag}: you can't pick it` : ""}` }, ...body,
                ...(tag ? [h("span", { class: "your off", "aria-hidden": "true" }, tag)] : [])));
            }
            const b = h("button", { type: "button", class: "brow" + (chosen ? " mine" : ""), "aria-pressed": String(chosen), "data-fk": `best:${c.order}`, "aria-label": `${label}${chosen ? ". Your best pick" : ""}` }, ...body) as HTMLButtonElement;
            if (chosen) b.append(h("span", { class: "your", "aria-hidden": "true" }, "your pick"));
            b.addEventListener("click", () => best(c.order));
            return h("li", {}, b);
          }),
        );
      });
    }
    tickLastCall();
  }

  // "Last call: locks in 5 s", from the shortened deadline.
  let lastCallSaid = "";
  function tickLastCall() {
    const g = state?.game;
    const el = $("last-call");
    const on = !!g && g.phase === "vote" && g.lastCall === true && g.deadline !== null;
    el.hidden = !on;
    if (!on) return;
    const left = secondsLeft(g);
    const text = `Last call: locks in ${left} s`;
    if (el.textContent !== text) el.textContent = text;
    const key = `${g!.round}`;
    if (lastCallSaid !== key) { lastCallSaid = key; announce("Last call. The vote locks in 5 seconds."); }
  }

  // ---- steal ----

  function renderSteal(on: boolean) {
    show("steal", on);
    if (!on) {
      // The steal is over: no decoy prompts stay in the page.
      if (sigs.has("steal")) { sigs.delete("steal"); $("steal-options").replaceChildren(); }
      return;
    }
    const g = state!.game!;
    const accused = g.accused ?? "";
    const mineToGuess = !!me?.steal;
    $("steal").classList.toggle("guessing", mineToGuess);
    $("steal-line").textContent = accused === myName
      ? `You were voted out, and you were the mole. 15 s to guess the prompt from 8 and steal the game.`
      : `${accused} was the mole. They have 15 s to guess the prompt from 8 and steal the game.`;
    const box = $("steal-options");
    show("steal-options", mineToGuess);
    show("steal-wait", !mineToGuess);
    $("steal-wait").textContent = `Waiting on ${accused}. Nothing for you to do but hold your breath.`;
    once("steal", JSON.stringify([me?.steal?.options ?? null, stealGuessed, stealChoice]), () => {
      box.replaceChildren(
        ...(me?.steal?.options ?? []).map((o) => {
          const mine = stealChoice === o.id;
          const b = h("button", { type: "button", class: "steal-opt" + (mine ? " chosen" : ""), "data-fk": `steal:${o.id}`, "aria-pressed": String(mine) }, o.text,
            ...(mine ? [h("span", { class: "your" }, "your guess")] : [])) as HTMLButtonElement;
          b.disabled = stealGuessed;
          b.addEventListener("click", () => steal(o.id));
          return b;
        }),
      );
    });
  }

  let stealChoice: string | null = null;
  let stealing = false;
  async function steal(id: string) {
    if (stealing || !state?.game) return;
    stealing = true;
    $("steal-msg").textContent = "";
    const { res, data } = await api(`/api/tables/${code}/steal`, { promptId: id });
    stealing = false;
    if (res.ok || res.status === 409) {
      stealGuessed = true;
      if (res.ok) stealChoice = id;
      announce("Guess is in.");
      if (!res.ok) $("steal-msg").textContent = "Too late: the steal is over.";
      return render();
    }
    $("steal-msg").textContent = data.error ?? "Could not send that guess.";
  }

  // ---- reveal and game over ----

  function revealCard(c: Card, i: number) {
    const li = h("li", { class: "pcard", style: `--i:${i}` },
      h("span", { class: "n mono", "aria-hidden": "true" }, String(c.order + 1)),
      art(c, 56),
      h("div", { class: "meta" }, h("strong", {}, c.title), h("span", {}, c.artist)),
      cardLine(c));
    return li;
  }

  // A past round's best card: the one with most best-pick votes, from what this page saw at its reveal.
  function bestLine(p: Past): HTMLElement[] {
    const order = bestSeen.get(p.round);
    if (!order?.length) return [];
    const cs = order.map((o) => p.cards.find((c) => c.order === o)).filter((c): c is Card => !!c);
    return cs.length ? [h("span", { class: "t" }, `Best pick: ${cs.map((c) => `${c.title} (${c.picker})`).join(", ")}`)] : [];
  }

  function renderReveal(on: boolean) {
    show("reveal", on);
    if (!on) return;
    const g = state!.game!;
    const r = g.reveal;
    const host = isHost();
    const four = g.format === "four";
    $("reveal-h").textContent = g.winner ? "Game over" : four ? `Round ${g.round} of ${FOUR_ROUNDS}: the reveal` : `Round ${g.round}: the reveal`;
    const win = $("winner");
    win.hidden = !g.winner;
    const joint = (g.winners?.length ?? 0) > 1;
    win.textContent = g.winner === "players" ? "Players win" : g.winner === "moles" ? "Moles win" : g.winner === "points" ? (joint ? "Joint winners" : "Winner") : "";
    win.classList.toggle("moles", g.winner === "moles");
    const moles = g.moles ?? [];
    // Four rounds deals new moles each round: at game over they are named per round below, not as one list.
    show("moles-end", !!g.winner && !four);
    once("moles", JSON.stringify([moles, g.winner, four]), () => {
      $("moles-end").replaceChildren(
        h("p", { class: "kicker" }, moles.length === 1 ? "The mole was" : "The moles were"),
        h("ul", { class: "mole-names" }, ...moles.map((n) => h("li", {}, face(n), h("strong", {}, n), h("span", { class: "stamp mole" }, "Mole")))),
      );
    });
    // Four rounds game over: the winners and the final scores.
    show("scoreboard", four && !!g.winner);
    if (four && g.winner) {
      once("board", JSON.stringify([g.scores, g.winners]), () => {
        const rows = [...(g.scores ?? [])].sort((a, b) => b.score - a.score || a.name.localeCompare(b.name));
        $("board-list").replaceChildren(
          ...rows.map((r) => h("li", { class: g.winners?.includes(r.name) ? "top" : "" }, face(r.name), h("strong", {}, r.name === myName ? `${r.name} (you)` : r.name),
            ...(g.winners?.includes(r.name) ? [h("span", { class: "stamp win" }, "Winner")] : []), h("b", { class: "mono" }, String(r.score)))),
        );
      });
    }
    // Knockout game over: what each ghost guessed, and how many hit.
    const gg = g.ghostGuesses ?? [];
    show("ghost-results", !four && !!g.winner && gg.length > 0);
    once("ghosts", JSON.stringify(gg), () => {
      $("ghost-list").replaceChildren(
        ...gg.map((x) => h("li", {},
          face(x.ghost),
          h("div", {}, h("strong", {}, `${x.ghost} guessed right ${x.hits} of ${x.guesses.length}`),
            h("span", { class: "gl" }, x.guesses.map((q) => `Round ${q.round}: ${q.guess} (${q.hit ? "a mole" : "not a mole"})`).join(" \u00b7 "))))),
      );
    });
    show("reveal-prompt-wrap", !!r);
    if (r) {
      $("reveal-slot").textContent = `The prompt, ${slotLabel(r.slot)}`;
      $("reveal-prompt").textContent = r.prompt;
    }
    const eject = $("eject");
    if (!r) eject.textContent = "";
    else if (four) {
      const ms = r.moles ?? [];
      const parts = [`${ms.length === 1 ? "The mole this round was" : "The moles this round were"} ${ms.join(" and ") || "nobody"}.`];
      if (r.wasMole) parts.push(r.stole ? `The room caught ${r.accused ?? "a mole"} and they stole the prompt.` : `The room caught ${r.accused ?? "a mole"}. They missed the steal.`);
      else parts.push(r.accused ? `The room blamed ${r.accused}, who was not a mole. The moles got away.` : "The room did not agree on anyone. The moles got away.");
      eject.textContent = parts.join(" ");
      if (r.wasMole) eject.append(h("span", { class: "stamp win" }, "Caught"));
      else eject.append(h("span", { class: "stamp moles" }, "Got away"));
    } else {
      const parts: string[] = [];
      if (r.stole && r.accused) parts.push(`${r.accused} was a mole and stole it. The moles win.`);
      else if (r.ejected) {
        parts.push(`${r.ejected} was voted out. ${r.wasMole ? "They were a mole." : "They were not a mole."}`);
        if (r.wasMole) parts.push("They missed the steal.");
      } else parts.push("Nobody was voted out.");
      if (g.ending === "final-vote") parts[parts.length - 1] = "Nobody was voted out with three left: the moles win.";
      else if (g.ending === "round-cap") parts.push("Round 12 is over and the moles are still in: the moles win.");
      eject.textContent = parts.join(" ");
      // The stamp repeats what the sentence says: colour is never the only signal.
      if (r.wasMole || r.stole) eject.append(h("span", { class: "stamp mole" }, "Mole"));
    }
    once("reveal", JSON.stringify([r ?? null, state!.members.map((m) => m.name)]), () => {
      $("reveal-cards").replaceChildren(...(r?.cards ?? []).map(revealCard));
      show("reveal-dead", !!r?.deadAir.length);
      $("reveal-dead").textContent = r?.deadAir.length ? `Dead air (no pick): ${r.deadAir.join(", ")}` : "";
      $("reveal-votes-h").textContent = four ? "Who's the mole? votes" : "Votes";
      show("reveal-votes-wrap", !!r?.votes.length);
      $("reveal-votes").replaceChildren(
        ...(r?.votes ?? []).map((v) => h("li", {}, face(v.voter), h("strong", {}, v.voter), h("span", {}, v.choice === null ? "skipped" : `voted ${v.choice}`))),
      );
      const bv = r?.bestVotes ?? [];
      show("reveal-best-wrap", four && bv.length > 0);
      $("reveal-best").replaceChildren(
        ...bv.map((v) => h("li", {}, face(v.voter), h("strong", {}, v.voter), h("span", {}, `best: card ${v.order + 1}, ${v.picker}${v.lender ? ` (from ${v.lender})` : ""}`))),
      );
      // Points this round, with the reason for each. The reasons are worked out from what the
      // reveal shows (votes by name, best votes, the moles, the steal), so they add up to the engine's points.
      show("four-points", four && !!r?.points?.length);
      const ms = new Set(r?.moles ?? []);
      const rows = [...(r?.points ?? [])].sort((a, b) => b.points - a.points || a.name.localeCompare(b.name));
      $("pts-list").replaceChildren(
        ...rows.map((p) => {
          const why: string[] = [];
          const caught = (r?.votes ?? []).some((v) => v.voter === p.name && !ms.has(p.name) && v.choice !== null && ms.has(v.choice));
          if (caught) why.push("+2 caught the mole");
          const got = (r?.bestVotes ?? []).filter((b) => b.picker === p.name).length;
          if (got) why.push(`+${got} best pick${got === 1 ? "" : "s"}`);
          const lent = (r?.bestVotes ?? []).filter((b) => b.lender === p.name).length;
          if (lent) why.push(`+${lent} lent a best pick`);
          if (ms.has(p.name)) {
            const rest = p.points - (caught ? 2 : 0) - got - lent;
            if (rest >= 3 && r?.stole) why.push("+3 stole the prompt");
            else if (rest >= 2 && !r?.wasMole) why.push("+2 got away");
          }
          return h("li", {}, face(p.name), h("strong", {}, p.name === myName ? `${p.name} (you)` : p.name), h("span", { class: "why" }, why.join(", ") || "no points"), h("b", { class: "mono" }, `+${p.points}`));
        }),
      );
      // Remember this round's best card(s) for the game-over summary (past[] carries no best votes).
      if (four && r && g.phase === "reveal") {
        const tally = new Map<number, number>();
        for (const v of r.bestVotes ?? []) tally.set(v.order, (tally.get(v.order) ?? 0) + 1);
        const top = Math.max(0, ...tally.values());
        if (top > 0) bestSeen.set(g.round, [...tally].filter(([, n]) => n === top).map(([o]) => o));
      }
    });
    show("past-end", !!g.winner && g.past.length > 0);
    once("past", JSON.stringify([g.winner, g.past]), () => {
      $("past-list").replaceChildren(
        ...g.past.map((p) =>
          h("li", {},
            h("span", { class: "t" }, `Round ${p.round}, ${slotLabel(p.slot)}`),
            h("span", { class: "hand" }, p.prompt),
            h("ul", { class: "pcards" }, ...p.cards.map((c) => h("li", {}, h("strong", {}, c.picker), ` ${c.title}, ${c.artist}`, c.lender ? ` (from ${c.lender})` : "", c.clash ? " (clash)" : ""))),
            ...(four ? bestLine(p) : []),
            h("span", { class: "t out" }, four
              ? `${(p.moles ?? []).length === 1 ? "Mole" : "Moles"}: ${(p.moles ?? []).join(", ") || "none"} (${p.wasMole ? "caught" : "got away"})`
              : p.ejected ? `Out: ${p.ejected}${p.wasMole ? " (a mole)" : " (not a mole)"}` : "Nobody out")),
        ),
      );
    });
    show("next", host && !g.winner);
    show("again", host && !!g.winner);
    delete $("again").dataset.conn;
    $<HTMLButtonElement>("again").disabled = state!.members.length < minPlayers;
    // Rematch: "I'm in" is public and harmless; the host's button shows the count but isn't held by it.
    const finished = !!g.winner && g.winner !== "none";
    show("rematch", finished);
    if (finished) {
      const inN = state!.members.filter((m) => m.in).length;
      const mineIn = !!state!.members.find((m) => m.name === myName)?.in;
      $("in-count").textContent = `${inN} of ${state!.members.length} in`;
      const b = $<HTMLButtonElement>("im-in");
      b.textContent = mineIn ? "I'm in \u2713" : "I'm in";
      b.setAttribute("aria-pressed", String(mineIn));
      b.classList.toggle("secondary", !mineIn);
      $("again").textContent = host ? `Play again (${inN} of ${state!.members.length} in)` : "Play again";
    }
    show("see-games", !!g.winner);
    show("reveal-wait", !host);
    $("reveal-wait").textContent = g.winner ? "Waiting for the host to play again." : "Waiting for the host to start the next round.";
    tick();
  }

  // ---- countdown ----

  function tick() {
    const g = state?.game;
    const el = $("countdown");
    const next = $("next-in");
    next.hidden = !(g && g.phase === "reveal" && !g.winner && g.deadline !== null && state?.status === "playing");
    if (!next.hidden) next.textContent = `Next round in ${secondsLeft(g)} s`;
    if (g?.phase === "steal" && !g.winner) $("steal-clock").textContent = `${secondsLeft(g)}`;
    if (!state || !g || g.winner || g.deadline === null) {
      el.classList.remove("low");
      return void (el.textContent = "");
    }
    const left = secondsLeft(g);
    el.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}`;
    el.classList.toggle("low", left < 10);
    $("steal-clock").classList.toggle("low", left < 6);
    // Announce once per phase, not every second.
    const key = `${g.round}:${g.phase}`;
    if (left <= 10 && left > 0 && announcedLow !== key && (g.phase === "pick" || g.phase === "vote")) {
      announcedLow = key;
      announce("10 seconds left.");
    }
  }
  setInterval(() => { tick(); tickLastCall(); }, 500);

  // ---- loading what the stream doesn't carry ----

  let meSeq = 0;
  async function refreshMe() {
    const n = ++meSeq;
    const res = await fetch(`/api/tables/${code}/me`).catch(() => null);
    if (!res?.ok || n !== meSeq) return;
    me = (await res.json()) as Me;
    render();
  }

  // How many songs I have, for "Crate: 2/12". Others' counts are never sent.
  async function loadMyCrate() {
    const { res, data } = await api<unknown[]>("/api/taste");
    // Only songs sorted into a slot count toward the crate.
    const sorted = Array.isArray(data) ? (data as { slot: Slot | null }[]).filter((t) => t.slot !== null).length : 0;
    if (res.ok && Array.isArray(data) && sorted !== myCrate) {
      myCrate = sorted;
      if (state) render();
    }
  }
  window.addEventListener("pageshow", () => void loadMyCrate());
  void loadMyCrate();

  // ---- picking, voting, hosting ----

  let picking = false;
  async function pick(id: number, t: Track, from?: string) {
    if (picking || !state?.game) return;
    picking = true;
    const round = state.game.round;
    const msg = $("pick-msg");
    msg.textContent = "";
    const { res, data } = await api("/api/tables/" + code + "/pick", from ? { trackId: id, from } : { trackId: id });
    picking = false;
    // Already picked (say, on another tab) is the same lock as just picking.
    if (res.ok || (res.status === 409 && /already picked/i.test(data.error ?? ""))) {
      if (me && state.game.round === round) { me.picked = true; if (from) me.borrowUsed = true; }
      borrowOpen = false;
      announce("Picked. Waiting for the others.");
      render();
      // The pick buttons are gone: land on the confirmation, not the top of the page.
      const done = $("pick-done");
      done.tabIndex = -1;
      done.focus({ preventScroll: true });
      return;
    }
    msg.textContent = res.status === 409 && !/borrow|played|heard/i.test(data.error ?? "") ? "Too late: picking is over for this round." : (data.error ?? `Could not pick ${t.title}.`);
  }

  $("borrow-toggle").addEventListener("click", () => {
    borrowOpen = !borrowOpen;
    sigs.delete("pick");
    render();
  });

  let voting = false;
  async function vote(choice: { name: string } | "skip") {
    if (voting || !state?.game || !me) return;
    voting = true;
    const round = state.game.round;
    $("vote-msg").textContent = "";
    const { res, data } = await api("/api/tables/" + code + "/vote", choice === "skip" ? { skip: true } : choice);
    voting = false;
    if (res.ok) {
      if (me && state?.game?.round === round) me.vote = choice === "skip" ? { skip: true } : { name: choice.name };
      announce(choice === "skip" ? "Your vote: skip." : `Your vote: ${choice.name}. You can change it until it locks.`);
      return render();
    }
    $("vote-msg").textContent = res.status === 409 ? "Too late: voting is over." : (data.error ?? "Could not vote.");
  }

  let casting = false;
  async function best(order: number) {
    if (casting || !state?.game || !me) return;
    casting = true;
    const round = state.game.round;
    $("vote-msg").textContent = "";
    const { res, data } = await api("/api/tables/" + code + "/best", { order });
    casting = false;
    if (res.ok) {
      if (me && state?.game?.round === round) me.best = { order };
      announce(`Your best pick: card ${order + 1}. You can change it until it locks.`);
      return render();
    }
    $("vote-msg").textContent = res.status === 409 ? "Too late: voting is over." : (data.error ?? "Could not send that best pick.");
  }
  async function guess(name: string) {
    if (casting || !state?.game || !me) return;
    casting = true;
    const round = state.game.round;
    $("vote-msg").textContent = "";
    const { res, data } = await api("/api/tables/" + code + "/guess", { name });
    casting = false;
    if (res.ok) {
      if (me && state?.game?.round === round) me.guess = { name };
      announce(`Your guess: ${name}. Only you can see it.`);
      return render();
    }
    $("vote-msg").textContent = res.status === 409 ? "Too late: voting is over." : (data.error ?? "Could not send that guess.");
  }

  $("start").addEventListener("click", async () => {
    const { res, data } = await api(`/api/tables/${code}/start`, {});
    $("msg").textContent = res.ok ? "" : (data.error ?? "Could not start.");
  });
  $("im-in").addEventListener("click", async () => {
    const want = $("im-in").getAttribute("aria-pressed") !== "true";
    const { res, data } = await api(`/api/tables/${code}/rematch`, { in: want });
    $("reveal-msg").textContent = res.ok ? "" : (data.error ?? "Could not say you're in.");
    if (res.ok) onState(data as unknown as State);
  });
  $("again").addEventListener("click", async () => {
    const { res, data } = await api(`/api/tables/${code}/start`, {});
    $("reveal-msg").textContent = res.ok ? "" : (data.error ?? "Could not start a new game.");
  });
  for (const [id, msgId] of [["next", "reveal-msg"], ["to-vote", "audio-msg"]] as const) {
    $(id).addEventListener("click", async () => {
      const { res, data } = await api(`/api/tables/${code}/advance`, {});
      $(msgId).textContent = res.ok ? "" : (data.error ?? "Could not move on.");
    });
  }

  $("own-audio").addEventListener("change", () => {
    if (isHost()) return render();
    audioChoice = $<HTMLInputElement>("own-audio").checked ? "mine" : "host";
    writeAudioChoice(audioChoice);
    if (audioChoice === "host") stopAudio();
    $("audio-msg").textContent = "";
    render();
    syncAudio();
  });

  $("role-toggle").addEventListener("click", () => {
    roleShown = !roleShown;
    render();
  });

  // ---- audio: a plain element, no title, no artwork ----

  const audio = $<HTMLAudioElement>("audio");
  // A silent clip: playing it from a tap tells the browser this page may make sound.
  const SILENCE = "data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YQAAAAA=";
  let audioUnlocked = false;
  let playingSlot: number | null = null;
  let playSeq = 0;

  async function playSlot(n: number) {
    const seq = ++playSeq;
    playingSlot = n;
    $("audio-msg").textContent = "";
    const { res, data } = await api<{ url: string }>(`/api/tables/${code}/cards/${n}/audio`);
    if (seq !== playSeq) return;
    if (!res.ok) return void ($("audio-msg").textContent = data.error ?? "That track has no preview.");
    audio.src = data.url;
    try {
      await audio.play();
      audioUnlocked = true;
    } catch {
      // The browser wants a tap first; the unlock button waits for one.
      audioUnlocked = false;
      $("audio-msg").textContent = "Tap the button to let this phone play.";
    }
    render();
  }

  function stopAudio() {
    playSeq++;
    playingSlot = null;
    audio.pause();
  }

  async function playByHost(n: number) {
    // Play right here, inside the tap, then tell everyone else.
    void playSlot(n);
    const { res, data } = await api(`/api/tables/${code}/round/play`, { slot: n });
    if (!res.ok) $("audio-msg").textContent = data.error ?? "Could not play that track.";
  }

  $("unlock").addEventListener("click", async () => {
    audio.src = SILENCE;
    await audio.play().catch(() => {});
    audioUnlocked = true;
    $("audio-msg").textContent = "";
    const np = state?.game?.nowPlaying;
    if (np !== null && np !== undefined) void playSlot(np);
    else render();
  });

  // Phones that play their own copy follow game.nowPlaying; the rest stay silent.
  function syncAudio() {
    const g = state?.game;
    const live = state?.status === "playing" && g && (g.phase === "listen" || g.phase === "vote");
    if (!live || !speakerHere() || g.nowPlaying === null) {
      if (playingSlot !== null) stopAudio();
      return;
    }
    if (g.nowPlaying !== playingSlot) void playSlot(g.nowPlaying);
  }

  // ---- leaving ----

  let leaving = false;
  async function leave() {
    leaving = true;
    await api(`/api/tables/${code}/leave`, {});
    location.href = "/shop";
  }
  $("leave").addEventListener("click", () => {
    if (state?.status !== "playing") return void leave();
    show("leave-confirm", true);
    $("leave-yes").focus();
  });
  $("leave-no").addEventListener("click", () => {
    show("leave-confirm", false);
    $("leave").focus();
  });
  $("leave-yes").addEventListener("click", () => void leave());
  $("leave-confirm").addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Escape") $("leave-no").click();
  });

  // ---- visibility, removing, reporting (decision 0005) ----

  for (const id of ["vis-public", "vis-private"]) {
    $(id).addEventListener("change", async () => {
      const wantPrivate = $<HTMLInputElement>("vis-private").checked;
      const msg = $("vis-msg");
      msg.textContent = "";
      const { res, data } = await api(`/api/tables/${code}/visibility`, { private: wantPrivate });
      if (!res.ok) {
        msg.textContent = res.status === 409 ? "You can't change this during a game." : (data.error ?? "Could not change that.");
        return render();
      }
      msg.textContent = wantPrivate ? "Now private: only people with the code can sit down." : "Now open: anyone in the shop can sit down.";
      onState(data as unknown as State);
    });
  }

  let removeFocus: HTMLElement | null = null;
  let removing = "";
  function askRemove(name: string, from: HTMLElement) {
    removing = name;
    removeFocus = from;
    $("remove-q").replaceChildren(h("strong", {}, `Remove ${name}?`), " They leave the table and can't sit here again.");
    show("remove-confirm", true);
    $("remove-yes").focus();
  }
  function closeRemove() {
    show("remove-confirm", false);
    // The members list may have been redrawn: fall back to its first Remove button.
    const back = removeFocus && removeFocus.isConnected ? removeFocus : document.querySelector<HTMLElement>("#members .rm");
    back?.focus();
    removeFocus = null;
  }
  $("remove-no").addEventListener("click", closeRemove);
  $("remove-yes").addEventListener("click", async () => {
    const name = removing;
    const msg = $("remove-msg");
    msg.textContent = "";
    const { res, data } = await api(`/api/tables/${code}/remove`, { name });
    closeRemove();
    if (!res.ok) return void (msg.textContent = data.error ?? `Could not remove ${name}.`);
    announce(`${name} was removed from the table.`);
    onState(data as unknown as State);
  });
  $("remove-confirm").addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Escape") $("remove-no").click();
  });

  $("report-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const msg = $("report-msg");
    const { res, data } = await api(`/api/tables/${code}/report`, { reason: $<HTMLSelectElement>("report-reason").value });
    msg.textContent = res.ok ? "Reported, thanks."
      : res.status === 409 ? "Already reported."
      : (data.error ?? "Could not send that report.");
  });

  // ---- the 3D scene (decoration; the page above is complete without it) ----
  // Loaded once, after the first state has rendered, and only where it can run:
  // WebGL 2 present and no request for reduced motion. The engine is a separate
  // chunk that nothing else imports. Any failure removes the scene quietly.
  const SCENE_KEY = "mole:scene";
  const readScene = (): boolean => { try { return localStorage.getItem(SCENE_KEY) !== "off"; } catch { return true; } };
  const writeScene = (on: boolean) => { try { localStorage.setItem(SCENE_KEY, on ? "on" : "off"); } catch { /* not saved */ } };
  let sceneWanted = readScene();
  let scene: TableScene | null = null;
  let sceneLoading = false;
  let sceneDead = false;
  let sceneStarted = false;
  let sceneVisible = true;
  const slot = $("scene-slot");
  const stage = $("scene-stage");
  const toggle = $<HTMLButtonElement>("scene-toggle");

  const canRunScene = () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2");
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch { return false; }
  };
  const describeScene = () => {
    const n = state?.members.length ?? 0;
    $("scene-desc").textContent = `Decorative 3D view: ${n} ${n === 1 ? "person" : "people"} sitting round a table with a record player. The same information is in the lists below.`;
  };
  const syncToggle = () => {
    toggle.textContent = `3D scene: ${sceneWanted ? "on" : "off"}`;
    toggle.setAttribute("aria-pressed", String(sceneWanted));
    stage.hidden = !sceneWanted;
  };
  const dropScene = (fatal: boolean) => {
    scene?.destroy();
    scene = null;
    sceneLoading = false;
    stage.querySelector(".scene-skel")?.removeAttribute("hidden");
    if (fatal) {
      sceneDead = true;
      slot.hidden = true;
    }
  };
  const syncPause = () => scene?.setPaused(document.hidden || !sceneVisible || !sceneWanted);
  async function loadScene() {
    if (scene || sceneLoading || sceneDead || !sceneWanted) return;
    sceneLoading = true;
    stage.classList.remove("ready");
    try {
      const { startTableScene } = await import("../../scene/table-scene.ts");
      const s = await startTableScene(stage, () => stage.classList.add("ready"));
      if (!sceneWanted || sceneDead) { s.destroy(); sceneLoading = false; return; }
      scene = s;
      sceneLoading = false;
      if (state) scene.update(state as never);
      syncPause();
    } catch {
      dropScene(true);
    }
  }
  function sceneTick() {
    if (!state) return;
    if (!sceneStarted) {
      sceneStarted = true;
      if (!canRunScene()) { sceneDead = true; return; }
      slot.hidden = false;
      syncToggle();
      toggle.addEventListener("click", () => {
        sceneWanted = !sceneWanted;
        writeScene(sceneWanted);
        syncToggle();
        if (sceneWanted) void loadScene();
        else dropScene(false);
      });
      new IntersectionObserver((e) => { sceneVisible = e[e.length - 1].isIntersecting; syncPause(); }).observe(slot);
      document.addEventListener("visibilitychange", syncPause);
      // after the page is usable: let the first paint and idle time go first
      const go = () => void loadScene();
      if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1500 });
      else setTimeout(go, 400);
    }
    describeScene();
    scene?.update(state as never);
  }

  // ---- following the table ----

  // The host took this person out: say so, drop the game UI and stop listening.
  function showRemoved() {
    removed = true;
    stopAudio();
    streamCtl?.abort();
    scene?.destroy();
    scene = null;
    sceneDead = true;
    for (const id of ["table-grid", "scene-slot", "leave", "to-shop", "leave-confirm", "remove-confirm", "status"]) show(id, false);
    show("removed", true);
    show("conn", false);
    announce("The host removed you from this table.");
    $("removed-h").tabIndex = -1;
    $("removed-h").focus();
  }

  let removed = false;
  let wasMember = false;
  let refusedJoin = false;
  function onState(next: State) {
    if (removed) return;
    if (next.members.some((m) => m.name === myName)) wasMember = true;
    else if (!leaving && (wasMember || refusedJoin)) return void showRemoved();
    const prev = state;
    state = next;
    const g = next.game;
    const key = `${next.status}|${g?.round}|${g?.phase}`;
    if (key !== lastKey) {
      const newRound = !prev || prev.game?.round !== g?.round || prev.status !== next.status;
      lastKey = key;
      roleShown = g?.phase === "pick";
      $("pick-msg").textContent = "";
      $("vote-msg").textContent = "";
      $("reveal-msg").textContent = "";
      if (g?.phase === "pick") borrowOpen = false;
      if (g?.phase !== "vote") voteTab = "mole";
      if (g?.phase !== "steal") { stealGuessed = false; stealChoice = null; }
      if (newRound) {
        me = null;
      }
      if (g && next.status === "playing") {
        announce(
          g.phase === "pick" ? `Round ${g.round}. Picking: ${secondsLeft(g)} seconds.`
          : g.phase === "vote" ? `Vote. ${secondsLeft(g)} seconds.`
          : g.phase === "steal" ? "Steal! The mole has 15 seconds to guess the prompt."
          : g.phase === "reveal" ? "Reveal."
          : "Listen.",
        );
      }
      else if (g?.winner) announce(g.winner === "points" ? `Game over. ${g.winners && g.winners.length > 1 ? "Joint winners" : "Winner"}: ${(g.winners ?? []).join(", ")}.` : g.winner === "players" ? "Game over. The players caught every mole." : g.winner === "none" ? "Game abandoned: nobody picked." : "Game over. The moles took over.");
      void refreshMe();
      pendingEnter = true;
      // Keyboard and screen-reader users follow the game: land on the new phase's heading.
      // Not on the first frame of a page load, and not on later frames of the same phase.
      pendingFocus = prev && (g && next.status === "playing" || (g?.winner && g.winner !== "none")) ? (g!.winner ? "reveal-h" : `${g!.phase}-h`) : "";
    }
    render();
    if (pendingEnter) {
      pendingEnter = false;
      enterPhase();
    }
    syncAudio();
    document.querySelector<HTMLElement>(".game-col")!.dataset.phase = next.status === "playing" ? (g?.phase ?? "") : "";
    sceneTick();
  }

  // Phase change: slide the visible main cards in (transform and opacity only;
  // CSS turns this off under reduced motion).
  let pendingEnter = false;
  function enterPhase() {
    for (const el of document.querySelectorAll<HTMLElement>(".phase:not([hidden])")) {
      el.classList.remove("enter");
      void el.offsetWidth;
      el.classList.add("enter");
    }
  }

  $("copy-code").addEventListener("click", async () => {
    const note = $("copy-msg");
    try {
      await navigator.clipboard.writeText(code);
      note.textContent = "Code copied.";
    } catch {
      note.textContent = `Could not copy. The code is ${code}.`;
    }
  });

  // ---- connection: the stream, the banner, and the actions that would fail ----
  // The stream is read with fetch rather than EventSource so that the server's
  // heartbeat comment (every ~15 s), which EventSource hides, counts as proof
  // that it is alive. Nothing for 35 s means it has stalled: close and reopen.
  const STALL_MS = 35_000;
  const RETRY_MS = 2_000;
  let connected = false;
  // Why the server turned the stream away (429), and how long to wait before asking again.
  let fullMsg = "";
  let backoff = RETRY_MS;
  const conn = $("conn");
  // Anything that would fail while we can't reach the server. Buttons we turn off
  // are marked, so turning back on never touches one that was off for another reason.
  const ACTIONS = "#start, #again, #im-in, #add-bot, #add-bot2, #moles-lobby button, #moles-over button, #next, #to-vote, #cards button, #pick-fit button, #pick-rest button, #borrow-panel button, #borrow-toggle, #vote-list button, #vote-skip-wrap button, #best-list button, #format-lobby button, #format-over button, #steal-options button";
  function syncActions() {
    const down = !connected || !navigator.onLine;
    for (const b of document.querySelectorAll<HTMLButtonElement>(ACTIONS)) {
      if (down && !b.disabled) { b.disabled = true; b.dataset.conn = "1"; }
      else if (!down && b.dataset.conn) { b.disabled = false; delete b.dataset.conn; }
    }
  }
  function showConn() {
    if (removed) return;
    const offline = !navigator.onLine;
    const down = offline || !connected;
    conn.hidden = !down;
    app.classList.toggle("is-down", down);
    conn.textContent = offline
      ? "You're offline. Picking, voting and playing are paused until you are back."
      : fullMsg ? `${fullMsg} Picking, voting and playing are paused until you are in.`
      : "Reconnecting... Picking, voting and playing are paused until you are back.";
    syncActions();
  }
  window.addEventListener("offline", showConn);

  let lastFrame: State | null = null;
  let streamCtl: AbortController | null = null;
  let lastHeard = Date.now();
  let everOpened = false;
  function dropStream() { streamCtl?.abort(); }
  window.addEventListener("online", () => { showConn(); dropStream(); });

  function handleFrame(frame: string) {
    let event = "message";
    const data: string[] = [];
    for (const line of frame.split("\n")) {
      if (line.startsWith("event:")) event = line.slice(6).trim();
      else if (line.startsWith("data:")) data.push(line.slice(5).replace(/^ /, ""));
    }
    if (event !== "state" || !data.length) return;
    // A frame that doesn't parse is skipped, not fatal: throwing here would drop
    // a healthy stream and send it round the retry loop.
    let next: State;
    try { next = JSON.parse(data.join("\n")) as State; } catch { return; }
    // A slim frame leaves out what hasn't changed and names it in `same`: keep our copy.
    if (next.same?.includes("crates") && lastFrame) {
      const had = new Map(lastFrame.members.map((m) => [m.name, m.crate]));
      for (const m of next.members) if (!m.crate && had.get(m.name)) m.crate = had.get(m.name);
    }
    if (next.same?.includes("past") && next.game && lastFrame?.game) next.game.past = lastFrame.game.past;
    delete next.same;
    lastFrame = next;
    onState(next);
  }

  async function followOnce() {
    const ctl = new AbortController();
    streamCtl = ctl;
    // The first frame of a stream is complete: merge nothing from before it.
    lastFrame = null;
    lastHeard = Date.now();
    const res = await fetch(`/api/tables/${code}/events?slim=1`, { signal: ctl.signal, headers: { accept: "text/event-stream" }, cache: "no-store" });
    if (res.status === 429) {
      const why = res.headers.get("x-full");
      fullMsg = why === "table" ? "This table is full to watchers right now. Trying again shortly."
        : why === "person" ? "This table is open in too many tabs. Close some and it will reconnect."
        : "Too many connections from your network. Trying again shortly.";
      throw new Error("stream 429");
    }
    if (!res.ok || !res.body) throw new Error(`stream ${res.status}`);
    fullMsg = "";
    backoff = RETRY_MS;
    const reopened = everOpened;
    everOpened = true;
    connected = true;
    lastHeard = Date.now();
    showConn();
    // Back after a gap: ask again who we are and which tracks there are.
    if (reopened) void refreshMe();
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = "";
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      lastHeard = Date.now();
      buf += dec.decode(value, { stream: true }).replace(/\r\n/g, "\n");
      let i: number;
      while ((i = buf.indexOf("\n\n")) >= 0) {
        handleFrame(buf.slice(0, i));
        buf = buf.slice(i + 2);
      }
    }
  }

  async function follow() {
    while (!removed) {
      try { await followOnce(); } catch { /* aborted, refused or dropped: fall through and retry */ }
      if (removed) return;
      connected = false;
      showConn();
      const wait = !navigator.onLine ? 500 : fullMsg ? backoff : RETRY_MS;
      if (fullMsg) backoff = Math.min(backoff * 2, 30_000);
      await new Promise((r) => setTimeout(r, wait));
    }
  }
  // A stream that says nothing, not even a heartbeat, is dead: close it, say so, reopen.
  setInterval(() => {
    if (Date.now() - lastHeard > STALL_MS) {
      connected = false;
      showConn();
      dropStream();
      lastHeard = Date.now();
    }
  }, 5_000);

  // The page is signed in (the server redirects otherwise); make sure this
  // person is a member, then watch the table. On every reopening we ask again
  // who we are, to land in the right view.
  api(`/api/tables/${code}/join`, {}).then(({ res }) => { refusedJoin = res.status === 403; }).finally(async () => {
    const first = await fetch(`/api/tables/${code}`).catch(() => null);
    const date = first?.headers.get("date");
    if (date) clockSkew = Date.parse(date) - Date.now() + 500;
    void follow();
  });
</script>
