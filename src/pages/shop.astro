---
import Base from "../layouts/Base.astro";
import { personFromCookies } from "../lib/auth.ts";
import { booths } from "../lib/booths.ts";
import { boothList } from "../scene/shop-list.ts";
// Signed out goes to the front door, which brings you back here after sign-in.
const me = personFromCookies(Astro.cookies);
if (!me) return Astro.redirect("/?next=/shop");
// The first paint of the 2D list is server-rendered from the same public Booth
// fields the stream carries: a private booth has no code in it.
const list = booths();
---
<Base title="The shop · Mole" width="table">
  <div id="shop" class="shop" data-me={me.name}>
    <h1 class="sr-only">Mole Records, the shop floor</h1>
    <p class="sr-only" id="shop-live" role="status" aria-live="polite"></p>

    <div class="shop-bar">
      <p class="shop-count" id="shop-count"><span id="count-people">0</span> in the shop · <span id="count-booths">{list.length}</span> <span id="count-booths-word">{list.length === 1 ? "booth" : "booths"}</span></p>
      <div class="shop-bar-btns">
        <button type="button" id="scene-toggle" class="shop-btn ghost sm" aria-pressed="true" hidden>3D: on</button>
        <button type="button" id="sound-toggle" class="shop-btn ghost sm" aria-pressed="true">Sound: on</button>
        <label class="shop-vol"><span>Radio volume</span><input type="range" id="sound-vol" min="0" max="100" step="5" value="35"></label>
      </div>
    </div>

    <section id="shop-stage" class="shop-stage" aria-label="3D shop floor (decorative; everything here is also in the lists below)" hidden>
      <div class="shop-loading" id="shop-loading" aria-hidden="true"><div>Opening up<span>unlocking the shop</span></div></div>
      <div class="shop-hud" id="shop-hud">
        <div class="shop-brand" aria-hidden="true"><b>Mole Records</b><small><em id="hud-people">0</em> in the shop · <em id="hud-booths">0</em> <span id="hud-booths-word">booths</span></small></div>
        <div class="shop-hint" aria-hidden="true">WASD or click to walk · Space to jump · E to sit</div>
        <div class="shop-sheet" id="shop-sheet" role="region" aria-label="Nearby" hidden></div>
        <div class="shop-emotes" id="shop-emotes">
          <button type="button" data-e="wave">Wave</button>
          <button type="button" data-e="nope">Nope</button>
          <button type="button" data-e="jump">Jump</button>
          <button type="button" data-e="dance">Dance</button>
        </div>
        <div class="shop-stick" id="shop-stick" aria-hidden="true"><i></i></div>
        <div class="shop-hud-btns">
          <button type="button" id="hud-list" class="shop-btn ghost sm" aria-expanded="false" aria-controls="shop-2d">Booth list</button>
        </div>
      </div>
    </section>

    <p class="shop-note shop-stream-note" id="shop-stream-note" role="status" hidden></p>

    <details id="shop-2d" class="shop-2d" open>
      <summary id="shop-2d-sum">Booths, the jukebox, the wall and people</summary>

      <section aria-labelledby="booths-h" class="shop-sec">
        <div class="shop-sec-head">
          <h2 id="booths-h">Booths</h2>
          <button type="button" id="quick-seat" class="shop-btn">Quick seat</button>
        </div>
        <p class="shop-msg" id="quick-msg" role="status"></p>
        <ul class="shop-booths" id="booth-list" set:html={boothList(list)} />
        <p class="shop-note"><a href="/">Start a table</a> from the home page and it opens as a booth here.</p>
      </section>

      <section aria-labelledby="juke-h" class="shop-sec juke" id="juke">
        <div class="shop-sec-head">
          <h2 id="juke-h">Jukebox</h2>
          <button type="button" id="juke-skip" class="shop-btn ghost sm" disabled>Skip</button>
        </div>
        <div id="juke-now" class="juke-box"><p class="juke-idle">Nothing queued, so the radio plays.</p></div>
        <p class="shop-msg" id="juke-msg" role="status"></p>
        <div id="juke-queue"></div>
        <details class="juke-add" id="juke-add">
          <summary>Queue a song from your crate</summary>
          <p class="shop-note">One song at a time. Everyone on the floor hears it with your name on it, so only songs clean enough for the crate starter can go on.</p>
          <div id="juke-crate" class="juke-crate"><p class="shop-note">Opening your crate…</p></div>
        </details>
      </section>

      <section aria-labelledby="wall-h" class="shop-sec wall">
        <details class="wall-fold" id="wall-fold" open>
          <summary><h2 id="wall-h">The wall</h2><span class="wall-count mono" id="wall-count"></span></summary>
          <p class="shop-note">Every revealed round from a public booth goes up here: the prompt, every pick and who picked it, and whether the mole was caught. Newest first.</p>
          <ul class="wall-grid" id="wall-list"><li class="wall-empty">Opening the wall…</li></ul>
          <button type="button" class="shop-btn ghost" id="wall-more" hidden>More</button>
          <p class="shop-msg" id="wall-msg" role="status"></p>
        </details>
      </section>

      <section aria-labelledby="people-h" class="shop-sec">
        <h2 id="people-h">In the shop</h2>
        <ul class="shop-people" id="people-list"><li>Connecting…</li></ul>
      </section>

      <section aria-labelledby="radio-h" class="shop-sec">
        <h2 id="radio-h">Radio</h2>
        <p id="radio-now" class="shop-note">The station is shared by the whole shop and can change once a minute. While a queued song plays, the radio waits.</p>
        <div class="shop-stations" id="stations" role="group" aria-label="Station">
          <button type="button" class="shop-btn ghost" data-mode="mix" aria-pressed="false">Mix</button>
          <button type="button" class="shop-btn ghost" data-mode="after-hours" aria-pressed="false">After Hours</button>
          <button type="button" class="shop-btn ghost" data-mode="back-room" aria-pressed="false">Back Room</button>
          <button type="button" class="shop-btn ghost" data-mode="late-bus" aria-pressed="false">Late Bus</button>
        </div>
        <p class="shop-msg" id="radio-msg" role="status"></p>
      </section>
    </details>

    <dialog id="wall-dialog" class="wall-dialog" aria-labelledby="wall-dialog-h">
      <div class="wall-dialog-in">
        <div class="wall-dialog-head"><h2 id="wall-dialog-h">On the wall</h2><button type="button" class="shop-btn ghost sm" id="wall-close">Close</button></div>
        <div id="wall-dialog-body"></div>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import type { ShopScene, Target } from "../scene/shop-scene.ts";
  import type { Booth } from "../lib/booths.ts";
  import { createRadio, type RadioInfo } from "../audio/radio.ts";
  import { createSfx } from "../audio/sfx.ts";
  import { boothList, boothSeen, esc } from "../scene/shop-list.ts";
  import type { Jukebox, Sleeve, WallPage } from "../scene/shop-types.ts";
  import { clock, linerNotes, msLeft, nowPlaying, playSay, queueList, wallItem } from "../scene/shop-wall.ts";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const shop = $("shop");
  const myName = shop.dataset.me!;
  const live = (t: string) => { $("shop-live").textContent = ""; setTimeout(() => ($("shop-live").textContent = t), 30); };

  // ---- sound: one control for the radio and the effects ----
  const sfx = createSfx();
  const radio = createRadio();
  const soundBtn = $<HTMLButtonElement>("sound-toggle");
  const vol = $<HTMLInputElement>("sound-vol");
  vol.value = String(Math.round(radio.state().volume * 100));
  sfx.setEnabled(radio.state().on);
  const paintSound = () => {
    const s = radio.state();
    soundBtn.textContent = `Sound: ${s.on ? "on" : "off"}`;
    soundBtn.setAttribute("aria-pressed", String(s.on));
    sfx.setEnabled(s.on);
    const name = s.stationName;
    $("radio-now").textContent = s.jukebox
      ? `The radio waits while a queued song plays.${s.on ? "" : " (Sound is off.)"}`
      : name ? `Now on the radio: ${name}.${s.on ? "" : " (Sound is off.)"}` : "The station is shared by the whole shop and can change once a minute.";
    const mode = s.mode;
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-mode]")) b.setAttribute("aria-pressed", String(b.dataset.mode === mode));
    sheetRefresh();
  };
  radio.subscribe(paintSound);
  soundBtn.addEventListener("click", () => {
    if (radio.state().on) radio.stop();
    else { sfx.unlock(); radio.start(); }
    paintSound();
  });
  vol.addEventListener("input", () => { radio.setVolume(Number(vol.value) / 100); });
  // Browsers play nothing before a tap or key press: the first one starts it.
  const firstGesture = () => {
    sfx.unlock();
    radio.gesture();
    removeEventListener("pointerdown", firstGesture, true);
    removeEventListener("keydown", firstGesture, true);
  };
  addEventListener("pointerdown", firstGesture, true);
  addEventListener("keydown", firstGesture, true);

  // ---- the 3D scene: loaded after the page is usable, only where it can run ----
  const SCENE_KEY = "mole:scene";
  const readScene = () => { try { return localStorage.getItem(SCENE_KEY) !== "off"; } catch { return true; } };
  const writeScene = (on: boolean) => { try { localStorage.setItem(SCENE_KEY, on ? "on" : "off"); } catch { /* not saved */ } };
  let sceneWanted = readScene();
  let scene: ShopScene | null = null;
  let sceneLoading = false;
  let sceneDead = false;
  let sceneVisible = true;
  let snapshot: { people: any[]; you: string } | null = null;
  const stage = $("shop-stage");
  const sceneBtn = $<HTMLButtonElement>("scene-toggle");
  const details = $<HTMLDetailsElement>("shop-2d");
  const canRunScene = () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2");
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch { return false; }
  };
  const syncScene = () => {
    sceneBtn.textContent = `3D: ${sceneWanted ? "on" : "off"}`;
    sceneBtn.setAttribute("aria-pressed", String(sceneWanted));
    stage.hidden = !sceneWanted || sceneDead;
    shop.classList.toggle("is-3d", sceneWanted && !sceneDead);
  };
  const syncPause = () => scene?.setPaused(document.hidden || !sceneVisible || !sceneWanted);
  function dropScene(fatal: boolean) {
    scene?.destroy();
    scene = null;
    sceneLoading = false;
    sheetClose();
    if (fatal) { sceneDead = true; stage.hidden = true; sceneBtn.hidden = true; details.open = true; }
    syncScene();
  }
  async function loadScene() {
    if (scene || sceneLoading || sceneDead || !sceneWanted) return;
    sceneLoading = true;
    $("shop-loading").classList.remove("done");
    try {
      const { startShopScene } = await import("../scene/shop-scene.ts");
      const s = await startShopScene(stage, {
        sendMove: (x, z, yaw) => void post("/api/shop/move", { x, z, yaw }).catch(() => {}),
        sendEmote: (e) => void post("/api/shop/emote", { emote: e }).catch(() => {}),
        onNear: (t) => { near = t; sheetRefresh(true); },
        onPrimary: () => primary(),
        onSleeve: (id) => openSleeve(id),
        sfx,
      }, () => $("shop-loading").classList.add("done"));
      if (!sceneWanted || sceneDead) { s.destroy(); sceneLoading = false; return; }
      scene = s;
      sceneLoading = false;
      s.setYou(myName);
      if (snapshot) { s.reset(snapshot.people); }
      s.setBooths(booths);
      s.setWall(sleeves);
      s.setJukebox(juke);
      syncPause();
      details.open = false;
    } catch (err) {
      // The 2D list is complete without it: drop the scene quietly (a note for whoever reads the console).
      console.debug("3D shop unavailable", err);
      dropScene(true);
    }
  }
  function sceneInit() {
    if (!canRunScene()) { sceneDead = true; sceneBtn.hidden = true; details.open = true; syncScene(); return; }
    sceneBtn.hidden = false;
    syncScene();
    sceneBtn.addEventListener("click", () => {
      sceneWanted = !sceneWanted;
      writeScene(sceneWanted);
      if (sceneWanted) { syncScene(); void loadScene(); }
      else { dropScene(false); details.open = true; }
    });
    new IntersectionObserver((e) => { sceneVisible = e[e.length - 1].isIntersecting; syncPause(); }).observe(stage);
    document.addEventListener("visibilitychange", syncPause);
    // the booth-list toggle (sound stays in the bar above, one copy only)
    const listBtn = $<HTMLButtonElement>("hud-list");
    const sync = () => listBtn.setAttribute("aria-expanded", String(details.open));
    details.addEventListener("toggle", sync);
    listBtn.addEventListener("click", () => {
      details.open = !details.open;
      if (details.open) details.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    sync();
    // joystick (touch devices show it by CSS)
    const el = $("shop-stick"), knob = el.firstElementChild as HTMLElement;
    let id: number | null = null;
    const move = (e: PointerEvent) => {
      const r = el.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      let dx = e.clientX - cx, dy = e.clientY - cy;
      const d = Math.hypot(dx, dy), max = r.width / 2 - 10;
      if (d > max) { dx = (dx / d) * max; dy = (dy / d) * max; }
      knob.style.transform = `translate(${dx}px, ${dy}px)`;
      scene?.setStick(dx / max, dy / max);
    };
    el.addEventListener("pointerdown", (e) => { id = e.pointerId; el.setPointerCapture(id); move(e); });
    el.addEventListener("pointermove", (e) => { if (e.pointerId === id) move(e); });
    const end = () => { id = null; scene?.setStick(0, 0); knob.style.transform = ""; };
    el.addEventListener("pointerup", end);
    el.addEventListener("pointercancel", end);
    $("shop-emotes").addEventListener("click", (e) => {
      const c = (e.target as HTMLElement).closest("button")?.dataset.e;
      if (c) scene?.myEmote(c as never);
    });
    const go = () => void loadScene();
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1500 });
    else setTimeout(go, 400);
  }

  // ---- talking to the server ----
  async function post(url: string, body?: unknown) {
    return fetch(url, { method: "POST", headers: body === undefined ? {} : { "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body), credentials: "same-origin" });
  }
  const errorOf = async (res: Response, fallback: string) => ((await res.json().catch(() => null)) as { error?: string } | null)?.error ?? fallback;

  // ---- booths (the 2D list; the 3D draws the same data) ----
  let booths: Booth[] = [];
  const listEl = $("booth-list");
  let lastHtml = listEl.innerHTML;
  function renderList() {
    const html = boothList(booths);
    $("count-booths").textContent = String(booths.length);
    $("count-booths-word").textContent = booths.length === 1 ? "booth" : "booths";
    $("hud-booths").textContent = String(booths.length);
    $("hud-booths-word").textContent = booths.length === 1 ? "booth" : "booths";
    if (html === lastHtml) return;
    lastHtml = html;
    // keep what someone is typing, which report form is open and any message
    const keep = new Map<string, { vals: Record<string, string>; open: boolean; msg: string }>();
    for (const li of listEl.querySelectorAll<HTMLElement>("li[data-key]")) {
      const vals: Record<string, string> = {};
      for (const f of li.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[name]")) vals[f.name] = f.value;
      keep.set(li.dataset.key!, { vals, open: !!li.querySelector("details")?.open, msg: li.querySelector(".shop-msg")?.textContent ?? "" });
    }
    const a = document.activeElement as HTMLElement | null;
    const focus = a && listEl.contains(a) ? { key: a.closest("li")?.getAttribute("data-key"), sel: a.getAttribute("data-act") ? `[data-act="${a.getAttribute("data-act")}"]` : a.getAttribute("name") ? `[name="${a.getAttribute("name")}"]` : a.tagName.toLowerCase() } : null;
    listEl.innerHTML = html;
    for (const li of listEl.querySelectorAll<HTMLElement>("li[data-key]")) {
      const k = keep.get(li.dataset.key!);
      if (!k) continue;
      for (const f of li.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[name]")) if (k.vals[f.name] !== undefined) f.value = k.vals[f.name];
      const d = li.querySelector("details");
      if (d) d.open = k.open;
      const m = li.querySelector(".shop-msg");
      if (m) m.textContent = k.msg;
    }
    if (focus?.key) listEl.querySelector<HTMLElement>(`li[data-key="${focus.key}"] ${focus.sel}`)?.focus();
    sheetRefresh();
  }
  const boothByCode = (code: string) => booths.find((b) => b.code === code);

  // ---- taking a seat ----
  let leaving = false;
  const go = (code: string) => { location.href = `/t/${code}`; };
  async function sitDown(code: string, say: (m: string) => void): Promise<boolean> {
    if (leaving) return false;
    sfx.click();
    say("Taking a seat…");
    const res = await post(`/api/tables/${code}/join`);
    if (!res.ok) { say(await errorOf(res, "Could not sit there.")); return false; }
    leaving = true;
    say(`Sitting at ${code}…`);
    const b = boothByCode(code);
    if (scene && b && b.spot >= 0) {
      // Watch yourself sit down, but never wait more than a few seconds for it
      // (a slow phone walks slowly): the game is on the table page.
      const ok = await Promise.race([scene.sitAt(b.spot), new Promise<boolean>((r) => setTimeout(() => r(false), 3500))]);
      setTimeout(() => go(code), ok ? 900 : 0);
    } else go(code);
    return true;
  }
  async function reportBooth(code: string, reason: string, say: (m: string) => void) {
    const res = await post(`/api/tables/${code}/report`, { reason });
    say(res.ok ? "Reported, thanks" : res.status === 409 ? "Already reported" : await errorOf(res, "Could not send the report."));
  }
  async function knock(code: string, say: (m: string) => void) {
    code = code.trim().toUpperCase();
    if (!/^[A-Z]{4}$/.test(code)) return say("A code is four letters.");
    sfx.click();
    const res = await post(`/api/tables/${code}/join`);
    if (res.ok) { leaving = true; say("Opening the door…"); go(code); }
    else say(res.status === 404 ? "No booth with that code." : await errorOf(res, "That code didn't work."));
  }

  listEl.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-act]");
    if (!btn) return;
    const li = btn.closest("li")!;
    const msg = li.querySelector(".shop-msg")!;
    if (btn.dataset.act === "sit") void sitDown(btn.dataset.code!, (m) => (msg.textContent = m));
  });
  listEl.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msg = form.closest("li")!.querySelector(".shop-msg")!;
    const say = (m: string) => (msg.textContent = m);
    if (form.dataset.form === "knock") void knock((form.elements.namedItem("code") as HTMLInputElement).value, say);
    else if (form.dataset.form === "report") void reportBooth(form.dataset.code!, (form.elements.namedItem("reason") as HTMLSelectElement).value, say);
  });

  $("quick-seat").addEventListener("click", async () => {
    const msg = $("quick-msg");
    sfx.click();
    msg.textContent = "Looking for a booth…";
    const res = await post("/api/shop/quick-seat");
    if (res.status === 404) {
      msg.innerHTML = `No open booths waiting right now. <a href="/">Start one</a>.`;
      return;
    }
    if (!res.ok) { msg.textContent = await errorOf(res, "Could not find a seat."); return; }
    const { code } = (await res.json()) as { code: string };
    leaving = true;
    msg.textContent = `Sitting at ${code}…`;
    const b = boothByCode(code);
    if (scene && b && b.spot >= 0) {
      // Watch yourself sit down, but never wait more than a few seconds for it
      // (a slow phone walks slowly): the game is on the table page.
      const ok = await Promise.race([scene.sitAt(b.spot), new Promise<boolean>((r) => setTimeout(() => r(false), 3500))]);
      setTimeout(() => go(code), ok ? 900 : 0);
    } else go(code);
  });

  // ---- people ----
  const roster = new Map<string, string>();
  function renderPeople() {
    const names = [...roster.keys()].sort((a, b) => (a === myName ? -1 : b === myName ? 1 : a.localeCompare(b)));
    $("count-people").textContent = $("hud-people").textContent = String(names.length);
    $("people-list").innerHTML = names.length ? names.map((n) => `<li>${esc(n)}${n === myName ? " (you)" : ""}</li>`).join("") : "<li>Nobody yet.</li>";
  }

  // ---- the jukebox ----
  const STATIONS = [["mix", "Mix"], ["after-hours", "After Hours"], ["back-room", "Back Room"], ["late-bus", "Late Bus"]] as const;
  async function setStation(mode: string, say: (m: string) => void) {
    sfx.click();
    const res = await post("/api/shop/radio", { mode });
    if (res.status === 429) {
      const b = (await res.json().catch(() => ({}))) as { retryAfter?: number };
      return say(`The jukebox was just used. Try again in ${b.retryAfter ?? 60} seconds.`);
    }
    if (!res.ok) return say(await errorOf(res, "The jukebox didn't take that."));
    say("");
    const r = (await res.json()) as RadioInfo;
    radio.update(r, { changed: true });
    sfx.clunk();
  }
  $("stations").addEventListener("click", (e) => {
    const m = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-mode]")?.dataset.mode;
    if (m) void setStation(m, (t) => ($("radio-msg").textContent = t));
  });

  // ---- the wall: every revealed round of a public booth, newest first ----
  let sleeves: Sleeve[] = [];
  let wallMore = false;
  let wallLoaded = false;
  const announced = new Set<string>();
  const wallList = $("wall-list");
  const wallBtn = $<HTMLButtonElement>("wall-more");
  function renderWall(freshId?: string) {
    $("wall-count").textContent = sleeves.length ? `${sleeves.length}${wallMore ? "+" : ""} ${sleeves.length === 1 ? "sleeve" : "sleeves"}` : "";
    wallList.innerHTML = sleeves.length
      ? sleeves.map((x) => wallItem(x, { fresh: x.id === freshId && !matchMedia("(prefers-reduced-motion: reduce)").matches })).join("")
      : `<li class="wall-empty">Nothing on the wall yet. When a public booth reveals a round, its sleeve goes up here.</li>`;
    wallBtn.hidden = !wallMore;
    // newest 40 on the 3D wall (it caps itself); the 2D list holds everything loaded
    scene?.setWall(sleeves, freshId);
    if (near?.kind === "wall") sheetRefresh(true);
  }
  // The newest page: on first load it is the wall; later (a reconnect) it only
  // adds what arrived while the stream was out, keeping what "More" loaded.
  function setWallFirst(pg: WallPage) {
    const have = new Set(sleeves.map((x) => x.id));
    const add = pg.sleeves.filter((x) => !have.has(x.id));
    for (const x of pg.sleeves) announced.add(x.id);
    if (!wallLoaded) wallMore = pg.more;
    wallLoaded = true;
    if (!add.length && sleeves.length) return;
    sleeves = sleeves.concat(add).sort((a, b) => b.revealedAt - a.revealedAt);
    renderWall();
  }
  async function loadWall() {
    try {
      const r = await fetch("/api/wall?limit=20", { credentials: "same-origin" });
      if (!r.ok) throw new Error(String(r.status));
      setWallFirst((await r.json()) as WallPage);
    } catch {
      if (!wallLoaded) wallList.innerHTML = `<li class="wall-empty">The wall didn't load. It will try again when the shop reconnects.</li>`;
    }
  }
  wallBtn.addEventListener("click", async () => {
    const last = sleeves[sleeves.length - 1];
    if (!last) return;
    wallBtn.disabled = true;
    $("wall-msg").textContent = "Loading older sleeves…";
    try {
      const r = await fetch(`/api/wall?before=${last.revealedAt}&limit=20`, { credentials: "same-origin" });
      if (!r.ok) throw new Error(String(r.status));
      const pg = (await r.json()) as WallPage;
      const have = new Set(sleeves.map((x) => x.id));
      const firstNew = pg.sleeves.find((x) => !have.has(x.id));
      sleeves = sleeves.concat(pg.sleeves.filter((x) => !have.has(x.id)));
      wallMore = pg.more;
      for (const x of pg.sleeves) announced.add(x.id);
      renderWall();
      $("wall-msg").textContent = pg.sleeves.length ? `${pg.sleeves.length} older ${pg.sleeves.length === 1 ? "sleeve" : "sleeves"} added.` : "That's the whole wall.";
      if (firstNew) wallList.querySelector<HTMLElement>(`[data-wall="${CSS.escape(firstNew.id)}"]`)?.focus();
      else if (!wallMore) $("wall-h").closest("summary")?.focus();
    } catch {
      $("wall-msg").textContent = "Couldn't load more just now.";
    } finally {
      wallBtn.disabled = false;
    }
  });
  function addSleeve(x: Sleeve) {
    // A Knockout game's end sends its earlier sleeves again, now naming the moles: replace in place.
    const at = sleeves.findIndex((y) => y.id === x.id);
    if (at >= 0) { sleeves = sleeves.map((y, i) => (i === at ? x : y)); renderWall(); return; }
    sleeves = [x, ...sleeves];
    renderWall(x.id);
    // once per sleeve, politely
    if (!announced.has(x.id)) {
      announced.add(x.id);
      live(`New on the wall: "${x.prompt}", from booth ${x.table}.`);
    }
  }
  wallList.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-wall]");
    if (b) openSleeve(b.dataset.wall!, b);
  });
  const dialog = $<HTMLDialogElement>("wall-dialog");
  let opener: HTMLElement | null = null;
  function openSleeve(id: string, from?: HTMLElement) {
    const x = sleeves.find((y) => y.id === id);
    if (!x) return;
    opener = from ?? (document.activeElement as HTMLElement | null);
    $("wall-dialog-h").textContent = `On the wall: booth ${x.table}, round ${x.round}`;
    $("wall-dialog-body").innerHTML = linerNotes(x);
    if (!dialog.open) dialog.showModal();
    $("wall-close").focus();
  }
  $("wall-close").addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener("close", () => { if (opener?.isConnected) opener.focus(); opener = null; });

  // ---- the jukebox: one song at a time from someone's crate, heard by the whole floor ----
  let juke: Jukebox | null = null;
  let saidPlay = "";
  let jukeFirst = true;
  const skipped = new Set<string>();
  const skipBtn = $<HTMLButtonElement>("juke-skip");
  function setJuke(j: Jukebox) {
    juke = j;
    const p = j.now;
    $("juke-now").innerHTML = nowPlaying(j);
    $("juke-queue").innerHTML = queueList(j);
    skipBtn.disabled = !p || skipped.has(p.id);
    skipBtn.textContent = p ? `Skip ${j.skips}/${j.needed}` : "Skip";
    skipBtn.setAttribute("aria-label", p ? `Skip this song. ${j.skips} of ${j.needed} skips needed${skipped.has(p.id) ? "; you skipped it" : ""}` : "Skip (nothing playing)");
    radio.jukebox(p ? { id: p.id, trackId: p.trackId, startedAt: p.startedAt ?? Date.now(), ms: p.ms, title: p.title } : null);
    scene?.setJukebox(j);
    // a new song is said once, politely
    if (p && p.id !== saidPlay) {
      saidPlay = p.id;
      // the song already on when the page opened is in the list, not announced
      if (!jukeFirst) { live(`Jukebox: ${playSay(p)}.`); sfx.clunk(); }
    }
    jukeFirst = false;
    if (!p) saidPlay = "";
    if (near?.kind === "jukebox") sheetRefresh();
    paintSound();
  }
  // time left, once a second, without announcing it
  setInterval(() => {
    const p = juke?.now;
    const el = document.querySelector<HTMLElement>("[data-juke-left]");
    if (p && el) el.textContent = clock(msLeft(p));
  }, 1000);
  async function skip(say: (m: string) => void) {
    const p = juke?.now;
    if (!p || skipped.has(p.id)) return;
    sfx.click();
    const res = await post("/api/shop/jukebox/skip");
    if (!res.ok) return say(await errorOf(res, "The skip didn't count."));
    skipped.add(p.id);
    const d = (await res.json().catch(() => null)) as { skips?: number; needed?: number } | null;
    if (juke && d && typeof d.skips === "number" && typeof d.needed === "number" && juke.now?.id === p.id) setJuke({ ...juke, skips: d.skips, needed: d.needed });
    else if (juke) setJuke(juke);
    say(d && typeof d.skips === "number" && typeof d.needed === "number" && d.skips < d.needed ? `You skipped. ${d.skips} of ${d.needed}.` : "Skipped.");
  }
  skipBtn.addEventListener("click", () => void skip((m) => ($("juke-msg").textContent = m)));
  async function loadJuke() {
    try {
      const r = await fetch("/api/shop/jukebox", { credentials: "same-origin" });
      if (r.ok) setJuke((await r.json()) as Jukebox);
    } catch { /* the stream brings it */ }
  }
  // Your crate, to queue from (GET /api/taste: your own songs, by mood).
  type CrateSong = { id: number; title: string; artist: string; cover?: string | null; slot: "up" | "down" | "out" | "in" | null };
  let crate: CrateSong[] | null = null;
  const MOODS = [["up", "Up"], ["down", "Down"], ["out", "Out"], ["in", "In"]] as const;
  async function loadCrate() {
    if (crate) return;
    const box = $("juke-crate");
    try {
      const r = await fetch("/api/taste", { credentials: "same-origin" });
      if (!r.ok) throw new Error(String(r.status));
      crate = (await r.json()) as CrateSong[];
    } catch {
      box.innerHTML = `<p class="shop-note">Your crate didn't load. Close this and try again.</p>`;
      return;
    }
    if (!crate.length) {
      box.innerHTML = `<p class="shop-note">Your crate is empty. <a href="/taste">Fill your crate</a> and come back to queue a song.</p>`;
      return;
    }
    const group = (slot: string | null) => crate!.filter((t) => (t.slot ?? null) === slot);
    const row = (t: CrateSong) => `<li><span class="juke-song"><b>${esc(t.title)}</b> <span>${esc(t.artist)}</span></span><button type="button" class="shop-btn ghost sm" data-queue="${t.id}" aria-label="Queue ${esc(t.title)} by ${esc(t.artist)}">Queue</button></li>`;
    const parts = MOODS.filter(([m]) => group(m).length).map(([m, n]) => `<h3 class="juke-mood mono">${n}</h3><ul class="juke-songs">${group(m).map(row).join("")}</ul>`);
    if (group(null).length) parts.push(`<h3 class="juke-mood mono">Not sorted</h3><ul class="juke-songs">${group(null).map(row).join("")}</ul>`);
    box.innerHTML = parts.join("") + `<p class="shop-msg" id="juke-add-msg" role="status"></p>`;
  }
  $("juke-add").addEventListener("toggle", () => { if ($<HTMLDetailsElement>("juke-add").open) void loadCrate(); });
  $("juke-crate").addEventListener("click", async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-queue]");
    if (!b) return;
    const say = (m: string) => { const el = document.getElementById("juke-add-msg"); if (el) el.textContent = m; };
    sfx.click();
    b.disabled = true;
    const res = await post("/api/shop/jukebox", { trackId: Number(b.dataset.queue) });
    b.disabled = false;
    if (!res.ok) return say(await errorOf(res, "The jukebox didn't take that one."));
    const d = (await res.json().catch(() => null)) as { play?: { title?: string } } | null;
    say(`Queued${d?.play?.title ? `: ${d.play.title}` : ""}. Everyone hears it with your name on it.`);
  });

  // ---- the 3D bottom sheet: the booth, jukebox or wall you are standing at ----
  const sheet = $("shop-sheet");
  let near: Target = null;
  let sheetKey = "";
  function sheetClose() { near = null; sheetKey = ""; sheet.hidden = true; sheet.classList.remove("on"); }
  function sheetRefresh(force = false) {
    let key = "", html = "";
    if (near?.kind === "booth") {
      const b = booths.find((x) => x.spot === (near as { spot: number }).spot);
      if (b) {
        const full = b.seated >= b.max;
        const status = b.status === "playing" ? "A game is on; you would join the next one." : "Not started yet.";
        if (b.private || !b.code) {
          key = `p-${b.spot}-${b.seated}-${b.status}`;
          html = `<div class="row"><h2>Private booth · ${esc(b.host)}</h2><span class="shop-pill dim">Code only</span></div>
            <p>${esc(b.host)} is playing with friends. If they gave you the code, type it in.</p>
            <form class="row" data-s="knock" novalidate><label class="sr-only" for="sheet-code">Booth code</label><input id="sheet-code" name="code" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="CODE"><button type="submit" class="shop-btn ghost">Knock</button></form>
            <p class="shop-msg" role="status"></p>`;
        } else {
          key = `o-${b.code}-${b.seated}-${b.status}`;
          const seen = boothSeen(b);
          key += `-${seen}`;
          html = `<div class="row"><h2>Booth ${esc(b.code)}</h2><span class="shop-pill">${b.status === "playing" ? "Playing" : "Open to anyone"}</span></div>
            <p>${esc(b.host)}'s table. ${b.seated} of ${b.max} seats taken. ${status}</p>${seen ? `<p class="shop-seen mono">${esc(seen)}</p>` : ""}
            <div class="row"><button type="button" class="shop-btn" data-s="sit" data-code="${b.code}"${full || leaving ? " disabled" : ""}>Take a seat</button>
            <details class="shop-report"><summary>Report</summary><form data-s="report" data-code="${b.code}" novalidate><label class="sr-only" for="sheet-why">Reason</label><select id="sheet-why" name="reason">${["rude names", "spam", "trolling the game", "something else"].map((r) => `<option>${r}</option>`).join("")}</select><button type="submit" class="shop-btn ghost sm">Send</button></form></details></div>
            <p class="shop-msg" role="status"></p>`;
        }
      }
    } else if (near?.kind === "jukebox") {
      const s = radio.state();
      const p = juke?.now;
      key = `j-${s.mode}-${s.stationName}-${p?.id ?? ""}-${juke?.skips ?? 0}-${juke?.queue.length ?? 0}`;
      html = p
        ? `<div class="row"><h2>Jukebox</h2><span class="shop-pill">Playing</span></div>
          <p><b>${esc(p.title)}</b>, ${esc(p.artist)}. Picked by ${esc(p.picker)}.${juke!.queue.length ? ` ${juke!.queue.length} more queued.` : ""}</p>
          <div class="stations"><button type="button" class="shop-btn ghost sm" data-s="skip"${skipped.has(p.id) ? " disabled" : ""}>Skip (${juke!.skips}/${juke!.needed})</button><button type="button" class="shop-btn sm" data-s="queue">Queue a song</button></div>
          <p class="shop-msg" role="status"></p>`
        : `<div class="row"><h2>Jukebox</h2><span class="shop-pill">${esc(s.stationName || "Radio")}</span></div>
          <p>Nothing queued, so the radio plays. Queue a song from your crate, or pick the station; it can change once a minute.</p>
          <div class="stations"><button type="button" class="shop-btn sm" data-s="queue">Queue a song</button>${STATIONS.map(([m, n]) => `<button type="button" class="shop-btn ghost sm" data-s="station" data-mode="${m}" aria-pressed="${s.mode === m}">${n}</button>`).join("")}</div>
          <p class="shop-msg" role="status"></p>`;
    } else if (near?.kind === "wall") {
      const here = near.ids.map((id) => sleeves.find((x) => x.id === id)).filter((x): x is Sleeve => !!x);
      key = `w-${near.ids.join(",")}`;
      html = `<div class="row"><h2>The wall</h2><span class="shop-pill">${here.length} ${here.length === 1 ? "sleeve" : "sleeves"}</span></div>
        <p class="wall-sheet-note">Rounds from the booths, as they were revealed. Open one for its picks.</p>
        <div class="sheet-sleeves">${here.map((x) => `<button type="button" class="shop-btn ghost sm" data-s="sleeve" data-id="${esc(x.id)}">${esc(x.prompt)}</button>`).join("")}</div>`;
    }
    if (key === sheetKey && !force) return;
    if (key === sheetKey && sheet.contains(document.activeElement)) return;
    sheetKey = key;
    const code = (sheet.querySelector<HTMLInputElement>("input[name=code]")?.value) ?? "";
    sheet.innerHTML = html;
    const input = sheet.querySelector<HTMLInputElement>("input[name=code]");
    if (input) input.value = code;
    sheet.hidden = !html;
    sheet.classList.toggle("on", !!html);
    stage.classList.toggle("has-sheet", !!html);
  }
  sheet.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-s]");
    const say = (m: string) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; };
    if (t?.dataset.s === "sit") void sitDown(t.dataset.code!, say);
    else if (t?.dataset.s === "station") void setStation(t.dataset.mode!, say);
    else if (t?.dataset.s === "skip") void skip(say);
    else if (t?.dataset.s === "sleeve") openSleeve(t.dataset.id!);
    else if (t?.dataset.s === "queue") {
      details.open = true;
      $<HTMLDetailsElement>("juke-add").open = true;
      void loadCrate();
      $("juke").scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
      $("juke-add").querySelector("summary")?.focus({ preventScroll: true });
    }
  });
  sheet.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const say = (m: string) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; };
    if (form.dataset.s === "knock") void knock((form.elements.namedItem("code") as HTMLInputElement).value, say);
    else if (form.dataset.s === "report") void reportBooth(form.dataset.code!, (form.elements.namedItem("reason") as HTMLSelectElement).value, say);
  });
  // E: take the open seat at the booth you are standing at
  function primary() {
    if (near?.kind !== "booth" || leaving) return;
    const b = booths.find((x) => x.spot === (near as { spot: number }).spot);
    if (!b || b.private || !b.code || b.seated >= b.max) return;
    void sitDown(b.code, (m) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; });
  }

  // ---- the shop stream: names, avatars, positions, emotes, booths, radio ----
  let es: EventSource;
  const parse = (e: MessageEvent) => JSON.parse(e.data);
  let retryMs = 2000, retryTimer = 0, gotSnapshot = false;
  const streamNote = $("shop-stream-note");
  // The stream refuses with a status when the floor is full; EventSource only says "error",
  // so ask once with fetch to find out why, and keep the 2D booth list up to date meanwhile.
  async function refreshBooths() {
    try {
      const r = await fetch("/api/shop/booths", { credentials: "same-origin" });
      if (r.ok) { booths = await r.json(); renderList(); scene?.setBooths(booths); }
    } catch { /* offline: keep the last list */ }
  }
  let pollTimer = 0;
  async function onStreamError() {
    es.close();
    clearTimeout(retryTimer);
    let full = false, said = "";
    try {
      const r = await fetch("/api/shop/events", { credentials: "same-origin", headers: { accept: "application/json" } });
      if (r.status === 503) {
        full = true;
        const d = (await r.json().catch(() => null)) as { error?: string; booths?: Booth[] } | null;
        said = d?.error ?? "";
        if (Array.isArray(d?.booths)) { booths = d!.booths; renderList(); scene?.setBooths(booths); }
      } else if (r.status === 401) { location.href = "/?next=/shop"; return; }
      else void r.body?.cancel();
    } catch { /* offline */ }
    // Full: nobody to walk among, so the 2D list comes first and the note sits right under the bar.
    if (full) { stage.hidden = true; details.open = true; }
    streamNote.hidden = false;
    streamNote.textContent = full
      ? (said || "The shop floor is full right now. The booth list below still works.")
      : "Lost the shop connection. The booth list below still works; trying again.";
    void refreshBooths();
    // Keep the 2D list fresh while the stream is out (it is the only live feed there is).
    clearInterval(pollTimer);
    pollTimer = window.setInterval(refreshBooths, 5000);
    retryTimer = window.setTimeout(connect, retryMs);
    retryMs = Math.min(retryMs * 2, 30000);
  }
  function connect() {
    es = new EventSource("/api/shop/events");
    es.addEventListener("error", () => { if (es.readyState === EventSource.CLOSED || !gotSnapshot) void onStreamError(); });
    wire(es);
  }
  function wire(es: EventSource) {
  es.addEventListener("snapshot", (e) => {
    if (gotSnapshot) { void loadWall(); void loadJuke(); } // back after a drop: catch up
    gotSnapshot = true; retryMs = 2000; streamNote.hidden = true; clearInterval(pollTimer); syncScene();
    const d = parse(e as MessageEvent);
    snapshot = d;
    roster.clear();
    for (const p of d.people) roster.set(p.name, p.name);
    renderPeople();
    booths = d.booths;
    renderList();
    radio.update(d.radio);
    if (d.jukebox) setJuke(d.jukebox);
    if (Array.isArray(d.wall)) setWallFirst({ sleeves: d.wall, more: d.wall.length >= 20 });
    else if (d.wall && Array.isArray(d.wall.sleeves)) setWallFirst(d.wall);
    scene?.setYou(d.you);
    scene?.reset(d.people);
    scene?.setBooths(booths);
  });
  es.addEventListener("moves", (e) => scene?.moves(parse(e as MessageEvent).people));
  es.addEventListener("joined", (e) => {
    const p = parse(e as MessageEvent);
    roster.set(p.name, p.name);
    renderPeople();
    scene?.add(p);
    snapshot?.people.push(p);
  });
  es.addEventListener("left", (e) => {
    const { name } = parse(e as MessageEvent);
    roster.delete(name);
    renderPeople();
    scene?.remove(name);
    if (snapshot) snapshot.people = snapshot.people.filter((p) => p.name !== name);
  });
  es.addEventListener("emote", (e) => { const d = parse(e as MessageEvent); scene?.emote(d.name, d.emote); });
  es.addEventListener("booths", (e) => { booths = parse(e as MessageEvent); renderList(); scene?.setBooths(booths); });
  es.addEventListener("radio", (e) => { radio.update(parse(e as MessageEvent), { changed: true }); if (!juke?.now) sfx.clunk(); });
  es.addEventListener("jukebox", (e) => setJuke(parse(e as MessageEvent)));
  es.addEventListener("wall", (e) => { const d = parse(e as MessageEvent); if (d?.sleeve) addSleeve(d.sleeve); });
  }
  connect();
  void loadWall();
  void loadJuke();
  addEventListener("online", () => { if (!gotSnapshot || es.readyState === EventSource.CLOSED) { retryMs = 2000; clearTimeout(retryTimer); connect(); } });

  addEventListener("pagehide", () => { clearTimeout(retryTimer); clearInterval(pollTimer); es.close(); radio.destroy(); sfx.destroy(); scene?.destroy(); });
  // A read-only peek for the browser checks.
  (window as unknown as { __shop: unknown }).__shop = { debug: () => scene?.debug() };
  paintSound();
  renderList();
  sceneInit();
</script>

<style is:global>
  /* The shop wears its own plum so the 3D HUD and the 2D list match each other
     whatever the rest of the site is doing. Values are the approved mockup's. */
  .shop {
    --s-wall: #1b1420; --s-panel: #261c2c; --s-raise: #34283c; --s-rule: #4a3b4e; --s-line: #85728c;
    --s-lamp: #f4b860; --s-neon: #ff4f8b; --s-sleeve: #efe7d7; --s-ink: #1b1420; --s-muted: #b9a9b8; --s-bad: #ff9a8b;
    --s-ui: "Bricolage Grotesque Variable", "Bricolage Grotesque", system-ui, sans-serif;
    --s-mono: "IBM Plex Mono", "JetBrains Mono Variable", ui-monospace, monospace;
    --s-sign: Bungee, "Arial Black", Impact, sans-serif;
    position: relative; left: 50%; width: 100vw; margin: 0 0 -3rem -50vw; padding: 0 0 3rem;
    background: var(--s-wall); color: var(--s-sleeve); font-family: var(--s-ui); min-height: 70vh;
  }
  .shop * { box-sizing: border-box; }
  .shop h2, .shop h3 { font-family: var(--s-ui); font-weight: 800; letter-spacing: 0; text-transform: none; color: var(--s-sleeve); margin: 0; }
  .shop p { margin: 0; }
  .shop a { color: var(--s-lamp); }
  .shop .shop-btn {
    font: 700 1rem/1.1 var(--s-ui); letter-spacing: 0; min-height: 44px; padding: 0.55rem 1.1rem; border: 1px solid transparent; border-radius: 999px;
    background: var(--s-lamp); color: var(--s-ink); cursor: pointer; box-shadow: none; text-transform: none; transform: none;
  }
  .shop .shop-btn:hover:not(:disabled) { filter: brightness(1.08); }
  .shop .shop-btn:active:not(:disabled) { transform: none; box-shadow: none; filter: brightness(0.95); }
  .shop .shop-btn.ghost, .shop button.secondary { background: transparent; color: var(--s-sleeve); border-color: var(--s-line); }
  .shop .shop-btn.ghost[aria-pressed="true"] { background: var(--s-raise); border-color: var(--s-lamp); color: var(--s-lamp); }
  .shop .shop-btn.sm, .shop button.sm { min-height: 44px; padding: 0.4rem 0.9rem; font-size: 0.9rem; }
  .shop button:disabled { background: var(--s-raise); color: var(--s-muted); border-color: transparent; cursor: not-allowed; box-shadow: none; }
  .shop button:focus-visible, .shop input:focus-visible, .shop select:focus-visible, .shop summary:focus-visible, .shop a:focus-visible { outline: 3px solid var(--s-lamp); outline-offset: 2px; }
  .shop input, .shop select {
    font: 500 1rem var(--s-mono); min-height: 44px; margin: 0; width: auto; padding: 0.4rem 0.7rem; border: 1px solid var(--s-line); border-radius: 10px; background: var(--s-wall); color: var(--s-sleeve);
  }
  .shop input[name="code"] { width: 7.5rem; text-transform: uppercase; letter-spacing: 0.2em; }
  .shop label { color: var(--s-muted); font-weight: 600; font-size: 0.875rem; margin: 0 0 0.25rem; }

  .shop-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding: 0.6rem 1rem; max-width: 72rem; margin: 0 auto; }
  .shop-count { font: 500 0.78rem var(--s-mono); color: var(--s-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .shop-count span { color: var(--s-lamp); }
  .shop-bar-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .shop-vol { display: flex; align-items: center; gap: 0.5rem; margin: 0; font-size: 0.8rem; }
  .shop-vol input { min-height: 0; width: 7rem; padding: 0; accent-color: var(--s-lamp); border: 0; background: none; }

  /* With the 3D on, the HUD shows the counts, so the bar keeps only its buttons. */
  .shop:has(.shop-stage:not([hidden])) .shop-count { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .shop:has(.shop-stage:not([hidden])) .shop-bar { justify-content: flex-end; }
