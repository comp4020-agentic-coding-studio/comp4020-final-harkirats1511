---
import Base from "../layouts/Base.astro";
import { personFromCookies } from "../lib/auth.ts";
import { booths } from "../lib/booths.ts";
import { boothList } from "../scene/shop-list.ts";
// Signed out goes to the front door, which brings you back here after sign-in.
const me = personFromCookies(Astro.cookies);
if (!me) return Astro.redirect("/?next=/shop");
// The first paint of the 2D list is server-rendered from the same public Booth
// fields the stream carries: a private booth has no code in it.
const list = booths();
---
<Base title="The shop · Mole" width="table">
  <div id="shop" class="shop" data-me={me.name}>
    <h1 class="sr-only">Mole Records, the shop floor</h1>
    <p class="sr-only" id="shop-live" role="status" aria-live="polite"></p>

    <div class="shop-bar">
      <p class="shop-count" id="shop-count"><span id="count-people">0</span> in the shop · <span id="count-booths">{list.length}</span> <span id="count-booths-word">{list.length === 1 ? "booth" : "booths"}</span></p>
      <div class="shop-bar-btns">
        <button type="button" id="scene-toggle" class="shop-btn ghost sm" aria-pressed="true" hidden>3D: on</button>
        <button type="button" id="sound-toggle" class="shop-btn ghost sm" aria-pressed="true">Sound: on</button>
        <label class="shop-vol"><span>Radio volume</span><input type="range" id="sound-vol" min="0" max="100" step="5" value="35"></label>
      </div>
    </div>

    <section id="shop-stage" class="shop-stage" aria-label="3D shop floor (decorative; everything here is also in the lists below)" hidden>
      <div class="shop-loading" id="shop-loading" aria-hidden="true"><div>Opening up<span>unlocking the shop</span></div></div>
      <div class="shop-hud" id="shop-hud">
        <div class="shop-brand" aria-hidden="true"><b>Mole Records</b><small><em id="hud-people">0</em> in the shop · <em id="hud-booths">0</em> booths</small></div>
        <div class="shop-hint" aria-hidden="true">WASD or click to walk · Space to jump · E to sit</div>
        <div class="shop-sheet" id="shop-sheet" role="region" aria-label="Nearby" hidden></div>
        <div class="shop-emotes" id="shop-emotes">
          <button type="button" data-e="wave">Wave</button>
          <button type="button" data-e="nope">Nope</button>
          <button type="button" data-e="jump">Jump</button>
          <button type="button" data-e="dance">Dance</button>
        </div>
        <div class="shop-stick" id="shop-stick" aria-hidden="true"><i></i></div>
        <div class="shop-hud-btns">
          <button type="button" id="hud-list" class="shop-btn ghost sm" aria-expanded="false" aria-controls="shop-2d">Booth list</button>
        </div>
      </div>
    </section>

    <details id="shop-2d" class="shop-2d" open>
      <summary id="shop-2d-sum">Booths, people and radio</summary>

      <section aria-labelledby="booths-h" class="shop-sec">
        <div class="shop-sec-head">
          <h2 id="booths-h">Booths</h2>
          <button type="button" id="quick-seat" class="shop-btn">Quick seat</button>
        </div>
        <p class="shop-msg" id="quick-msg" role="status"></p>
        <ul class="shop-booths" id="booth-list" set:html={boothList(list)} />
        <p class="shop-note"><a href="/">Start a table</a> from the home page and it opens as a booth here.</p>
      </section>

      <section aria-labelledby="people-h" class="shop-sec">
        <h2 id="people-h">In the shop</h2>
        <ul class="shop-people" id="people-list"><li>Connecting…</li></ul>
      </section>

      <section aria-labelledby="radio-h" class="shop-sec">
        <h2 id="radio-h">Radio</h2>
        <p id="radio-now" class="shop-note">The jukebox picks the station for the whole shop, once a minute.</p>
        <div class="shop-stations" id="stations" role="group" aria-label="Station">
          <button type="button" class="shop-btn ghost" data-mode="mix" aria-pressed="false">Mix</button>
          <button type="button" class="shop-btn ghost" data-mode="after-hours" aria-pressed="false">After Hours</button>
          <button type="button" class="shop-btn ghost" data-mode="back-room" aria-pressed="false">Back Room</button>
          <button type="button" class="shop-btn ghost" data-mode="late-bus" aria-pressed="false">Late Bus</button>
        </div>
        <p class="shop-msg" id="radio-msg" role="status"></p>
      </section>
    </details>
  </div>
</Base>

<script>
  import type { ShopScene, Target } from "../scene/shop-scene.ts";
  import type { Booth } from "../lib/booths.ts";
  import { createRadio, type RadioInfo } from "../audio/radio.ts";
  import { createSfx } from "../audio/sfx.ts";
  import { boothList, esc } from "../scene/shop-list.ts";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const shop = $("shop");
  const myName = shop.dataset.me!;
  const live = (t: string) => { $("shop-live").textContent = ""; setTimeout(() => ($("shop-live").textContent = t), 30); };

  // ---- sound: one control for the radio and the effects ----
  const sfx = createSfx();
  const radio = createRadio();
  const soundBtn = $<HTMLButtonElement>("sound-toggle");
  const vol = $<HTMLInputElement>("sound-vol");
  vol.value = String(Math.round(radio.state().volume * 100));
  sfx.setEnabled(radio.state().on);
  const paintSound = () => {
    const s = radio.state();
    soundBtn.textContent = `Sound: ${s.on ? "on" : "off"}`;
    soundBtn.setAttribute("aria-pressed", String(s.on));
    sfx.setEnabled(s.on);
    const name = s.stationName;
    $("radio-now").textContent = name ? `Now on the radio: ${name}.${s.on ? "" : " (Sound is off.)"}` : "The jukebox picks the station for the whole shop, once a minute.";
    const mode = s.mode;
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-mode]")) b.setAttribute("aria-pressed", String(b.dataset.mode === mode));
    sheetRefresh();
  };
  radio.subscribe(paintSound);
  soundBtn.addEventListener("click", () => {
    if (radio.state().on) radio.stop();
    else { sfx.unlock(); radio.start(); }
    paintSound();
  });
  vol.addEventListener("input", () => { radio.setVolume(Number(vol.value) / 100); });
  // Browsers play nothing before a tap or key press: the first one starts it.
  const firstGesture = () => {
    sfx.unlock();
    radio.gesture();
    removeEventListener("pointerdown", firstGesture, true);
    removeEventListener("keydown", firstGesture, true);
  };
  addEventListener("pointerdown", firstGesture, true);
  addEventListener("keydown", firstGesture, true);

  // ---- the 3D scene: loaded after the page is usable, only where it can run ----
  const SCENE_KEY = "mole:scene";
  const readScene = () => { try { return localStorage.getItem(SCENE_KEY) !== "off"; } catch { return true; } };
  const writeScene = (on: boolean) => { try { localStorage.setItem(SCENE_KEY, on ? "on" : "off"); } catch { /* not saved */ } };
  let sceneWanted = readScene();
  let scene: ShopScene | null = null;
  let sceneLoading = false;
  let sceneDead = false;
  let sceneVisible = true;
  let snapshot: { people: any[]; you: string } | null = null;
  const stage = $("shop-stage");
  const sceneBtn = $<HTMLButtonElement>("scene-toggle");
  const details = $<HTMLDetailsElement>("shop-2d");
  const canRunScene = () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2");
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch { return false; }
  };
  const syncScene = () => {
    sceneBtn.textContent = `3D: ${sceneWanted ? "on" : "off"}`;
    sceneBtn.setAttribute("aria-pressed", String(sceneWanted));
    stage.hidden = !sceneWanted;
    shop.classList.toggle("is-3d", sceneWanted && !sceneDead);
  };
  const syncPause = () => scene?.setPaused(document.hidden || !sceneVisible || !sceneWanted);
  function dropScene(fatal: boolean) {
    scene?.destroy();
    scene = null;
    sceneLoading = false;
    sheetClose();
    if (fatal) { sceneDead = true; stage.hidden = true; sceneBtn.hidden = true; details.open = true; }
    syncScene();
  }
  async function loadScene() {
    if (scene || sceneLoading || sceneDead || !sceneWanted) return;
    sceneLoading = true;
    $("shop-loading").classList.remove("done");
    try {
      const { startShopScene } = await import("../scene/shop-scene.ts");
      const s = await startShopScene(stage, {
        sendMove: (x, z, yaw) => void post("/api/shop/move", { x, z, yaw }).catch(() => {}),
        sendEmote: (e) => void post("/api/shop/emote", { emote: e }).catch(() => {}),
        onNear: (t) => { near = t; sheetRefresh(true); },
        onPrimary: () => primary(),
        sfx,
      }, () => $("shop-loading").classList.add("done"));
      if (!sceneWanted || sceneDead) { s.destroy(); sceneLoading = false; return; }
      scene = s;
      sceneLoading = false;
      s.setYou(myName);
      if (snapshot) { s.reset(snapshot.people); }
      s.setBooths(booths);
      syncPause();
      details.open = false;
    } catch (err) {
      // The 2D list is complete without it: drop the scene quietly (a note for whoever reads the console).
      console.debug("3D shop unavailable", err);
      dropScene(true);
    }
  }
  function sceneInit() {
    if (!canRunScene()) { sceneDead = true; syncScene(); return; }
    sceneBtn.hidden = false;
    syncScene();
    sceneBtn.addEventListener("click", () => {
      sceneWanted = !sceneWanted;
      writeScene(sceneWanted);
      if (sceneWanted) { syncScene(); void loadScene(); }
      else { dropScene(false); details.open = true; }
    });
    new IntersectionObserver((e) => { sceneVisible = e[e.length - 1].isIntersecting; syncPause(); }).observe(stage);
    document.addEventListener("visibilitychange", syncPause);
    // the booth-list toggle (sound stays in the bar above, one copy only)
    const listBtn = $<HTMLButtonElement>("hud-list");
    const sync = () => listBtn.setAttribute("aria-expanded", String(details.open));
    details.addEventListener("toggle", sync);
    listBtn.addEventListener("click", () => {
      details.open = !details.open;
      if (details.open) details.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    sync();
    // joystick (touch devices show it by CSS)
    const el = $("shop-stick"), knob = el.firstElementChild as HTMLElement;
    let id: number | null = null;
    const move = (e: PointerEvent) => {
      const r = el.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      let dx = e.clientX - cx, dy = e.clientY - cy;
      const d = Math.hypot(dx, dy), max = r.width / 2 - 10;
      if (d > max) { dx = (dx / d) * max; dy = (dy / d) * max; }
      knob.style.transform = `translate(${dx}px, ${dy}px)`;
      scene?.setStick(dx / max, dy / max);
    };
    el.addEventListener("pointerdown", (e) => { id = e.pointerId; el.setPointerCapture(id); move(e); });
    el.addEventListener("pointermove", (e) => { if (e.pointerId === id) move(e); });
    const end = () => { id = null; scene?.setStick(0, 0); knob.style.transform = ""; };
    el.addEventListener("pointerup", end);
    el.addEventListener("pointercancel", end);
    $("shop-emotes").addEventListener("click", (e) => {
      const c = (e.target as HTMLElement).closest("button")?.dataset.e;
      if (c) scene?.myEmote(c as never);
    });
    const go = () => void loadScene();
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1500 });
    else setTimeout(go, 400);
  }

  // ---- talking to the server ----
  async function post(url: string, body?: unknown) {
    return fetch(url, { method: "POST", headers: body === undefined ? {} : { "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body), credentials: "same-origin" });
  }
  const errorOf = async (res: Response, fallback: string) => ((await res.json().catch(() => null)) as { error?: string } | null)?.error ?? fallback;

  // ---- booths (the 2D list; the 3D draws the same data) ----
  let booths: Booth[] = [];
  const listEl = $("booth-list");
  let lastHtml = listEl.innerHTML;
  function renderList() {
    const html = boothList(booths);
    $("count-booths").textContent = String(booths.length);
    $("count-booths-word").textContent = booths.length === 1 ? "booth" : "booths";
    $("hud-booths").textContent = String(booths.length);
    if (html === lastHtml) return;
    lastHtml = html;
    // keep what someone is typing, which report form is open and any message
    const keep = new Map<string, { vals: Record<string, string>; open: boolean; msg: string }>();
    for (const li of listEl.querySelectorAll<HTMLElement>("li[data-key]")) {
      const vals: Record<string, string> = {};
      for (const f of li.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[name]")) vals[f.name] = f.value;
      keep.set(li.dataset.key!, { vals, open: !!li.querySelector("details")?.open, msg: li.querySelector(".shop-msg")?.textContent ?? "" });
    }
    const a = document.activeElement as HTMLElement | null;
    const focus = a && listEl.contains(a) ? { key: a.closest("li")?.getAttribute("data-key"), sel: a.getAttribute("data-act") ? `[data-act="${a.getAttribute("data-act")}"]` : a.getAttribute("name") ? `[name="${a.getAttribute("name")}"]` : a.tagName.toLowerCase() } : null;
    listEl.innerHTML = html;
    for (const li of listEl.querySelectorAll<HTMLElement>("li[data-key]")) {
      const k = keep.get(li.dataset.key!);
      if (!k) continue;
      for (const f of li.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[name]")) if (k.vals[f.name] !== undefined) f.value = k.vals[f.name];
      const d = li.querySelector("details");
      if (d) d.open = k.open;
      const m = li.querySelector(".shop-msg");
      if (m) m.textContent = k.msg;
    }
    if (focus?.key) listEl.querySelector<HTMLElement>(`li[data-key="${focus.key}"] ${focus.sel}`)?.focus();
    sheetRefresh();
  }
  const boothByCode = (code: string) => booths.find((b) => b.code === code);

  // ---- taking a seat ----
  let leaving = false;
  const go = (code: string) => { location.href = `/t/${code}`; };
  async function sitDown(code: string, say: (m: string) => void): Promise<boolean> {
    if (leaving) return false;
    sfx.click();
    say("Taking a seat…");
    const res = await post(`/api/tables/${code}/join`);
    if (!res.ok) { say(await errorOf(res, "Could not sit there.")); return false; }
    leaving = true;
    say(`Sitting at ${code}…`);
    const b = boothByCode(code);
    if (scene && b && b.spot >= 0) {
      // Watch yourself sit down, but never wait more than a few seconds for it
      // (a slow phone walks slowly): the game is on the table page.
      const ok = await Promise.race([scene.sitAt(b.spot), new Promise<boolean>((r) => setTimeout(() => r(false), 3500))]);
      setTimeout(() => go(code), ok ? 900 : 0);
    } else go(code);
    return true;
  }
  async function reportBooth(code: string, reason: string, say: (m: string) => void) {
    const res = await post(`/api/tables/${code}/report`, { reason });
    say(res.ok ? "Reported, thanks" : res.status === 409 ? "Already reported" : await errorOf(res, "Could not send the report."));
  }
  async function knock(code: string, say: (m: string) => void) {
    code = code.trim().toUpperCase();
    if (!/^[A-Z]{4}$/.test(code)) return say("A code is four letters.");
    sfx.click();
    const res = await post(`/api/tables/${code}/join`);
    if (res.ok) { leaving = true; say("Opening the door…"); go(code); }
    else say(res.status === 404 ? "No booth with that code." : await errorOf(res, "That code didn't work."));
  }

  listEl.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-act]");
    if (!btn) return;
    const li = btn.closest("li")!;
    const msg = li.querySelector(".shop-msg")!;
    if (btn.dataset.act === "sit") void sitDown(btn.dataset.code!, (m) => (msg.textContent = m));
  });
  listEl.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msg = form.closest("li")!.querySelector(".shop-msg")!;
    const say = (m: string) => (msg.textContent = m);
    if (form.dataset.form === "knock") void knock((form.elements.namedItem("code") as HTMLInputElement).value, say);
    else if (form.dataset.form === "report") void reportBooth(form.dataset.code!, (form.elements.namedItem("reason") as HTMLSelectElement).value, say);
  });

  $("quick-seat").addEventListener("click", async () => {
    const msg = $("quick-msg");
    sfx.click();
    msg.textContent = "Looking for a booth…";
    const res = await post("/api/shop/quick-seat");
    if (res.status === 404) {
      msg.innerHTML = `No open booths waiting right now. <a href="/">Start one</a>.`;
      return;
    }
    if (!res.ok) { msg.textContent = await errorOf(res, "Could not find a seat."); return; }
    const { code } = (await res.json()) as { code: string };
    leaving = true;
    msg.textContent = `Sitting at ${code}…`;
    const b = boothByCode(code);
    if (scene && b && b.spot >= 0) {
      // Watch yourself sit down, but never wait more than a few seconds for it
      // (a slow phone walks slowly): the game is on the table page.
      const ok = await Promise.race([scene.sitAt(b.spot), new Promise<boolean>((r) => setTimeout(() => r(false), 3500))]);
      setTimeout(() => go(code), ok ? 900 : 0);
    } else go(code);
  });

  // ---- people ----
  const roster = new Map<string, string>();
  function renderPeople() {
    const names = [...roster.keys()].sort((a, b) => (a === myName ? -1 : b === myName ? 1 : a.localeCompare(b)));
    $("count-people").textContent = $("hud-people").textContent = String(names.length);
    $("people-list").innerHTML = names.length ? names.map((n) => `<li>${esc(n)}${n === myName ? " (you)" : ""}</li>`).join("") : "<li>Nobody yet.</li>";
  }

  // ---- the jukebox ----
  const STATIONS = [["mix", "Mix"], ["after-hours", "After Hours"], ["back-room", "Back Room"], ["late-bus", "Late Bus"]] as const;
  async function setStation(mode: string, say: (m: string) => void) {
    sfx.click();
    const res = await post("/api/shop/radio", { mode });
    if (res.status === 429) {
      const b = (await res.json().catch(() => ({}))) as { retryAfter?: number };
      return say(`The jukebox was just used. Try again in ${b.retryAfter ?? 60} seconds.`);
    }
    if (!res.ok) return say(await errorOf(res, "The jukebox didn't take that."));
    say("");
    const r = (await res.json()) as RadioInfo;
    radio.update(r, { changed: true });
    sfx.clunk();
  }
  $("stations").addEventListener("click", (e) => {
    const m = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-mode]")?.dataset.mode;
    if (m) void setStation(m, (t) => ($("radio-msg").textContent = t));
  });

  // ---- the 3D bottom sheet: the booth or jukebox you are standing at ----
  const sheet = $("shop-sheet");
  let near: Target = null;
  let sheetKey = "";
  function sheetClose() { near = null; sheetKey = ""; sheet.hidden = true; sheet.classList.remove("on"); }
  function sheetRefresh(force = false) {
    let key = "", html = "";
    if (near?.kind === "booth") {
      const b = booths.find((x) => x.spot === (near as { spot: number }).spot);
      if (b) {
        const full = b.seated >= b.max;
        const status = b.status === "playing" ? "A game is on; you would join the next one." : "Not started yet.";
        if (b.private || !b.code) {
          key = `p-${b.spot}-${b.seated}-${b.status}`;
          html = `<div class="row"><h2>Private booth · ${esc(b.host)}</h2><span class="shop-pill dim">Code only</span></div>
            <p>${esc(b.host)} is playing with friends. If they gave you the code, type it in.</p>
            <form class="row" data-s="knock" novalidate><label class="sr-only" for="sheet-code">Booth code</label><input id="sheet-code" name="code" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="CODE"><button type="submit" class="shop-btn ghost">Knock</button></form>
            <p class="shop-msg" role="status"></p>`;
        } else {
          key = `o-${b.code}-${b.seated}-${b.status}`;
          html = `<div class="row"><h2>Booth ${esc(b.code)}</h2><span class="shop-pill">${b.status === "playing" ? "Playing" : "Open to anyone"}</span></div>
            <p>${esc(b.host)}'s table. ${b.seated} of ${b.max} seats taken. ${status}</p>
            <div class="row"><button type="button" class="shop-btn" data-s="sit" data-code="${b.code}"${full || leaving ? " disabled" : ""}>Take a seat</button>
            <details class="shop-report"><summary>Report</summary><form data-s="report" data-code="${b.code}" novalidate><label class="sr-only" for="sheet-why">Reason</label><select id="sheet-why" name="reason">${["rude names", "spam", "trolling the game", "something else"].map((r) => `<option>${r}</option>`).join("")}</select><button type="submit" class="shop-btn ghost sm">Send</button></form></details></div>
            <p class="shop-msg" role="status"></p>`;
        }
      }
    } else if (near?.kind === "jukebox") {
      const s = radio.state();
      key = `j-${s.mode}-${s.stationName}`;
      html = `<div class="row"><h2>Jukebox</h2><span class="shop-pill">${esc(s.stationName || "Radio")}</span></div>
        <p>Pick the station for everyone in the shop. It can change once a minute.</p>
        <div class="stations">${STATIONS.map(([m, n]) => `<button type="button" class="shop-btn ghost sm" data-s="station" data-mode="${m}" aria-pressed="${s.mode === m}">${n}</button>`).join("")}</div>
        <p class="shop-msg" role="status"></p>`;
    }
    if (key === sheetKey && !force) return;
    if (key === sheetKey && sheet.contains(document.activeElement)) return;
    sheetKey = key;
    const code = (sheet.querySelector<HTMLInputElement>("input[name=code]")?.value) ?? "";
    sheet.innerHTML = html;
    const input = sheet.querySelector<HTMLInputElement>("input[name=code]");
    if (input) input.value = code;
    sheet.hidden = !html;
    sheet.classList.toggle("on", !!html);
    stage.classList.toggle("has-sheet", !!html);
  }
  sheet.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-s]");
    const say = (m: string) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; };
    if (t?.dataset.s === "sit") void sitDown(t.dataset.code!, say);
    else if (t?.dataset.s === "station") void setStation(t.dataset.mode!, say);
  });
  sheet.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const say = (m: string) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; };
    if (form.dataset.s === "knock") void knock((form.elements.namedItem("code") as HTMLInputElement).value, say);
    else if (form.dataset.s === "report") void reportBooth(form.dataset.code!, (form.elements.namedItem("reason") as HTMLSelectElement).value, say);
  });
  // E: take the open seat at the booth you are standing at
  function primary() {
    if (near?.kind !== "booth" || leaving) return;
    const b = booths.find((x) => x.spot === (near as { spot: number }).spot);
    if (!b || b.private || !b.code || b.seated >= b.max) return;
    void sitDown(b.code, (m) => { const el = sheet.querySelector(".shop-msg"); if (el) el.textContent = m; });
  }

  // ---- the shop stream: names, avatars, positions, emotes, booths, radio ----
  const es = new EventSource("/api/shop/events");
  const parse = (e: MessageEvent) => JSON.parse(e.data);
  es.addEventListener("snapshot", (e) => {
    const d = parse(e as MessageEvent);
    snapshot = d;
    roster.clear();
    for (const p of d.people) roster.set(p.name, p.name);
    renderPeople();
    booths = d.booths;
    renderList();
    radio.update(d.radio);
    scene?.setYou(d.you);
    scene?.reset(d.people);
    scene?.setBooths(booths);
  });
  es.addEventListener("moves", (e) => scene?.moves(parse(e as MessageEvent).people));
  es.addEventListener("joined", (e) => {
    const p = parse(e as MessageEvent);
    roster.set(p.name, p.name);
    renderPeople();
    scene?.add(p);
    snapshot?.people.push(p);
  });
  es.addEventListener("left", (e) => {
    const { name } = parse(e as MessageEvent);
    roster.delete(name);
    renderPeople();
    scene?.remove(name);
    if (snapshot) snapshot.people = snapshot.people.filter((p) => p.name !== name);
  });
  es.addEventListener("emote", (e) => { const d = parse(e as MessageEvent); scene?.emote(d.name, d.emote); });
  es.addEventListener("booths", (e) => { booths = parse(e as MessageEvent); renderList(); scene?.setBooths(booths); });
  es.addEventListener("radio", (e) => { radio.update(parse(e as MessageEvent), { changed: true }); sfx.clunk(); });

  addEventListener("pagehide", () => { es.close(); radio.destroy(); sfx.destroy(); scene?.destroy(); });
  // A read-only peek for the browser checks.
  (window as unknown as { __shop: unknown }).__shop = { debug: () => scene?.debug() };
  paintSound();
  renderList();
  sceneInit();
</script>

