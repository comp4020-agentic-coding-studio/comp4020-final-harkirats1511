---
import Base from "../layouts/Base.astro";
import { personFromCookies } from "../lib/auth.ts";
import { listTaste, MIN_CRATE } from "../lib/taste.ts";
import { getAvatar } from "../lib/avatars.ts";
const me = personFromCookies(Astro.cookies);
const next = Astro.url.searchParams.get("next") ?? "";
const safeNext = /^(\/t\/[A-Za-z]{4}|\/taste|\/me|\/shop)$/.test(next) ? next : "";
if (me && safeNext) return Astro.redirect(safeNext);
const mine = me ? getAvatar(me.id) : null;
const tasteCount = me ? listTaste(me.id).length : 0;
---
<Base title="Mole Records" width="home">
  <div class="home">
    <div class="home-side">
      <h1 class="sign"><span class="sr-only">Mole Records</span><span class="big" aria-hidden="true">M<span class="disc-o"></span>LE</span><span class="small" aria-hidden="true">RECORDS</span></h1>
      <p class="hours">Open late <b>tonight</b><br />A party game for friends in one room</p>
      <p class="pitch">Everyone picks a song. One of you got a slightly different theme.</p>
      <p class="enter-shop"><a class="btn ghost" href="/shop">Enter the shop</a></p>
    </div>
    <div class="home-main">
  {me ? (
    <>
      <p class="who"><span id="who-badge" class="avatar" aria-hidden="true" data-avatar={JSON.stringify(mine)}></span><span>Signed in as <strong>{me.name}</strong>.</span></p>
      <section class="card" aria-labelledby="create-h">
        <h2 id="create-h">Start a table</h2>
        <p class="hint">You get a code to share with the room.</p>
        <fieldset class="who-sits">
          <legend>Who can sit down?</legend>
          <div class="check">
            <input type="radio" name="visibility" id="vis-public" value="public" checked aria-describedby="vis-hint" />
            <label for="vis-public">Anyone in the shop</label>
          </div>
          <div class="check">
            <input type="radio" name="visibility" id="vis-private" value="private" aria-describedby="vis-hint" />
            <label for="vis-private">Only people with the code</label>
          </div>
          <p class="hint" id="vis-hint">A public booth is lit up on the shop floor, so anyone walking by can take a seat. A private booth only shows who hosts it.</p>
        </fieldset>
        <div class="check">
          <input type="checkbox" id="autoplay" checked aria-describedby="autoplay-hint" />
          <label for="autoplay">Play the tracks automatically</label>
        </div>
        <p class="hint" id="autoplay-hint">Each track plays for <span id="autoplay-n">30</span> seconds, then voting opens. The host can still pick a track.</p>
        <div id="slot-wrap">
          <label for="slot-s">Seconds per track</label>
          <select id="slot-s">
            <option value="15">15 seconds</option>
            <option value="30" selected>30 seconds</option>
          </select>
        </div>
        <details class="options">
          <summary>Table options</summary>
          <label for="pick-s">Time to pick a song</label>
          <select id="pick-s">
            <option value="30">30 seconds</option>
            <option value="60" selected>60 seconds</option>
            <option value="90">90 seconds</option>
          </select>
          <label for="vote-s">Time to vote</label>
          <select id="vote-s">
            <option value="30">30 seconds</option>
            <option value="45" selected>45 seconds</option>
            <option value="60">60 seconds</option>
          </select>
          <label for="moles">Moles</label>
          <select id="moles" aria-describedby="moles-hint">
            <option value="" selected>Auto (1 up to 5 players, 2 up to 10)</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
          <p class="hint" id="moles-hint">Moles must stay fewer than everyone else: 2 need 5 players, 3 need 7, 4 need 9. Start tells you if the table is too small.</p>
        </details>
        <button id="create" type="button" class="full">Start a table</button>
      </section>
      <section class="card" aria-labelledby="join-h">
        <h2 id="join-h">Join with a code</h2>
        <form id="join-code">
          <label for="code">Table code</label>
          <input id="code" name="code" class="mono-input" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false" required />
          <button type="submit">Join</button>
        </form>
      </section>
      <p id="msg" class="error" role="alert"></p>
      <div class="shelf-links">
        <section class="card" aria-labelledby="taste-h">
          <h2 id="taste-h">Your crate</h2>
          <p class="hint">{tasteCount} / {MIN_CRATE} needed to play. Up to 10 tracks.</p>
          {tasteCount < MIN_CRATE && <p class="nudge">You pick every song from your crate, so you need {MIN_CRATE} tracks to play. Add a few you would actually play.</p>}
          <p><a href="/taste">{tasteCount === 0 ? "Build your taste file" : "Edit your taste file"}</a></p>
        </section>
        <section class="card" aria-labelledby="hist-h">
          <h2 id="hist-h">Your shelf</h2>
          <p class="hint">Themes, picks and who won.</p>
          <p><a href="/history">Your past games</a></p>
        </section>
        <section class="card" aria-labelledby="char-h">
          <h2 id="char-h">Your character</h2>
          <p class="hint">Pick how you look at the table.</p>
          <p><a href="/me">Change your character</a></p>
        </section>
      </div>
    </>
  ) : (
    <form id="sign-in" class="card paper member-card" data-next={safeNext} aria-labelledby="member-h">
      <div class="card-top">
        <h2 id="member-h">Membership card</h2>
        <span class="card-no" aria-hidden="true">Members only</span>
      </div>
      <div class="stripe" aria-hidden="true"></div>
      <label for="name">Name</label>
      <input id="name" name="name" maxlength="24" autocomplete="username" required />
      <label for="pin">PIN (4 to 8 digits)</label>
      <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" autocomplete="current-password" required />
      <p class="hint">New name? It is yours with this PIN. Taken? Enter its PIN to sign back in.</p>
      <p id="msg" class="error" role="alert"></p>
      <button type="submit">Step inside</button>
    </form>
  )}
  <p class="hint"><a href="/readme/">About this project</a></p>
    </div>
  </div>
</Base>
<script>
  import { avatar } from "../ui/avatar.ts";
  const badge = document.getElementById("who-badge");
  if (badge) badge.replaceWith(avatar("", JSON.parse(badge.dataset.avatar!)));
  const msg = document.getElementById("msg");
  const say = (t: string) => { if (msg) msg.textContent = t; };
  async function post(url: string, body: unknown) {
    const res = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    return { res, data: (await res.json().catch(() => ({}))) as Record<string, string> };
  }

  document.getElementById("sign-in")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const { res, data } = await post("/api/join", {
      name: (form.elements.namedItem("name") as HTMLInputElement).value,
      pin: (form.elements.namedItem("pin") as HTMLInputElement).value,
    });
    if (!res.ok) return say(data.error ?? "Could not sign in.");
    location.href = form.dataset.next || "/";
  });

  const auto = document.getElementById("autoplay") as HTMLInputElement;
  const slotSel = document.getElementById("slot-s") as HTMLSelectElement;
  const syncAuto = () => {
    document.getElementById("slot-wrap")!.hidden = !auto.checked;
    document.getElementById("autoplay-n")!.textContent = slotSel.value;
  };
  auto?.addEventListener("change", syncAuto);
  slotSel?.addEventListener("change", syncAuto);
  if (auto) syncAuto();

  document.getElementById("create")?.addEventListener("click", async () => {
    const value = (id: string) => (document.getElementById(id) as HTMLSelectElement).value;
    const { res, data } = await post("/api/tables", {
      pickSeconds: Number(value("pick-s")),
      voteSeconds: Number(value("vote-s")),
      moles: value("moles") ? Number(value("moles")) : null,
      autoplay: auto.checked,
      slotSeconds: Number(value("slot-s")),
      private: (document.getElementById("vis-private") as HTMLInputElement).checked,
    });
    if (!res.ok) return say(data.error ?? "Could not create a table.");
    location.href = `/t/${data.code}`;
  });

  document.getElementById("join-code")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const code = (document.getElementById("code") as HTMLInputElement).value.trim().toUpperCase();
    const { res, data } = await post(`/api/tables/${encodeURIComponent(code)}/join`, {});
    if (!res.ok) return say(data.error ?? "Could not join that table.");
    location.href = `/t/${code}`;
  });
</script>
