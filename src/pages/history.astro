---
import Base from "../layouts/Base.astro";
import { personFromCookies } from "../lib/auth.ts";
import { historyFor } from "../lib/tables.ts";
import { pointsResult } from "../lib/history.ts";
import { SLOT_HINTS, SLOT_NAMES } from "../lib/prompts.ts";
const me = personFromCookies(Astro.cookies);
if (!me) return Astro.redirect("/?next=/history");
const games = historyFor(me.id).map((g) => ({ ...g, result: g.winner === "points" ? pointsResult(g.code, g.finishedAt) : null }));
---
<Base title="Your past games · Mole">
  <a class="back-link" href="/"><span aria-hidden="true">&larr;</span>Back</a>
  <p class="kicker">Your shelf</p>
  <h1>Your past games</h1>
  <section class="card paper notes" id="taste-notes" aria-labelledby="notes-h">
    <p class="kicker notes-k">Staff notes on you</p>
    <h2 id="notes-h">Taste notes</h2>
    <div id="notes-body" aria-busy="true"><p class="hint">Reading your shelf…</p></div>
  </section>
  {games.length === 0 ? (
    <section class="card empty-card">
      <p><strong>No finished games yet.</strong> Start a table and play one.</p>
      <p><a href="/">Start a table</a></p>
    </section>
  ) : (
    <>
      <p class="hint">Newest first. Every round's prompt is shown, because the games are over.</p>
      {games.map((g) => (
        <section class="card paper hist-game" aria-label={`Game ${g.code}`}>
          <div class="hist-head">
            <div>
              <p class="hist-code">BOOTH {g.code}</p>
              <p class="hist-meta"><time datetime={new Date(g.finishedAt).toISOString()} data-ts={g.finishedAt}>{new Date(g.finishedAt).toISOString().slice(0, 10)}</time></p>
            </div>
            <span class={`stamp ${g.winner === "moles" ? "moles" : "win"}`}>{g.winner === "moles" ? "Moles won" : g.winner === "none" ? "No winner" : g.winner === "points" ? ((g.result?.winners.length ?? 0) > 1 ? "Joint winners" : "Winner") : "Players won"}</span>
          </div>
          <p class="hist-players"><strong>Players:</strong> {g.players.join(", ")}{g.bots ? ` (and ${g.bots} bot${g.bots === 1 ? "" : "s"})` : ""}</p>
          {g.winner === "points" && g.result && (
            <>
              <p class="hist-ending">{g.result.winners.length > 1 ? "Joint winners" : "Winner"}: {g.result.winners.join(", ")}</p>
              <p class="hist-scores mono">{g.result.scores.map((x) => `${x.name} ${x.score}`).join(" \u00b7 ")}</p>
            </>
          )}
          {g.winner === "none" && (
            <p class="hist-ending">{g.ending === "nobody-picked" ? "Game abandoned: nobody picked." : "This game was left unfinished and ended with no winner."}</p>
          )}
          {g.winner === "moles" && g.ending === "final-vote" && <p class="hist-ending">Nobody was voted out with three left, so the moles won.</p>}
          {g.winner === "moles" && g.ending === "round-cap" && <p class="hist-ending">The moles were still in after round 12, so they won.</p>}
          <ol class="hist-rounds">
            {g.rounds.map((r) => {
              const m = g.mine.find((x) => x.round === r.round);
              return (
                <li>
                  {r.prompt !== undefined ? (
                    <p class="pressed">The prompt{r.slot ? ` (${SLOT_NAMES[r.slot]}: ${SLOT_HINTS[r.slot]})` : ""} <span class="hand">{r.prompt}</span></p>
                  ) : (
                    <p class="pressed">Most of you were pressed for <span class="hand">{r.majority}</span> The mole's copy said <span class="hand odd">{r.mole}</span></p>
                  )}
                  {m ? (
                    <>
                      {r.prompt !== undefined ? (
                        m.wasMole && <p class="mine"><span class="stamp moles">{g.winner === "points" ? "You were the mole this round" : "You were the mole"}</span></p>
                      ) : (
                        <p class="mine">
                          <span>Your card said <strong>{m.theme}</strong></span>
                          {m.wasMole && m.theme === r.mole && <span class="stamp moles">You were the mole</span>}
                        </p>
                      )}
                      <p class="pick">Your pick: <strong>{m.title}</strong>, {m.artist}{m.lender ? ` (borrowed from ${m.lender})` : ""}</p>
                    </>
                  ) : (
                    <p class="pick">You did not pick this round.</p>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </>
  )}
</Base>
<style>
  .notes { padding: 1rem 1.1rem 1.1rem; margin-bottom: 1.75rem; transform: rotate(-0.3deg); }
  .notes h2 { margin: 0 0 0.6rem; }
  .notes-k { margin: 0 0 0.2rem; }
  .notes :global(h3) { color: var(--ink-2); margin: 1rem 0 0.4rem; }
  .notes :global(.notes-moods) { display: grid; gap: 0.6rem 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); margin: 0; }
  .notes :global(.notes-mood) { margin: 0; }
  .notes :global(.notes-mood dt) { font: 600 0.75rem/1.2 var(--cat); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); border-bottom: 2px solid var(--ink); padding-bottom: 0.2rem; margin-bottom: 0.3rem; }
  .notes :global(.notes-mood dt span) { color: var(--ink-2); letter-spacing: 0.04em; text-transform: none; font-weight: 500; }
  .notes :global(.notes-mood dd) { margin: 0; font-size: var(--step--1); color: var(--ink-2); overflow-wrap: anywhere; padding: 0.15rem 0; }
  .notes :global(.notes-mood dd b), .notes :global(.notes-list b), .notes :global(.notes-loved b) { color: var(--ink); }
  .notes :global(.notes-loved) { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem; overflow-wrap: anywhere; }
  .notes :global(.notes-loved .stamp) { color: var(--ink); }
  .notes :global(.notes-list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; font-size: var(--step--1); color: var(--ink-2); }
  .notes :global(.notes-list li) { overflow-wrap: anywhere; border-bottom: 1px solid rgba(27, 20, 32, 0.18); padding: 0.2rem 0; }
  .notes :global(.notes-list li:last-child) { border-bottom: 0; }
  .notes :global(.hand) { font: 600 1.35rem/1.1 var(--hand); color: var(--ink); }
  .notes :global(.notes-empty) { margin: 0; color: var(--ink-2); }
</style>
<script>
  type T = { trackId: number; title: string; artist: string; cover?: string };
  type Mood = "up" | "down" | "out" | "in";
  type TasteNotes = {
    byMood: Record<Mood, T[]>;
    mostLoved?: T & { votes: number };
    shared: { with: string; track: T }[];
    borrows: { from?: string; to?: string; track: T }[];
  };
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const song = (t: T) => `<b>${esc(t.title)}</b>, ${esc(t.artist)}`;
  const MOODS: [Mood, string, string][] = [["up", "Up", "energy, hype"], ["down", "Down", "sad, slow"], ["out", "Out", "going out, social"], ["in", "In", "alone, cosy"]];
  // Short, like a staff note on a shelf card. Only what your games revealed.
  function renderNotes(n: TasteNotes): string {
    const by = n.byMood ?? { up: [], down: [], out: [], in: [] };
    const any = MOODS.some(([m]) => (by[m] ?? []).length) || n.mostLoved || n.shared?.length || n.borrows?.length;
    if (!any) return `<p class="notes-empty">Nothing on your card yet. Play a game and the shop starts taking notes: what you reach for in each mood, the song the room loved, and who you borrowed from.</p>`;
    const out: string[] = [];
    out.push(`<h3>What you reach for</h3><dl class="notes-moods">${MOODS.map(([m, name, hint]) => {
      const list = by[m] ?? [];
      return `<div class="notes-mood"><dt>${name} <span>${hint}</span></dt>${list.length ? list.slice(0, 5).map((t) => `<dd>${song(t)}</dd>`).join("") + (list.length > 5 ? `<dd>and ${list.length - 5} more</dd>` : "") : "<dd>Nothing yet.</dd>"}</div>`;
    }).join("")}</dl>`);
    out.push(`<h3>Most loved</h3>`);
    out.push(n.mostLoved
      ? `<p class="notes-loved"><span>${song(n.mostLoved)}</span><span class="stamp">${n.mostLoved.votes} best-pick ${n.mostLoved.votes === 1 ? "vote" : "votes"}</span></p>`
      : `<p class="notes-empty">No best-pick votes yet. Four rounds games hand them out.</p>`);
    out.push(`<h3>Songs you share</h3>`);
    // One line per song, naming everyone who played it too (the API gives one row per person and song).
    const bySong = new Map<number, { track: (typeof n.shared)[number]["track"]; with: string[] }>();
    for (const x of n.shared ?? []) {
      const e = bySong.get(x.track.trackId) ?? { track: x.track, with: [] };
      if (!e.with.includes(x.with)) e.with.push(x.with);
      bySong.set(x.track.trackId, e);
    }
    const names = (w: string[]) => w.map((x) => `<b>${esc(x)}</b>`).join(w.length > 2 ? ", " : " and ").replace(/, (<b>[^<]*<\/b>)$/, " and $1");
    out.push(bySong.size
      ? `<ul class="notes-list">${[...bySong.values()].map((e) => `<li>You and ${names(e.with)} ${e.with.length > 1 ? "all" : "both"} played ${song(e.track)}</li>`).join("")}</ul>`
      : `<p class="notes-empty">Nobody has picked one of your songs alongside you yet.</p>`);
    out.push(`<h3>Borrowed</h3>`);
    out.push(n.borrows?.length
      ? `<ul class="notes-list">${n.borrows.map((x) => `<li>${x.from ? `You borrowed ${song(x.track)} from <b>${esc(x.from)}</b>` : x.to ? `<b>${esc(x.to)}</b> borrowed ${song(x.track)} from you` : song(x.track)}</li>`).join("")}</ul>`
      : `<p class="notes-empty">No borrows either way yet.</p>`);
    return out.join("");
  }
  // Taste notes, from the games you sat in (GET /api/me/taste).
  const body = document.getElementById("notes-body")!;
  fetch("/api/me/taste", { credentials: "same-origin" })
    .then(async (r) => {
      if (!r.ok) throw new Error(String(r.status));
      body.innerHTML = renderNotes((await r.json()) as TasteNotes);
    })
    .catch(() => { body.innerHTML = `<p class="hint">Your taste notes didn't load just now. Reload the page to try again.</p>`; })
    .finally(() => body.removeAttribute("aria-busy"));
  // Dates in the reader's own time zone.
  for (const t of document.querySelectorAll<HTMLTimeElement>("time[data-ts]")) {
    t.textContent = new Date(Number(t.dataset.ts)).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
  }
</script>
