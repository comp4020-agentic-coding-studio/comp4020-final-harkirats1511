---
import Base from "../layouts/Base.astro";
import { personFromCookies } from "../lib/auth.ts";
import { crateLocked, listTaste, lockedTable, PER_SLOT, TASTE_MAX } from "../lib/taste.ts";
import { SLOTS, SLOT_HINTS, SLOT_NAMES } from "../lib/prompts.ts";
const me = personFromCookies(Astro.cookies);
if (!me) return Astro.redirect("/?next=/taste");
// Back to the table we came from; the same shape index.astro accepts for ?next.
const next = Astro.url.searchParams.get("next") ?? "";
const back = /^\/t\/[A-Za-z]{4}$/.test(next) ? next : "";
const welcome = Astro.url.searchParams.has("welcome");
const initial = listTaste(me.id);
const locked = crateLocked(me.id);
// The table this person is locked into, if any: the banner links there when ?next did not.
const activeTable = lockedTable(me.id);
const slots = SLOTS.map((s) => ({ slot: s, name: SLOT_NAMES[s], hint: SLOT_HINTS[s] }));
---
<Base title="Your crate · Mole" width="table">
  <a class="back-link" href={back || "/"}><span aria-hidden="true">&larr;</span>{back ? "Back to the table" : "Back"}</a>
  <p class="kicker">Mole Records</p>
  <h1>Your crate</h1>
  {welcome
    ? <p class="hint welcome">Build a crate of 12 songs, 3 for each mood. It's what you play from.</p>
    : <p class="hint">12 songs you would actually play: 3 in each of four moods. Every pick you make comes from here, and the table sees it all.</p>}

  <section class="progress sticky-progress" id="progress" tabindex="-1" aria-label="Crate progress">
    <p class="line"><span class="count mono" id="count" aria-live="off"></span><span class="need" id="need"></span></p>
    <button type="button" id="keep-all" class="sm" hidden>Keep all suggestions</button>
    <div class="done" id="done" hidden>
      <p><strong>Complete: you can play.</strong></p>
      {back ? <a class="btn big" href={back}>Back to the table</a> : <a class="btn ghost" href="/">Back home</a>}
    </div>
  </section>

  <div class="locked" id="locked" role="status" hidden>
    <strong>Your crate is locked until the game ends.</strong>
    <a id="locked-link" href={back || "/"}>{back ? "Back to the table" : "Back"}</a>
  </div>

  <p id="msg" class="error" role="alert"></p>

  <section class="card sortold" id="unsorted" aria-labelledby="unsorted-h" hidden>
    <h2 id="unsorted-h"><span id="unsorted-n">0</span> songs from before moods. Sort them:</h2>
    <p class="hint">Each has a suggested mood, picked from its title and tempo. Tap Sort to accept it, or choose another mood first.</p>
    <button type="button" id="sort-all" class="secondary">Sort all as suggested</button>
    <p class="hint" id="sort-note" role="status"></p>
    <ul class="bin plain" id="unsorted-bin"></ul>
  </section>

  <section class="card" aria-labelledby="find-h">
    <h2 id="find-h">Find a song</h2>
    <p class="adding" id="adding" hidden><span>Adding to: <strong id="adding-name"></strong></span> <button type="button" class="secondary sm" id="adding-cancel">Cancel</button></p>
    <form id="search" role="search">
      <label for="q">Search songs or artists</label>
      <input id="q" name="q" type="search" autocomplete="off" required />
      <button type="submit">Search</button>
    </form>
    <p class="hint" id="status" role="status"></p>
    <ul class="results" id="results"></ul>
  </section>

  <section class="card starter" id="starter" aria-labelledby="starter-h" hidden>
    <h2 id="starter-h">Start from artists you love</h2>
    <p class="hint">Type 1 to 3 artists, separated by commas. We suggest songs from them and artists like them in each mood. Nothing is added until you tap Keep.</p>
    <form id="starter-form">
      <label for="artists">Your artists</label>
      <input id="artists" name="artists" type="text" autocomplete="off" maxlength="150" placeholder="e.g. Fleetwood Mac, Daft Punk" required />
      <button type="submit" id="starter-go">Suggest songs</button>
    </form>
    <p class="hint" id="starter-status" role="status"></p>
  </section>

  <div class="dividers" id="dividers">
    {slots.map((s) => (
      <section class="slot" id={`slot-${s.slot}`} data-slot={s.slot} aria-labelledby={`slot-${s.slot}-h`}>
        <div class="tab"><h2 id={`slot-${s.slot}-h`}>{s.name}</h2><span class="tab-hint">{s.hint}</span><span class="tab-n mono" data-n></span></div>
        <ul class="bin" data-bin></ul>
        <p class="hint slot-note" data-note role="status"></p>
      </section>
    ))}
  </div>
  <audio id="player" hidden></audio>
</Base>
<style is:global>
  h1 { margin: 0.2rem 0 0.4rem; }
  .locked { background: var(--wall-3); border-left: 4px solid var(--lamp); padding: 0.8rem 1rem; border-radius: 8px; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; }
  .progress { margin: 0 0 1rem; }
  .count { font-size: var(--step-3); font-weight: 600; margin: 0; color: var(--lamp); letter-spacing: 0.04em; }
  .need { margin: 0.15rem 0 0; color: var(--text); font-weight: 500; }
  .done { margin-top: 0.5rem; border: 2px solid var(--ok); border-radius: 10px; padding: 0.7rem 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; color: var(--ok); }
  .done p { margin: 0; }
  .btn.big { min-height: 56px; padding-inline: 1.75rem; font-size: var(--step-1); }
  /* A record-store divider: a tall cream tab over a wooden bin of three sleeves. */
  .dividers { display: grid; gap: 1.5rem; margin: 0 0 1.5rem; }
  @media (min-width: 52rem) { .dividers { grid-template-columns: 1fr 1fr; } }
  .slot { position: relative; padding-top: 1.9rem; }
  .tab {
    position: absolute; top: 0; left: 0.75rem; z-index: 2; display: flex; align-items: baseline; gap: 0.6rem; max-width: calc(100% - 1.5rem);
    background: var(--sleeve); color: var(--ink); border-radius: 8px 8px 0 0; padding: 0.35rem 0.9rem 0.3rem;
  }
  .tab h2 { margin: 0; font: 400 var(--step-1)/1.1 var(--sign); letter-spacing: 0.03em; text-transform: uppercase; }
  .tab-hint { font-size: 0.8125rem; color: var(--ink-2); min-width: 0; }
  .tab-n { font-size: 0.8125rem; font-weight: 600; margin-left: auto; padding-left: 0.4rem; }
  .bin {
    list-style: none; margin: 0; padding: 0.7rem; display: grid; gap: 0.5rem; border-radius: 6px 12px 12px 12px;
    background: linear-gradient(#3a2a1e, #2a1f17); box-shadow: inset 0 0 0 2px var(--wood);
  }
  .bin.plain { background: var(--wall-2); box-shadow: inset 0 0 0 2px var(--rule); }
  .sleeve { background: var(--sleeve); color: var(--ink); border-radius: 6px; padding: 0.5rem; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 0.4rem 0.7rem; align-items: center; }
  .sleeve .cover { width: 3.5rem; height: 3.5rem; border-radius: 3px; object-fit: cover; background: var(--sleeve-2); display: block; }
  .sleeve .nocover { background: repeating-linear-gradient(135deg, var(--sleeve-2) 0 6px, #d6caae 6px 12px); }
  .meta { min-width: 0; }
  .meta strong, .meta span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sleeve .meta span { color: var(--ink-2); font-size: var(--step--1); }
  .sleeve .acts { grid-column: 1 / -1; display: flex; gap: 0.4rem; align-items: center; flex-wrap: nowrap; }
  .sleeve .acts button, .sleeve .acts select { min-height: 44px; padding: 0.3rem 0.8rem; font-size: var(--step--1); margin: 0; }
  .sleeve .acts button { flex: 0 0 auto; background: var(--ink); color: var(--sleeve); }
  .sleeve .acts button.play { background: var(--lamp); color: var(--ink); min-width: 5.2rem; }
  .sleeve .acts select { flex: 1 1 0; min-width: 0; width: auto; background-color: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink-2); background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); }
  .sleeve button:disabled { background: var(--sleeve-2); color: var(--ink-2); }
  .sleeve :focus-visible { outline-color: var(--ink); }
  .empty { border: 2px dashed var(--wood); border-radius: 6px; min-height: 5.5rem; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: var(--step--1); text-align: center; padding: 0.5rem; }
  .results { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .results .sleeve { grid-template-columns: 3.5rem minmax(0, 1fr) auto; }
  .results .acts { grid-column: 1 / -1; }
  .results .acts .adds { display: flex; gap: 0.4rem; flex: 1; }
  .results .adds button { flex: 1 1 0; padding-inline: 0.2rem; min-width: 0; background: var(--lamp); color: var(--ink); }
  .results .adds button:disabled { background: var(--sleeve-2); color: var(--ink-2); }
  .results .adds button[aria-pressed="true"] { background: var(--ink); color: var(--sleeve); }
  .sleeve.have { opacity: 0.85; }
  .sleeve .tag { font: 600 0.75rem/1 var(--cat); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); }

  /* ---- /taste: search first, starter, sort-old (stage 2a) ---- */
  .sticky-progress { position: sticky; top: 0; z-index: 20; margin: 0 calc(var(--gutter) * -1) 1rem; padding: 0.55rem var(--gutter); background: var(--wall); border-bottom: 1px solid var(--rule); }
  .sticky-progress .line { margin: 0; }
  .sticky-progress .count { font-size: var(--step-2); }
  .sticky-progress .need { font-size: var(--step--1); }
  .sticky-progress .done { margin-top: 0.4rem; padding: 0.4rem 0.8rem; }
  .welcome { color: var(--text); font-size: var(--step-1); }
  .empty-li { list-style: none; }
  .empty-btn { width: 100%; min-height: 5.5rem; background: transparent; color: var(--text); border: 2px dashed var(--wood); border-radius: 6px; box-shadow: none; font-size: var(--step--1); white-space: normal; }
  .empty-btn:hover:not(:disabled) { background: rgba(244, 184, 96, 0.1); color: var(--text); filter: none; }
  .empty-btn[aria-pressed="true"] { border-color: var(--lamp); border-style: solid; color: var(--lamp); }
  .adding { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; margin: 0 0 0.6rem; padding: 0.3rem 0.4rem 0.3rem 0.9rem; background: var(--lamp); color: var(--ink); border-radius: 999px; width: fit-content; }
  .adding[hidden] { display: none; }
  .adding button { margin: 0; }
  .sleeve.suggested { box-shadow: inset 0 0 0 2px var(--lamp); }
  .sleeve.suggested .acts { flex-wrap: wrap; }
  .sleeve.suggested .acts .tag { flex: 1 0 100%; }
  .sleeve .acts button.swap { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink-2); }
  .sleeve .acts button.sortit { background: var(--lamp); color: var(--ink); flex: 1 1 auto; }
  .starter form, .sortold form { margin: 0; }
  .slot-note { margin: 0.3rem 0 0; min-height: 0; }
  .slot-note:empty { display: none; }
  .sticky-progress:focus-visible { outline-offset: -3px; }
  #keep-all { margin: 0.35rem 0 0; min-height: 44px; }
  .sortold .bin { margin-top: 0.8rem; }
  .sleeve .chips { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.35rem; }
  .sleeve .chips .chip { min-height: 44px; padding: 0.2rem; margin: 0; background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink-2); }
  .sleeve .chips .chip[aria-pressed="true"] { background: var(--ink); color: var(--sleeve); }
  .sleeve .chips .chip:disabled { opacity: 0.5; }
</style>
<script define:vars={{ initial, max: TASTE_MAX, per: PER_SLOT, slots, lockedAtLoad: locked, back, activeTable }}>
  const $ = (id) => document.getElementById(id);
  const msg = $("msg");
  const player = $("player");
  let taste = initial;
  let found = [];
  let locked = lockedAtLoad;
  let playing = null;
  // Mood the person is adding to ("up"...), or null: results then show all four.
  let adding = null;
  // Starter suggestions per mood (shown in the dividers) and the spares Swap draws on.
  let sugg = { up: [], down: [], out: [], in: [] };
  let spare = { up: [], down: [], out: [], in: [] };
  let plan = new Map(); // old song id -> chosen mood (starts as the suggestion)
  let planLoaded = false;
  const names = Object.fromEntries(slots.map((s) => [s.slot, s.name]));
  const say = (t) => { msg.textContent = t; };
  const statusEl = $("status");
  async function api(url, init) {
    const res = await fetch(url, init);
    const data = await res.json().catch(() => null);
    return { res, data };
  }
  const el = (tag, props = {}, ...kids) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
  const inSlot = (s) => taste.filter((t) => t.slot === s);
  const sortedN = () => taste.filter((t) => names[t.slot]).length;
  const room = (s) => per - inSlot(s).length;
  // Deezer is busy now and then (503): wait and ask again, twice.
  async function apiRetry(url, init) {
    for (let i = 0; ; i++) {
      const r = await api(url, init);
      if (r.res.status !== 503 || i >= 2) return r;
      await new Promise((ok) => setTimeout(ok, 1500));
    }
  }

  function cover(t) {
    if (t.cover) return el("img", { className: "cover", src: t.cover, alt: "", width: 56, height: 56, loading: "lazy" });
    return el("div", { className: "cover nocover" });
  }
  function playBtn(t) {
    const on = playing === t.id;
    const b = el("button", { type: "button", className: "play", textContent: on ? "Pause" : "Play" });
    b.setAttribute("aria-label", `${on ? "Pause" : "Play"} preview of ${t.title} by ${t.artist}`);
    b.addEventListener("click", () => toggle(t.id));
    return b;
  }
  function meta(t) {
    return el("div", { className: "meta" }, el("strong", { textContent: t.title }), el("span", { textContent: t.artist }));
  }
  function mover(t) {
    const sel = el("select", { disabled: locked });
    sel.dataset.fk = `move:${t.id}`;
    sel.setAttribute("aria-label", `Move ${t.title} to another slot`);
    sel.append(el("option", { value: "", textContent: "Move to...", disabled: true, selected: true }));
    for (const s of slots) {
      if (s.slot === t.slot) continue;
      const o = el("option", { value: s.slot, textContent: s.name });
      if (inSlot(s.slot).length >= per) { o.disabled = true; o.textContent = `${s.name} (full)`; }
      sel.append(o);
    }
    sel.addEventListener("change", () => move(t.id, sel.value));
    return sel;
  }
  function sleeve(t) {
    const rm = el("button", { type: "button", textContent: "Remove", disabled: locked });
    rm.setAttribute("aria-label", `Remove ${t.title} by ${t.artist}`);
    rm.addEventListener("click", () => remove(t.id));
    return el("li", { className: "sleeve" }, cover(t), meta(t), el("div", { className: "acts" }, playBtn(t), mover(t), rm));
  }
  // A suggested song: not in the crate until Keep.
  function suggestedSleeve(t, slot) {
    const keep = el("button", { type: "button", textContent: "Keep", disabled: locked });
    keep.setAttribute("aria-label", `Keep ${t.title} by ${t.artist} in ${names[slot]}`);
    keep.dataset.fk = `keep:${slot}:${t.id}`;
    keep.addEventListener("click", () => keepOne(t, slot));
    const swap = el("button", { type: "button", className: "swap", textContent: "Swap", disabled: locked });
    swap.setAttribute("aria-label", `Swap ${t.title} for another ${names[slot]} suggestion`);
    swap.dataset.fk = `swap:${slot}:${t.id}`;
    swap.addEventListener("click", () => swapOne(t, slot));
    return el("li", { className: "sleeve suggested" }, cover(t), meta(t),
      el("div", { className: "acts" }, el("span", { className: "tag", textContent: "Suggested" }), playBtn(t), keep, swap));
  }
  function emptySlot(s) {
    if (locked) return el("li", { className: "empty", textContent: "Empty" });
    const b = el("button", { type: "button", className: "empty-btn", textContent: `Add a song to ${s.name}` });
    b.dataset.fk = `empty:${s.slot}`;
    if (adding === s.slot) b.setAttribute("aria-pressed", "true");
    b.addEventListener("click", () => startAdding(s.slot));
    return el("li", { className: "empty-li" }, b);
  }

  function render() {
    const sorted = taste.filter((t) => names[t.slot]);
    const loose = taste.filter((t) => !names[t.slot]);
    for (const s of slots) {
      const here = inSlot(s.slot);
      const sec = $(`slot-${s.slot}`);
      sec.querySelector("[data-n]").textContent = `${here.length}/${per}`;
      const bin = sec.querySelector("[data-bin]");
      const items = here.map(sleeve);
      const ideas = locked ? [] : sugg[s.slot].filter((t) => !taste.some((x) => x.id === t.id)).slice(0, per - here.length);
      for (const t of ideas) items.push(suggestedSleeve(t, s.slot));
      for (let i = here.length + ideas.length; i < per; i++) items.push(emptySlot(s));
      bin.replaceChildren(...items);
    }

    // Old songs: one chip per mood, the suggested one pressed; one tap to sort.
    $("unsorted").hidden = loose.length === 0 || locked;
    $("unsorted-n").textContent = String(loose.length);
    $("unsorted-bin").replaceChildren(...loose.map((t) => {
      const choice = plan.get(t.id) ?? null;
      const chips = slots.map((s) => {
        const b = el("button", { type: "button", className: "chip", textContent: s.name, disabled: locked || room(s.slot) <= 0 });
        b.setAttribute("aria-pressed", String(choice === s.slot));
        b.setAttribute("aria-label", `${s.name}${choice === s.slot ? ", suggested" : ""}${room(s.slot) <= 0 ? " (full)" : ""}`);
        b.addEventListener("click", () => { plan.set(t.id, s.slot); render(); document.querySelector(`[data-fk="chip:${t.id}:${s.slot}"]`)?.focus(); });
        b.dataset.fk = `chip:${t.id}:${s.slot}`;
        return b;
      });
      const ok = choice && room(choice) > 0;
      const go = el("button", { type: "button", className: "sortit", textContent: ok ? `Sort into ${names[choice]}` : "No room", disabled: locked || !ok });
      go.setAttribute("aria-label", ok ? `Sort ${t.title} into ${names[choice]}` : `No room for ${t.title}`);
      go.addEventListener("click", () => move(t.id, choice));
      const rm = el("button", { type: "button", textContent: "Remove", disabled: locked });
      rm.setAttribute("aria-label", `Remove ${t.title} by ${t.artist}`);
      rm.addEventListener("click", () => remove(t.id));
      const group = el("div", { className: "chips", role: "group" }, ...chips);
      group.setAttribute("aria-label", `Mood for ${t.title}`);
      return el("li", { className: "sleeve" }, cover(t), meta(t), group, el("div", { className: "acts" }, playBtn(t), go, rm));
    }));

    const n = sorted.length;
    $("count").textContent = `${n} / ${max}`;
    const short = slots.filter((s) => room(s.slot) > 0).map((s) => `${s.name} needs ${room(s.slot)}`);
    const done = short.length === 0;
    $("need").textContent = done ? "" : ` · ${short.join(", ")}`;
    $("count").setAttribute("aria-label", `${n} of ${max} songs${done ? ", complete" : ""}`);
    $("need").hidden = done;
    $("done").hidden = !done;
    $("locked").hidden = !locked;
    if (locked && !back && activeTable) { $("locked-link").href = `/t/${activeTable}`; $("locked-link").textContent = "Back to the table"; }
    $("q").disabled = locked;
    $("search").querySelector("button").disabled = locked;
    $("starter").hidden = locked || n >= max;
    // First visit (empty crate): "Start from artists you love" comes before "Find a song"; after that, search leads.
    const find = document.querySelector('[aria-labelledby="find-h"]');
    if (taste.length === 0 && !locked) { if (find.previousElementSibling !== $("starter")) find.before($("starter")); }
    else if ($("starter").previousElementSibling !== find) find.after($("starter"));
    $("keep-all").hidden = locked || !slots.some((s) => sugg[s.slot].some((t) => !taste.some((x) => x.id === t.id)) && room(s.slot) > 0);
    if (adding && (locked || room(adding) <= 0)) adding = null;
    $("adding").hidden = !adding;
    if (adding) $("adding-name").textContent = names[adding];
    $("q").setAttribute("aria-describedby", adding ? "adding" : "status");

    $("results").replaceChildren(...found.map((t) => {
      const have = taste.find((x) => x.id === t.id && names[x.slot]);
      const adds = (adding ? slots.filter((s) => s.slot === adding) : slots).map((s) => {
        const mineHere = have && have.slot === s.slot;
        const full = room(s.slot) <= 0;
        const label = adding ? `Add to ${s.name}` : s.name;
        const b = el("button", { type: "button", textContent: label, disabled: locked || !!have || full });
        if (mineHere) b.setAttribute("aria-pressed", "true");
        b.setAttribute("aria-label", have ? `${t.title} is in ${names[have.slot]}` : `Add ${t.title} to ${s.name}${full ? " (full)" : ""}`);
        b.addEventListener("click", () => add(t.id, s.slot));
        return b;
      });
      return el("li", { className: "sleeve" + (have ? " have" : "") }, cover(t), meta(t),
        el("div", { className: "acts" }, playBtn(t), el("div", { className: "adds" }, ...adds)));
    }));
  }

  // Any edit can come back 409 because a game began: then say so and lock the page.
  // The message goes next to the control that caused it (a mood's note, else the search status), and #msg at the top too.
  const slotNote = (slot, t) => { const n = document.querySelector(`#slot-${slot} [data-note]`); if (n) n.textContent = t; };
  function failed(res, data, fallback, slot) {
    if (res.status === 409 && /locked/i.test(data?.error ?? "")) { locked = true; render(); }
    const text = data?.error ?? fallback;
    if (slot) slotNote(slot, text); else say(text);
    if (slot) say(text);
  }

  // Tapping an empty box: search takes focus, "adding to" is set (and cancellable),
  // and an empty search shows that mood's suggestions, if there are any.
  function startAdding(slot) {
    adding = slot;
    say("");
    if (!$("q").value.trim()) {
      const ideas = [...sugg[slot], ...spare[slot]].filter((t) => !taste.some((x) => x.id === t.id));
      found = ideas;
      statusEl.textContent = ideas.length
        ? `Adding to ${names[slot]}. Suggestions from your artists: tap Add to ${names[slot]}, or search for something else.`
        : `Adding to ${names[slot]}. Search for a song, or start from artists you love below.`;
    } else {
      statusEl.textContent = `Adding to ${names[slot]}. Search results now have one Add to ${names[slot]} button.`;
    }
    render();
    const q = $("q");
    q.focus();
    q.scrollIntoView({ block: "center", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  }
  $("adding-cancel").addEventListener("click", () => {
    const was = adding;
    adding = null;
    statusEl.textContent = "Adding to a mood cancelled.";
    render();
    document.querySelector(`[data-fk="empty:${was}"]`)?.focus() ?? $("q").focus();
  });

  async function add(id, slot) {
    say("");
    const { res, data } = await apiRetry("/api/taste", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ trackId: id, slot }) });
    slotNote(slot, "");
    if (!res.ok) return failed(res, data, "Could not add that song.", slot);
    taste = data;
    announce(slot);
    render();
  }
  function announce(slot) {
    const full = room(slot) <= 0;
    statusEl.textContent = `Added to ${names[slot]}, ${sortedN()} of ${max}.` + (full ? ` ${names[slot]} is full.` : "");
  }
  // Where focus goes once a suggested sleeve is kept: the next suggested Keep in that mood,
  // else the mood's first empty box, else the next empty box anywhere, else the progress bar.
  function focusAfterKeep(slot, at) {
    const keeps = [...document.querySelectorAll(`#slot-${slot} [data-fk^="keep:"]`)];
    const next = keeps[Math.min(at, keeps.length - 1)]
      ?? document.querySelector(`[data-fk="empty:${slot}"]`)
      ?? document.querySelector('[data-fk^="empty:"]')
      ?? $("progress");
    next.focus();
  }
  async function keepOne(t, slot) {
    say("");
    slotNote(slot, "");
    const { res, data } = await apiRetry("/api/taste", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ trackId: t.id, slot }) });
    if (!res.ok) { failed(res, data, "Could not add that song.", slot); render(); return document.querySelector(`[data-fk="keep:${slot}:${t.id}"]`)?.focus(); }
    taste = data;
    const at = Math.max(0, [...document.querySelectorAll(`#slot-${slot} [data-fk^="keep:"]`)].findIndex((b) => b.dataset.fk === `keep:${slot}:${t.id}`));
    sugg[slot] = sugg[slot].filter((x) => x.id !== t.id);
    announce(slot);
    render();
    focusAfterKeep(slot, at);
  }
  async function keepAll() {
    say("");
    let kept = 0;
    for (const s of slots) {
      for (const t of [...sugg[s.slot]]) {
        if (taste.some((x) => x.id === t.id) || room(s.slot) <= 0) continue;
        const { res, data } = await apiRetry("/api/taste", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ trackId: t.id, slot: s.slot }) });
        if (!res.ok) { failed(res, data, "Could not add that song.", s.slot); render(); return; }
        taste = data;
        kept++;
        sugg[s.slot] = sugg[s.slot].filter((x) => x.id !== t.id);
      }
    }
    $("starter-status").textContent = `Kept ${kept} songs. ${sortedN()} of ${max}.`;
    render();
    $("progress").focus();
  }
  $("keep-all").addEventListener("click", keepAll);

  // Songs already shown in a mood this visit (kept, swapped out or in): Swap never brings one back
  // until the spares run out.
  const shown = { up: new Set(), down: new Set(), out: new Set(), in: new Set() };
  function swapOne(t, slot) {
    shown[slot].add(t.id);
    const next = spare[slot].find((x) => !shown[slot].has(x.id) && !taste.some((y) => y.id === x.id) && !Object.values(sugg).flat().some((y) => y.id === x.id));
    if (!next) {
      slotNote(slot, `No more suggestions for ${names[slot]}. Tap an empty box to search for one.`);
      statusEl.textContent = `No more suggestions for ${names[slot]}.`;
      document.querySelector(`[data-fk="swap:${slot}:${t.id}"]`)?.focus();
      return;
    }
    slotNote(slot, "");
    shown[slot].add(next.id);
    spare[slot] = spare[slot].filter((x) => x.id !== next.id);
    sugg[slot] = sugg[slot].map((x) => (x.id === t.id ? next : x));
    statusEl.textContent = `Swapped for ${next.title} by ${next.artist}.`;
    render();
    // The new sleeve sits in the same place: focus its Swap.
    document.querySelector(`[data-fk="swap:${slot}:${next.id}"]`)?.focus();
  }

  $("starter-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const artists = $("artists").value.split(",").map((x) => x.trim()).filter(Boolean).slice(0, 3);
    const st = $("starter-status");
    if (!artists.length) return;
    st.textContent = "Looking through their records...";
    $("starter-go").disabled = true;
    // No automatic retry: Deezer is shared by every table, and asking again at once only makes it busier.
    const { res, data } = await api("/api/taste/suggest", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ artists }) });
    $("starter-go").disabled = false;
    if (!res.ok) {
      st.textContent = res.status === 429 ? "One moment, then try again."
        : res.status === 503 ? "Deezer is busy, try again in a moment."
        : (data?.error ?? "Could not get suggestions.");
      say("");
      return;
    }
    sugg = data.moods;
    spare = data.spare;
    for (const k of Object.keys(shown)) { shown[k] = new Set(sugg[k].map((x) => x.id)); }
    const total = Object.values(sugg).flat().length;
    const miss = data.missing?.length ? ` Not found: ${data.missing.join(", ")}.` : "";
    const few = data.fewClean ?? [];
    st.textContent = !total
      ? (few.length ? `We couldn't find clean songs for ${few.join(" or ")}. Try another artist or search below.` : "Nothing to suggest from those.") + miss
      : `${total} suggestions, in the moods below. Keep what you like, Swap the rest.` +
        (few.length ? ` ${few.join(" and ")} ${few.length === 1 ? "has" : "have"} few clean songs, so some come from artists like ${few.length === 1 ? "them" : "those"}.` : "") + miss;
    render();
    if (total) $("slot-up").scrollIntoView({ block: "start", behavior: "auto" });
  });

  async function move(id, slot) {
    say("");
    const { res, data } = await api(`/api/taste/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ slot }) });
    if (!res.ok) { failed(res, data, "Could not move that song."); render(); return document.querySelector(`[data-fk="move:${id}"]`)?.focus(); }
    taste = data;
    plan.delete(id);
    render();
    // The sleeve has moved bins: keep focus on its select, now in the new slot.
    document.querySelector(`[data-fk="move:${id}"]`)?.focus() ?? $("sort-all").focus();
  }
  async function sortAll() {
    say("");
    let moved = 0;
    for (const t of taste.filter((x) => !names[x.slot])) {
      const to = plan.get(t.id);
      if (!to || room(to) <= 0) continue;
      const { res, data } = await api(`/api/taste/${t.id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ slot: to }) });
      if (!res.ok) { failed(res, data, "Could not move that song."); break; }
      taste = data;
      plan.delete(t.id);
      moved++;
    }
    const left = taste.filter((x) => !names[x.slot]).length;
    $("sort-note").textContent = `Sorted ${moved}.` + (left ? ` ${left} stay unsorted because their moods are full: pick another mood for them, or remove them.` : "");
    render();
    $("sort-all").focus();
  }
  $("sort-all").addEventListener("click", sortAll);
  async function remove(id) {
    say("");
    const { res, data } = await api(`/api/taste/${id}`, { method: "DELETE" });
    if (!res.ok) return failed(res, data, "Could not remove that song.");
    if (playing === id) stop();
    taste = taste.filter((t) => t.id !== id);
    render();
  }

  function stop() { player.pause(); playing = null; }
  // The preview URL is signed and expires, so ask for a fresh one every play.
  async function toggle(id) {
    say("");
    if (playing === id) { stop(); return render(); }
    stop();
    const { res, data } = await api(`/api/tracks/${id}/preview`);
    if (!res.ok) { say(data?.error ?? "No preview for that one."); return render(); }
    player.src = data.url;
    playing = id;
    render();
    player.play().catch(() => { say("Your browser would not play that."); playing = null; render(); });
  }
  player.addEventListener("ended", () => { playing = null; render(); });

  $("search").addEventListener("submit", async (e) => {
    e.preventDefault();
    say("");
    statusEl.textContent = "Searching...";
    const { res, data } = await apiRetry(`/api/search?q=${encodeURIComponent($("q").value.trim())}`);
    if (!res.ok) { statusEl.textContent = data?.error ?? "Search failed."; return say(""); }
    found = data;
    const how = adding ? `Tap Add to ${names[adding]} on a song.` : "Pick a mood on a song to add it.";
    statusEl.textContent = found.length ? `${found.length} results. ${how}` : "No results.";
    render();
  });

  // Old songs: fetch the suggested mood for each, once.
  async function loadPlan() {
    if (planLoaded || !taste.some((t) => !names[t.slot])) return;
    planLoaded = true;
    const { res, data } = await api("/api/taste/sort-plan");
    if (res.ok && Array.isArray(data)) for (const r of data) if (r.slot && !plan.has(r.id)) plan.set(r.id, r.slot);
    render();
  }

  // ?welcome=1 starts on the search with nothing else in the way.
  render();
  loadPlan();
</script>
