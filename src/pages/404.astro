---
import Base from "../layouts/Base.astro";

// The page for any address that isn't one. It never echoes the requested path,
// so every miss looks the same (including /api/logs without its token).
Astro.response.status = 404;
---
<Base title="Not found">
  <p class="kicker">Side B, track 404</p>
  <h1>Not found</h1>
  <p>There's nothing at this address. The record you wanted isn't in the crate.</p>
  <p><a class="btn" href="/">Back to the shop front</a></p>
</Base>
